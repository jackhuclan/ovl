<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icon="clr-namespace:InteVega.CBB.Prism.UI.Extensions.Icon;assembly=InteVega.CBB.Prism.UI.Extensions">
    <Style
        x:Key="PosButton"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="{x:Type ButtonBase}">
        <Setter Property="Margin" Value="1" />
    </Style>
    <Style x:Key="MarvelLightButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#E6E7EA" />
        <Setter Property="Foreground" Value="#0F54C6" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="MinWidth" Value="66" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <ContentPresenter
                            Margin="5,0,5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Mouse Over Trigger  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F2F2" />
                        </Trigger>
                        <!--  Pressed Trigger  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#CCCCCC" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#999999" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MarvelDarkButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Background" Value="#0F54C6" />
        <Setter Property="BorderBrush" Value="#D7D7D7" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Mouse Over Trigger  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#98B9F2" />
                        </Trigger>
                        <!--  Pressed Trigger  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#98B9F2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RunButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Name="border"
                        Width="138"
                        Height="52"
                        Background="#0F54C6"
                        BorderBrush="#E6E7EA"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid>
                            <WrapPanel Margin="20,0,0,0">
                                <icon:CustomIcon
                                    Name="icon"
                                    Width="26"
                                    Height="26"
                                    Margin="0,10,18,10"
                                    Padding="0"
                                    Foreground="#fff"
                                    Kind="ButtonRunIcon"
                                    Style="{StaticResource MainMenuIcon}" />
                                <TextBlock
                                    Name="txtContent"
                                    Margin="0,13,0,13"
                                    HorizontalAlignment="Left"
                                    FontSize="16"
                                    Foreground="#fff"
                                    Text="{TemplateBinding Content}" />
                            </WrapPanel>
                            <Border Name="borderEnable" Background="Transparent" />
                        </Grid>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#126CFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#03307A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="borderEnable" Property="Background" Value="#65cccccc" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
