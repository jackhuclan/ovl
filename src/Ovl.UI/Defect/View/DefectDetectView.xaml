<UserControl
    x:Class="Ovl.UI.Defect.View.DefectDetectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:comControl="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:converts="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:InteVega.CBB.Prism.UI.Extensions;assembly=InteVega.CBB.Prism.UI.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:hp="clr-namespace:HPImageViewer;assembly=HPImageViewer"
    xmlns:local="clr-namespace:Ovl.UI.Job.View"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:main="clr-namespace:Ovl.UI.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:recipe="clr-namespace:InteVega.CBB.Recipe.Ui.View;assembly=InteVega.CBB.Recipe.Ui"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    MinHeight="600"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converts:ObjectToBool x:Key="ObjectToBool" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <extensions:RoutedEventTrigger RoutedEvent="hp:ImageView.ImageDoubleClicked">
            <b:InvokeCommandAction Command="{Binding HandleImageDoubleClickedCommand}" PassEventArgsToCommand="True" />
        </extensions:RoutedEventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!--  配方管理器  -->
        <recipe:RecipeMenu
            Grid.Row="0"
            Grid.Column="0"
            Margin="5,5,0,5"
            VerticalAlignment="Stretch"
            BorderThickness="0"
            DataContext="{Binding RecipeMenuViewModel}" />

        <!--  未选中配方时的提示界面  -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="5"
            Padding="5"
            BorderBrush="#E6E7EA"
            BorderThickness="1">
            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="76"
                Foreground="#a1a1a1"
                Text="Please select a recipe"
                Visibility="{Binding IsShowFirst}" />
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="5"
            Padding="0"
            BorderBrush="#E6E7EA"
            BorderThickness="1"
            Visibility="{Binding IsShowContent}">
            <Grid IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <!--  头部信息，显示配方名称和操作按钮  -->
                <Border BorderBrush="#E6E7EA" BorderThickness="0,0,0,1">
                    <Grid Background="#D5E0E6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Grid.ColumnSpan="1"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock Text="Selected Recipe：" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{Binding SelectedRecipe.Name}" ToolTip="{Binding SelectedRecipe.Name}"/>

                           
                        </StackPanel>
                        <TextBlock Grid.Column="1"
VerticalAlignment="Center"
FontSize="12" Margin="10,0,0,0"
FontWeight="Bold"
Text="{Binding WaferName}"
ToolTip="{Binding WaferName}"  TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="10,3"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Bottom"
                            Orientation="Horizontal">

                            <Button
                                Margin="0,0,0,0"
                                Command="{Binding OpenImageCommand}"
                                Content="Open History Data" />

                            <Button
                                Margin="10,0,0,0"
                                Command="{Binding AlignCommand}"
                                Content="Align" />
                        </StackPanel>
                    </Grid>
                </Border>


                <Grid
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
                        <stagetcontorl:StageControlCameraListView Margin="2,0,10,0" />
                        <StackPanel   Orientation="Horizontal"   >
                            
                            <StackPanel Orientation="Horizontal" >
                                <Button
     Margin="0,0,10,0"
     Command="{Binding CoarseFocusCommand}"
     Content="Coarse Focus" />
                                <Button
     Command="{Binding FineFocusCommand}"
     Content="Fine Focus"
     Visibility="{Binding FineFocusVisible}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,0" Visibility="{Binding Focus40Visible}">
                                <Button
Margin="0,0,10,0"
Command="{Binding SharpnessCommand}"
Content="Sharpest" />
                                <Button
Command="{Binding ZeroCommand}"
Content="Zero" />
                            </StackPanel>
                        </StackPanel>
                       
                    </StackPanel>

                    <!--  图像控件  -->
                    <Grid
                        x:Name="imgGrid"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Margin="0,0"
                        IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                        <stagetcontorl:StageControlImageView
                            x:Name="StageControlImageView"
                            Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch" />
                        <localControl:WaferMapStageControl
                            x:Name="wmsc"
                            MaxWidth="200"
                            MaxHeight="240"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            IsEnableMove="True"
                            Opacity="0.8" />
                        <TextBlock
                            Margin="0,60,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding ChangeCameraInfo}" />
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                       
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Bottom"
                            Orientation="Horizontal">

                            <Button
                                Margin="0,0,10,0"
                                Command="{Binding ScanCommand}"
                                Content="Scan" />

                            <Button
                                Margin="0,0,10,0"
                                Command="{Binding SaveDataCommand}"
                                Content="Save"
                                Style="{StaticResource MarvelDarkButton}" />

                            <Button
                                Margin="0,0,0,0"
                                Command="{Binding SaveAsCommand}"
                                Content="Save As" />

                        </StackPanel>
                    </Grid>

                    <!--  缺陷列表  -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource TitleBorderColorBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Label Background="{StaticResource LabelTitleBackGroundBrush}" Style="{x:Null}">Defect List</Label>
                                <WrapPanel
                                    Grid.Row="1"
                                    Margin="3"
                                    IsEnabled="{Binding DefectResult, Converter={StaticResource OtbCVT}}">
                                    <Button
                                        Command="{Binding AddDefectCommand}"
                                        Content="Add"
                                        Style="{StaticResource MarvelLightButton}" />
                                    <Button
                                        Command="{Binding DeleteDefectCommand}"
                                        Content="Delete"
                                        Style="{StaticResource MarvelLightButton}" />

                                    <Button
                                        Command="{Binding ClearDefectCommand}"
                                        Content="Empty"
                                        Style="{StaticResource MarvelLightButton}" />

                                </WrapPanel>
                            </Grid>

                        </Border>

                        <DataGrid
                            x:Name="targetinfos"
                            Grid.Row="2"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0,0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeRows="True"
                            CanUserSortColumns="False"
                            CellStyle="{DynamicResource TargetDataGridCellStyle}"
                            ItemsSource="{Binding DefectResult.DefectInfos}"
                            LoadingRow="targetinfos_LoadingRow"
                            MouseRightButtonDown="targetinfos_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonDown="targetinfos_PreviewMouseLeftButtonDown"
                            PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                            RowHeight="40"
                            RowStyle="{DynamicResource TargetListDataGridRowStyle}"
                            SelectedItem="{Binding SelectedDefect}"
                            SelectionMode="Single"
                            Style="{DynamicResource DataGrid.Small}"
                            VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridTemplateColumn
                                    Width="Auto"
                                    Header="Index"
                                    IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Background="Transparent" Orientation="Horizontal">
                                                <comControl:CtlAutoNo
                                                    MinWidth="20"
                                                    Margin="5,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    AncestorType="{x:Type DataGrid}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="X(mm)">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:NumericUpDown
                                                Width="auto"
                                                Height="24"
                                                Margin="0,0,0,0"
                                                DecimalPlaces="5"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                ToolTip="{Binding Location.X}"
                                                Value="{Binding Location.X, UpdateSourceTrigger=PropertyChanged}" />

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Y(mm)">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:NumericUpDown
                                                Width="auto"
                                                Height="24"
                                                Margin="0,0,0,0"
                                                DecimalPlaces="5"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                ToolTip="{Binding Location.Y}"
                                                Value="{Binding Location.Y, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Get" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Background="Transparent">
                                                <Button
                                                    Width="50"
                                                    Margin="5,2"
                                                    Padding="4"
                                                    Click="btnGetR3_Click"
                                                    Command="{Binding GetR3Command}"
                                                    Content="Get" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="To" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Background="Transparent">
                                                <Button
                                                    Width="50"
                                                    Margin="5,2"
                                                    Padding="4"
                                                    Click="btnGoto_Click"
                                                    Command="{Binding GotoCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    Content="To" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                            <!--<DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Command="{Binding DeleteDefectCommand}" Header="Delete">
                    <MenuItem.Icon>
                      <Viewbox Width="16" Height="16">
                        <Image Source="{DynamicResource deletetest}" />
                      </Viewbox>
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </DataGrid.ContextMenu>-->
                        </DataGrid>
                    </Grid>

                    <!--  全局扫描图  -->
                    <Border
                        Grid.Row="2"
                        Grid.Column="1"
                        BorderBrush="{StaticResource TitleBorderColorBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="3">
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border
                                BorderBrush="{StaticResource TitleBorderColorBrush}"
                                BorderThickness="1"
                                CornerRadius="3,3,0,0">
                                <Grid>
                                    <Label
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource LabelTitleBackGroundBrush}"
                                        Style="{x:Null}">
                                        Wafer Panorama
                                    </Label>
                                    <Button
                                        Margin="10,5"
                                        HorizontalAlignment="Right"
                                        Command="{Binding AdaptCommand}"
                                        Content="Adapt" />
                                </Grid>

                            </Border>

                            <Viewbox Grid.Row="1" Stretch="Uniform">

                                <Canvas
                                    Grid.Row="1"
                                    Width="{Binding ImageWidth}"
                                    Height="{Binding ImageHeight}"
                                    PreviewMouseUp="Grid_PreviewMouseUp">
                                    <Canvas.Background>
                                        <ImageBrush ImageSource="{Binding WaferImage}" Stretch="Uniform" />
                                    </Canvas.Background>
                                    <Path
                                        x:Name="pathCross"
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Panel.ZIndex="5"
                                        Data="M0,1 2,1 M1,0 1,2"
                                        Fill="Red"
                                        Stretch="Uniform"
                                        StrokeThickness="3" />
                                </Canvas>
                            </Viewbox>
                            <!--<Image Grid.Row="1"  Source="{Binding WaferImage}" Stretch="Uniform" />-->
                            <hp:ImageViewer
                                x:Name="hpImage"
                                Grid.Row="1"
                                Background="AliceBlue" />
                        </Grid>
                    </Border>
                    <StackPanel
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        hc:Growl.Token="DefectDetectMessage" />
                </Grid>



            </Grid>

        </Border>

    </Grid>
</UserControl>
