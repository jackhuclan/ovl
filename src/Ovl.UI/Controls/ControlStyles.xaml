<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:enum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
    xmlns:local="clr-namespace:Ovl.UI.Controls">
    <local:MarginConveter x:Key="MarginCVT" />
    <local:PathBrushConverter x:Key="BrushCVT" />
    <local:PathBrushConverter x:Key="BrushCVTInverse" IsInverse="True" />
    <local:PathBrushConverter x:Key="OuterBrushCVT" IsOutter="True" />
    <local:PathBrushConverter
        x:Key="OuterBrushCVTInverse"
        IsInverse="True"
        IsOutter="True" />
    <EllipseGeometry
        x:Key="Geo_Ellise"
        RadiusX="10"
        RadiusY="10" />
    <RectangleGeometry x:Key="Geo_Box" Rect="0,0,10,10" />
    <PathGeometry x:Key="Geo_Bar">
        M2,0 8,0 M10,2 10,8 M8,10 2,10 M0,8,0,2
    </PathGeometry>
    <PathGeometry x:Key="Geo_Langle">
        M2,2 2,8 8,8
    </PathGeometry>

    <PathGeometry x:Key="Geo_Cross">
        M0,0 2,0 2,-2 3,-2 3,0 5,0 5,1 3,1  3,3 2,3 2,1 0,1Z
    </PathGeometry>

    <PathGeometry x:Key="Geo_Cross_Out">
        M0,0 1,0 1,1 0,1z  M4,0 5,0 5,1 4,1z M0,4 1,4 1,5 0,5z M4,4 5,4 5,5 4,5z
    </PathGeometry>

    <PathGeometry x:Key="Geo_AIM">
        <!--  左上  -->
        M-0.5,-0.5 -0.5,-1 -4.9,-1 -4.9,-0.5Z
        M-0.5,-1.5 -0.5,-2 -4.9,-2 -4.9,-1.5Z
        M-0.5,-2.5 -0.5,-3 -4.9,-3 -4.9,-2.5Z
        M-0.5,-3.5 -0.5,-4 -4.9,-4 -4.9,-3.5Z
        M-0.5,-4.5 -0.5,-5 -4.9,-5 -4.9,-4.5Z
        M-0.5,-5.5 -0.5,-6 -4.9,-6 -4.9,-5.5Z
        M-0.5,-6.5 -0.5,-7 -4.9,-7 -4.9,-6.5Z
        M-0.5,-7.5 -0.5,-8 -4.9,-8 -4.9,-7.5Z
        M-0.5,-8.5 -0.5,-9 -4.9,-9 -4.9,-8.5Z
        M-0.5,-9.5 -0.5,-10 -4.9,-10 -4.9,-9.5Z
        <!--  左下  -->
        M-0.5,+0.5 -1,+0.5 -1,+4.9 -0.5,+4.9Z
        M-1.5,+0.5 -2,+0.5 -2,+4.9 -1.5,+4.9Z
        M-2.5,+0.5 -3,+0.5 -3,+4.9 -2.5,+4.9Z
        M-3.5,+0.5 -4,+0.5 -4,+4.9 -3.5,+4.9Z
        M-4.5,+0.5 -5,+0.5 -5,+4.9 -4.5,+4.9Z
        M-5.5,+0.5 -6,+0.5 -6,+4.9 -5.5,+4.9Z
        M-6.5,+0.5 -7,+0.5 -7,+4.9 -6.5,+4.9Z
        M-7.5,+0.5 -8,+0.5 -8,+4.9 -7.5,+4.9Z
        M-8.5,+0.5 -9,+0.5 -9,+4.9 -8.5,+4.9Z
        M-9.5,+0.5 -10,+0.5 -10,+4.9 -9.5,+4.9Z
        <!--  右上  -->
        M0.5,-0.5 1,-0.5 1,-4.9 0.5,-4.9Z
        M1.5,-0.5 2,-0.5 2,-4.9 1.5,-4.9Z
        M2.5,-0.5 3,-0.5 3,-4.9 2.5,-4.9Z
        M3.5,-0.5 4,-0.5 4,-4.9 3.5,-4.9Z
        M4.5,-0.5 5,-0.5 5,-4.9 4.5,-4.9Z
        M5.5,-0.5 6,-0.5 6,-4.9 5.5,-4.9Z
        M6.5,-0.5 7,-0.5 7,-4.9 6.5,-4.9Z
        M7.5,-0.5 8,-0.5 8,-4.9 7.5,-4.9Z
        M8.5,-0.5 9,-0.5 9,-4.9 8.5,-4.9Z
        M9.5,-0.5 10,-0.5 10,-4.9 9.5,-4.9Z
        <!--  右下  -->
        M0.5,0.5 0.5,1 4.9,1 4.9,0.5Z
        M0.5,1.5 0.5,2 4.9,2 4.9,1.5Z
        M0.5,2.5 0.5,3 4.9,3 4.9,2.5Z
        M0.5,3.5 0.5,4 4.9,4 4.9,3.5Z
        M0.5,4.5 0.5,5 4.9,5 4.9,4.5Z
        M0.5,5.5 0.5,6 4.9,6 4.9,5.5Z
        M0.5,6.5 0.5,7 4.9,7 4.9,6.5Z
        M0.5,7.5 0.5,8 4.9,8 4.9,7.5Z
        M0.5,8.5 0.5,9 4.9,9 4.9,8.5Z
        M0.5,9.5 0.5,10 4.9,10 4.9,9.5Z
    </PathGeometry>

    <PathGeometry x:Key="Geo_AIM_Out">
        <!--  左上  -->
        M-5.5,-0.5 -5.5,-1 -9.9,-1 -9.9,-0.5Z
        M-5.5,-1.5 -5.5,-2 -9.9,-2 -9.9,-1.5Z
        M-5.5,-2.5 -5.5,-3 -9.9,-3 -9.9,-2.5Z
        M-5.5,-3.5 -5.5,-4 -9.9,-4 -9.9,-3.5Z
        M-5.5,-4.5 -5.5,-5 -9.9,-5 -9.9,-4.5Z
        M-5.5,-5.5 -5.5,-6 -9.9,-6 -9.9,-5.5Z
        M-5.5,-6.5 -5.5,-7 -9.9,-7 -9.9,-6.5Z
        M-5.5,-7.5 -5.5,-8 -9.9,-8 -9.9,-7.5Z
        M-5.5,-8.5 -5.5,-9 -9.9,-9 -9.9,-8.5Z
        M-5.5,-9.5 -5.5,-10 -9.9,-10 -9.9,-9.5Z
        <!--  左下  -->
        M-0.5,+5.5 -1,+5.5 -1,+9.9 -0.5,+9.9Z
        M-1.5,+5.5 -2,+5.5 -2,+9.9 -1.5,+9.9Z
        M-2.5,+5.5 -3,+5.5 -3,+9.9 -2.5,+9.9Z
        M-3.5,+5.5 -4,+5.5 -4,+9.9 -3.5,+9.9Z
        M-4.5,+5.5 -5,+5.5 -5,+9.9 -4.5,+9.9Z
        M-5.5,+5.5 -6,+5.5 -6,+9.9 -5.5,+9.9Z
        M-6.5,+5.5 -7,+5.5 -7,+9.9 -6.5,+9.9Z
        M-7.5,+5.5 -8,+5.5 -8,+9.9 -7.5,+9.9Z
        M-8.5,+5.5 -9,+5.5 -9,+9.9 -8.5,+9.9Z
        M-9.5,+5.5 -10,+5.5 -10,+9.9 -9.5,+9.9Z
        <!--  右上  -->
        M0.5,-5.5 1,-5.5 1,-9.9 0.5,-9.9Z
        M1.5,-5.5 2,-5.5 2,-9.9 1.5,-9.9Z
        M2.5,-5.5 3,-5.5 3,-9.9 2.5,-9.9Z
        M3.5,-5.5 4,-5.5 4,-9.9 3.5,-9.9Z
        M4.5,-5.5 5,-5.5 5,-9.9 4.5,-9.9Z
        M5.5,-5.5 6,-5.5 6,-9.9 5.5,-9.9Z
        M6.5,-5.5 7,-5.5 7,-9.9 6.5,-9.9Z
        M7.5,-5.5 8,-5.5 8,-9.9 7.5,-9.9Z
        M8.5,-5.5 9,-5.5 9,-9.9 8.5,-9.9Z
        M9.5,-5.5 10,-5.5 10,-9.9 9.5,-9.9Z
        <!--  右下  -->
        M5.5,0.5 5.5,1 9.9,1 9.9,0.5Z
        M5.5,1.5 5.5,2 9.9,2 9.9,1.5Z
        M5.5,2.5 5.5,3 9.9,3 9.9,2.5Z
        M5.5,3.5 5.5,4 9.9,4 9.9,3.5Z
        M5.5,4.5 5.5,5 9.9,5 9.9,4.5Z
        M5.5,5.5 5.5,6 9.9,6 9.9,5.5Z
        M5.5,6.5 5.5,7 9.9,7 9.9,6.5Z
        M5.5,7.5 5.5,8 9.9,8 9.9,7.5Z
        M5.5,8.5 5.5,9 9.9,9 9.9,8.5Z
        M5.5,9.5 5.5,10 9.9,10 9.9,9.5Z
    </PathGeometry>

    <PathGeometry x:Key="Geo_BF">
        M5,0 6,0 6,10 5,10Z   M8,0 9,0 9,10 8,10Z   M11,-10 12,-10 12,10 11,10Z   M14,0 15,0 15,10 14,10Z M17,0 18,0 18,10 17,10Z
    </PathGeometry>

    <PathGeometry x:Key="Geo_CD_DS" Figures="M0.5,0.5 L124.5,0.5 124.5,58.500003 63.5,58.500003 63.5,68.500003 124.5,68.500003 124.5,124.5 0.5,124.5 z M63.5,58.500003 L124.5,58.500003 124.5,68.500003 63.5,68.500003 z M302.5,0.5000037 C336.74167,0.50000334 364.5,28.258348 364.5,62.500003 364.5,96.741657 336.74167,124.5 302.5,124.5 270.39844,124.5 243.99512,100.10302 240.8201,68.839138 L240.80298,68.500003 302.5,68.500003 302.5,58.500003 240.70198,58.500003 240.8201,56.160865 C243.99512,24.896986 270.39844,0.50000322 302.5,0.5000037 z M240.70198,58.500003 L302.5,58.500003 302.5,68.500003 240.80298,68.500003 240.5,62.500003 z M124.5,58.500003 L240.70198,58.500003 240.5,62.500003 240.80298,68.500003 124.5,68.500003 z" />
    <PathGeometry x:Key="Geo_BF_Back">
        M-1,-11 21,-11 21,11 -1,11Z
    </PathGeometry>

    <Style TargetType="{x:Type local:ControlTestIcon}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ControlTestIcon}">
                    <Viewbox>
                        <Grid>
                            <Path
                                Fill="{TemplateBinding Background}"
                                Stretch="Uniform"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="1">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Data" Value="{DynamicResource Geo_Box}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.Circle}">
                                                <Setter Property="Data" Value="{StaticResource Geo_Ellise}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.Aperture}">
                                                <Setter Property="Data" Value="{StaticResource Geo_Ellise}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.LS}">
                                                <Setter Property="Data" Value="{StaticResource Geo_BF_Back}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.DS}">
                                                <Setter Property="Data" Value="{StaticResource Geo_CD_DS}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.LAngle}">
                                                <Setter Property="Data" Value="{StaticResource Geo_Langle}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Grid Margin="1">

                                <Path
                                    x:Name="pathOut"
                                    Fill="{Binding OuterType, Converter={StaticResource OuterBrushCVT}, ConverterParameter='#aaaaaa'}"
                                    Opacity="0.6"
                                    Stretch="Uniform"
                                    Stroke="{Binding OuterType, Converter={StaticResource OuterBrushCVTInverse}, ConverterParameter='#999999'}"
                                    StrokeThickness="1">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.Box}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Box}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.Bar}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Bar}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.Frame}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Box}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.Circle}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Ellise}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.Cross}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Cross_Out}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.AIM}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_AIM_Out}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.AIM_XYS}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_AIM_Out}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.LS}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_BF}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.Aperture}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Ellise}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.DS}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_CD_DS}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.LAngle}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Langle}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path
                                    Margin="{Binding InnerType, Converter={StaticResource MarginCVT}}"
                                    Fill="{Binding InnerType, Converter={StaticResource BrushCVT}, ConverterParameter='#555555'}"
                                    Opacity="0.6"
                                    Stretch="Uniform"
                                    Stroke="{Binding InnerType, Converter={StaticResource BrushCVTInverse}, ConverterParameter='#555555'}"
                                    StrokeThickness="1">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.Box}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Box}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.Bar}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Bar}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.Frame}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Box}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.Circle}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Ellise}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.Cross}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Cross}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.AIM}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_AIM}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.AIM_XYS}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_AIM}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.LS}">
                                                    <Setter Property="Data" Value="{x:Null}" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.Aperture}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Ellise}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InnerType}" Value="{x:Static enum:EnumTargetType.LAngle}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_Langle}" />
                                                </DataTrigger>
                                                <!--<DataTrigger Binding="{Binding OuterType}" Value="{x:Static enum:EnumTargetType.DS}">
                                                    <Setter Property="Data" Value="{StaticResource Geo_CD_DS}" />
                                                </DataTrigger>-->
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>

                            </Grid>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>