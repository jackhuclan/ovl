<UserControl
    x:Class="Ovl.UI.Controls.WaferMapStageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Ovl.UI.Controls"
  xmlns:wafermap="clr-namespace:Marvel.WaferMapCommon;assembly=Marvel.WaferMapCommon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="200"
    Background="#353535"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Visibility="{Binding IsChecked, ElementName=tb, Converter={StaticResource OtvCVT}}">
            <wafermap:WaferMapControl
                x:Name="wmc"
                Margin="20"
                EditMode="Move" />

            <Button
                Width="20"
                Height="20"
                Padding="2,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                hc:IconElement.Geometry="{StaticResource UpGeometry}"
                Click="Button_Click_UpField" />
            <Button
                Width="20"
                Height="20"
                Padding="2,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                hc:IconElement.Geometry="{StaticResource DownGeometry}"
                Click="Button_Click_DownField" />
            <Button
                Width="20"
                Height="20"
                Padding="2,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                hc:IconElement.Geometry="{StaticResource LeftGeometry}"
                Click="Button_Click_LeftField" />
            <Button
                Width="20"
                Height="20"
                Padding="2,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                hc:IconElement.Geometry="{StaticResource RightGeometry}"
                Click="Button_Click_RightField" />

            <Button
                Width="20"
                Height="20"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Button_Click_FieldULC"
                Content="ULC"
                FontSize="7" />
            <Button
                Width="20"
                Height="20"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="Button_Click_FieldURC"
                Content="URC"
                FontSize="7" />
            <Button
                Width="20"
                Height="20"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Click="Button_Click_FieldLLC"
                Content="LLC"
                FontSize="7" />
            <Button
                Width="20"
                Height="20"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="Button_Click_FieldLRC"
                Content="LRC"
                FontSize="7" />

            <Ellipse
                Width="10"
                Height="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="Green"
                MouseDown="Ellipse_MouseDown"
                Opacity="0.8" />
        </Grid>
        <CheckBox
            x:Name="cbCoord"
            Grid.Row="1"
            Margin="2"
            HorizontalAlignment="Left"
            Content="Coord correct "
            FontSize="8"
            Foreground="White"
            IsChecked="True"
            Visibility="Collapsed" />
        <ToggleButton
            x:Name="tb"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Black"
            Checked="tb_Checked"
            Content="Wafer Map"
            Foreground="White"
            Opacity="0.6"
            Unchecked="tb_Checked">
            <ToggleButton.Style>
                <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border Background="{TemplateBinding Background}">
                                    <StackPanel
                                        Margin="10,5"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="txtDir"
                                            FontSize="16"
                                            Text="&lt;" />
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Text="Wafer Map" />
                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="txtDir" Property="Text" Value="&gt; " />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ToggleButton.Style>

        </ToggleButton>
    </Grid>
</UserControl>
