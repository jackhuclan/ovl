<UserControl
    x:Class="Ovl.UI.Controls.WaferMapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="450"
    Background="Transparent"
    PreviewMouseWheel="UserControl_PreviewMouseWheel"
    RenderTransformOrigin="0.5,0.5"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            Padding="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <PathGeometry x:Key="Path_FieldChecked">
            M0,0 1,1 3,-1
        </PathGeometry>

        <ContextMenu x:Key="Res_ContextMenu">
            <MenuItem
                Width="150"
                Click="MISetField0_Click"
                Header="Set as Field0" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Viewbox x:Name="vb" RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <ScaleTransform x:Name="scale" CenterX="0.5" CenterY="0.5" />
            </Viewbox.RenderTransform>
            <Grid x:Name="gridLayout">
                <Grid
                    x:Name="gridOuter"
                    Width="200"
                    Height="200"
                    Background="Transparent">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid
                        x:Name="gridInner"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Panel.ZIndex="1">
                        <Canvas
                            x:Name="canvasMisreg"
                            Panel.ZIndex="1"
                            Background="Transparent" />
                        <Ellipse
                            Width="2"
                            Height="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="2"
                            Fill="Red"
                            Opacity="1" />
                    </Grid>
                    <Ellipse
                        x:Name="epNotch"
                        Width="10"
                        Height="10"
                        Margin="-5,-5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Panel.ZIndex="2"
                        Fill="White" />
                    <Rectangle
                        x:Name="rectFlat"
                        Margin="-5,-5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Panel.ZIndex="2"
                        Fill="White" />


                </Grid>
                <Grid
                    x:Name="gridFields"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="3"
                    Background="Transparent"
                    Opacity="0.6">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="tsFields" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                </Grid>

                <Path
                    x:Name="pathCross"
                    Width="10"
                    Height="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="5"
                    Data="M0,1 2,1 M1,0 1,2"
                    Stretch="Uniform"
                    Stroke="Red"
                    StrokeThickness="1"
                    Visibility="Collapsed" />

            </Grid>
        </Viewbox>
    </Grid>

</UserControl>
