<Application x:Class="Ovl.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!--  与原版一致：先合并 HandyControl 皮肤与主题，再合并迁入的主题字典与图标  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Icons/IconTemplateDictionary.xaml" />
                <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Themes/IconStyles.xaml" />
                <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Themes/DataGrid.xaml" />
                <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Themes/DataGridSmall.xaml" />
                <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Themes/Border.xaml" />
                <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Themes/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
