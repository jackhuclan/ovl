<Window
    x:Class="Ovl.UI.Template"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icon="clr-namespace:InteVega.CBB.Prism.UI.Extensions.Icon;assembly=InteVega.CBB.Prism.UI.Extensions"
    xmlns:local="clr-namespace:Ovl.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Template"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="Resources/Themes/DataGrid.xaml" />
                <ResourceDictionary Source="Resources/Themes/Border.xaml" />
                <ResourceDictionary Source="Resources/Themes/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <StackPanel>
            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <Button Content="运行" Style="{DynamicResource RunButtonStyle}" />
                <Button
                    Content="暂停"
                    IsEnabled="False"
                    Style="{DynamicResource SuspendButtonStyle}" />
                <Button
                    Content="停止"
                    IsEnabled="False"
                    Style="{DynamicResource StopButtonStyle}" />
                <Button Content="急停" Style="{DynamicResource SuddenStopButtonStyle}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <Button Content="新增Job" Style="{DynamicResource AddButtonStyle}" />
                <Button Content="新增Job" Style="{DynamicResource NormalButtonStyle}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <Label
                    Margin="0,0,10,0"
                    Content="运行"
                    Style="{DynamicResource RoundLabelStyle}"
                    Tag="运行" />
                <Label
                    Margin="0,0,10,0"
                    Content="运行中"
                    Style="{DynamicResource RoundLabelStyle}"
                    Tag="运行中" />
                <Label
                    Margin="0,0,10,0"
                    Content="已暂停"
                    Style="{DynamicResource RoundLabelStyle}"
                    Tag="已暂停" />
                <Label
                    Margin="0,0,10,0"
                    Content="故障"
                    Style="{DynamicResource RoundLabelStyle}"
                    Tag="故障" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <DataGrid x:Name="gridArea" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            x:Name="cboCity"
                            Width="120"
                            Binding="{Binding Num}"
                            ClipboardContentBinding="{x:Null}"
                            Header="序号" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Name}"
                            ClipboardContentBinding="{x:Null}"
                            Header="名称" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Status}"
                            ClipboardContentBinding="{x:Null}"
                            Header="状态" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding TIS}"
                            ClipboardContentBinding="{x:Null}"
                            Header="TIS" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding X}"
                            ClipboardContentBinding="{x:Null}"
                            Header="X" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding Y}"
                            ClipboardContentBinding="{x:Null}"
                            Header="Y" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <Label Style="{DynamicResource ContainerLabelStyle}" Tag="RecipeName">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="测试2" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="测试3" />
                    </Grid>
                </Label>
            </StackPanel>
            <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                <Label Style="{DynamicResource RowLabelStyle}" Tag="asasdfasdfasdf">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#444"
                        Text="测试123123123" />
                </Label>
                <Label Style="{DynamicResource RowLabelStyle}" Tag="测试：">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Yes" />
                        <RadioButton Content="No" />
                        <Button Content="确认" />
                    </StackPanel>
                </Label>
                <Label Style="{DynamicResource RowLabelStyle}" Tag="12323：">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Button Content="阿斯顿发生" />
                    </Grid>
                </Label>
            </StackPanel>
            <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#D5E0E6">
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                            <Button Style="{DynamicResource TabItemButtonStyle}">
                                <Border Background="#fff" Style="{DynamicResource TabItemBorderStyle}">
                                    <TextBlock Style="{DynamicResource TableItemTextBlockStyle}" Text="当前运行Job状态" />
                                </Border>
                            </Button>
                            <Button Style="{DynamicResource TabItemButtonStyle}">
                                <Border Background="#60ffffff" Style="{DynamicResource TabItemBorderStyle}">
                                    <TextBlock Style="{DynamicResource TableItemTextBlockStyle}" Text="实时日志" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        Height="30"
                        Background="#ccc" />
                </Grid>
            </StackPanel>
            <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#fff">
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                            <Button Style="{DynamicResource MinTabItemButtonStyle}" Tag="Selected">
                                <TextBlock Style="{DynamicResource TableItemTextBlockStyle}" Text="当前运行Job状态" />
                            </Button>
                            <Button Style="{DynamicResource MinTabItemButtonStyle}" Tag="Red">
                                <TextBlock Style="{DynamicResource TableItemTextBlockStyle}" Text="实时日志" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        Height="30"
                        Background="#ccc" />
                </Grid>
            </StackPanel>
            <StackPanel Height="200">
                <!--<hc:ProgressButton IsChecked="{Binding IsUploading,Mode=TwoWay}" Progress="{Binding Progress}" Content="{Binding IsChecked,RelativeSource={RelativeSource Self},Converter={StaticResource Boolean2StringConverter},ConverterParameter={x:Static langs:Lang.UploadStr}}" Width="180" Margin="5"/>
        <hc:ProgressButton Style="{StaticResource ProgressButtonPrimary}" IsChecked="{Binding IsUploading,Mode=TwoWay}" Progress="{Binding Progress}" Content="{Binding IsChecked,RelativeSource={RelativeSource Self},Converter={StaticResource Boolean2StringConverter},ConverterParameter={x:Static langs:Lang.UploadStr}}" Width="180" Margin="5"/>
        <hc:ProgressButton Style="{StaticResource ProgressButtonSuccess}" IsChecked="{Binding IsUploading,Mode=TwoWay}" Progress="{Binding Progress}" Content="{Binding IsChecked,RelativeSource={RelativeSource Self},Converter={StaticResource Boolean2StringConverter},ConverterParameter={x:Static langs:Lang.UploadStr}}" Width="180" Margin="5"/>
        <hc:ProgressButton Style="{StaticResource ProgressButtonInfo}" IsChecked="{Binding IsUploading,Mode=TwoWay}" Progress="{Binding Progress}" Content="{Binding IsChecked,RelativeSource={RelativeSource Self},Converter={StaticResource Boolean2StringConverter},ConverterParameter={x:Static langs:Lang.UploadStr}}" Width="180" Margin="5"/>
        <hc:ProgressButton Style="{StaticResource ProgressButtonWarning}" IsChecked="{Binding IsUploading,Mode=TwoWay}" Progress="{Binding Progress}" Content="{Binding IsChecked,RelativeSource={RelativeSource Self},Converter={StaticResource Boolean2StringConverter},ConverterParameter={x:Static langs:Lang.UploadStr}}" Width="180" Margin="5"/>
        <hc:ProgressButton Style="{StaticResource ProgressButtonDanger}" IsChecked="{Binding IsUploading,Mode=TwoWay}" Progress="{Binding Progress}" Content="{Binding IsChecked,RelativeSource={RelativeSource Self},Converter={StaticResource Boolean2StringConverter},ConverterParameter={x:Static langs:Lang.UploadStr}}" Width="180" Margin="5"/>-->
                <!--<Slider
                  x:Name="SliderLightIntensity"
                  Grid.Row="1"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Maximum="{Binding MaxIntensity}"
                  Minimum="0"
                  Style="{StaticResource SliderBaseStyle}"
                  Value="{Binding CurrentIntensity}">
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="ValueChanged">
              <b:InvokeCommandAction Command="{Binding ExecuteAdjustingLightSourceCommand}" CommandParameter="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </Slider>-->
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

