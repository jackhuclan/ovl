<Window x:Class="Ovl.UI.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ovl.UI.Views.Placeholder"
        xmlns:vm="clr-namespace:Ovl.UI.ViewModels.Placeholder;assembly=Ovl.UI.ViewModels"
        Title="Ovl 上位机"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 页面 VM → View 内嵌映射：新增功能页时在此登记 DataTemplate -->
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 竖向 Sidebar -->
            <Border Grid.Column="0" Background="#202124">
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,12,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="#E8EAED"
                                           Width="24"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           Margin="14,0,0,0"
                                           FontSize="14"
                                           Foreground="#E8EAED"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="18,12" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border"
                                                Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3A3D41" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#007ACC" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- 右侧内容区：内嵌展示当前页面 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Footer 状态栏 -->
        <Border Grid.Row="1" Background="#E8EAED" BorderBrush="#D0D3D8" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False" Margin="12,4">
                <TextBlock Text="{Binding EquipmentName, StringFormat=设备：{0}}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#3C4043" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Version, StringFormat=版本：{0}}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#3C4043" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
