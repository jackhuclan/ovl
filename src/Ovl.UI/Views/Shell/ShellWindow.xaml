<Window x:Class="Ovl.UI.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ovl.UI.Views.Placeholder"
        xmlns:measureViews="clr-namespace:Ovl.UI.Views.Measure"
        xmlns:vm="clr-namespace:Ovl.UI.Placeholder"
        xmlns:measureVm="clr-namespace:Ovl.UI.Measure"
        xmlns:recipeVm="clr-namespace:Ovl.UI.Recipe"
        xmlns:recipeViews="clr-namespace:Ovl.UI.Views.Recipe"
        xmlns:settingVm="clr-namespace:Ovl.UI.Setting"
        xmlns:settingViews="clr-namespace:Ovl.UI.Views.Setting"
        xmlns:toolVm="clr-namespace:Ovl.UI.Tools"
        xmlns:toolViews="clr-namespace:Ovl.UI.Views.Tools"
        xmlns:alarmVm="clr-namespace:Ovl.UI.Tools"
        xmlns:alarmViews="clr-namespace:Ovl.UI.Views.Alarm"
        xmlns:defectVm="clr-namespace:Ovl.UI.Defect.ViewModel"
        xmlns:defectViews="clr-namespace:Ovl.UI.Defect.View"
        xmlns:waferVm="clr-namespace:Ovl.UI.WaferHandler.ViewModel"
        xmlns:waferViews="clr-namespace:Ovl.UI.WaferHandler.View"
        Title="Ovl 上位机"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 页面 VM → View 内嵌映射：新增功能页时在此登记 DataTemplate -->
        <DataTemplate DataType="{x:Type measureVm:MainViewModel}">
            <measureViews:MainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type recipeVm:RecipeViewModel}">
            <recipeViews:RecipeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settingVm:SettingViewModel}">
            <settingViews:SettingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolVm:ResultViewModel}">
            <toolViews:FolderLinkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolVm:HelpViewModel}">
            <toolViews:FolderLinkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type alarmVm:AlarmViewModel}">
            <alarmViews:AlarmView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type defectVm:DefectDetectViewModel}">
            <defectViews:DefectDetectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type waferVm:WaferHandlerViewModel}">
            <waferViews:WaferHandlerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 竖向 Sidebar（纯图标模式）：默认仅显示图标，悬停以 ToolTip 显示文字提示；
                 图标风格与原顶部工具栏一致（线性图标 + 高亮蓝），选中项浅蓝底 + 左侧指示条 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E3E7" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,10,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="#5F6368"
                                           Width="24"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           x:Name="Glyph" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#1A73E8" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,4" />
                            <Setter Property="Height" Value="44" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding Title}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
                            <Setter Property="ToolTipService.VerticalOffset" Value="0" />
                            <Setter Property="ToolTipService.Placement" Value="Right" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <!-- 选中态左侧指示条 -->
                                            <Border x:Name="Indicator"
                                                    Width="3"
                                                    Height="20"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="1.5"
                                                    Background="Transparent" />
                                            <Border x:Name="Border"
                                                    Background="Transparent"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#F1F3F4" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#E8F0FE" />
                                                <Setter TargetName="Indicator" Property="Background" Value="#1A73E8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- 右侧内容区：内嵌展示当前页面 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Footer 状态栏 -->
        <Border Grid.Row="1" Background="#E8EAED" BorderBrush="#D0D3D8" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False" Margin="12,4">
                <TextBlock Text="{Binding EquipmentName, StringFormat=设备：{0}}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#3C4043" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Version, StringFormat=版本：{0}}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#3C4043" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
