                            Background="#F3F4F7"
                            BorderBrush="#E6E7EA"
                            BorderThickness="1">
              <Grid Margin="0">

                <DataGrid
                                    x:Name="RawDataDataGrid"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    AutoGenerateColumns="False"
                                    CanUserSortColumns="False"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding JobRuningDataList.RawData}"
                                    RowStyle="{StaticResource DataGridRowStyle_Status}"
                                    SelectionMode="Single"
                                    Style="{StaticResource DataGrid.Small}"
                                    Visibility="Collapsed">

                  <DataGrid.Columns>

                    <DataGridTextColumn CanUserSort="False" 
                                            Binding="{Binding WaferSlotNo}"
                                            ElementStyle="{StaticResource DataGridTextColumnElementStyle}"
                                            Header="SLot#" />
                    <DataGridTextColumn CanUserSort="False" 
                                            Binding="{Binding WaferIterations}"
                                            ElementStyle="{StaticResource DataGridTextColumnElementStyle}"
                                            Header="Iteration" />
                    <DataGridTextColumn CanUserSort="False" ElementStyle="{StaticResource DataGridTextColumnElementStyle}" Header="X Misreg">
                      <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource MeasureValueUnitFactorConverter}" Mode="OneWay">
                          <Binding Path="Overlay.MisregX" />
                          <Binding Path="DataContext.MeasureValueUnitFactor" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                          <!--  静态值  -->
                        </MultiBinding>
                      </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn CanUserSort="False"  ElementStyle="{StaticResource DataGridTextColumnElementStyle}" Header="Y Misreg">
                      <DataGridTextColumn.Binding>
