<UserControl
    x:Class="Ovl.UI.Views.Tools.FolderLinkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="500" d:DesignWidth="800">

    <!--  Result / Help 页：原版菜单直接 explorer 打开目录，保持同行为（内嵌提示 + 打开按钮）  -->
    <Border Margin="12" Background="#fff" CornerRadius="5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#444"
                       Text="{Binding Title, StringFormat={}{0} 目录}" />
            <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#888" Text="{Binding FolderPath}" TextTrimming="CharacterEllipsis" />
            <Button
                MinWidth="140"
                Height="32"
                Margin="0,16,0,0"
                Padding="16,0"
                Background="#1A73E8"
                BorderThickness="0"
                Command="{Binding OpenFolderCommand}"
                Content="Open Folder"
                Foreground="White" />
        </StackPanel>
    </Border>
</UserControl>
