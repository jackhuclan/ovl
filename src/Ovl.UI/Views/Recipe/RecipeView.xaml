<UserControl
    x:Class="Ovl.UI.Views.Recipe.RecipeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:handy="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Ovl.UI.Views.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1400"
    mc:Ignorable="d">
    <!--  Recipe 页面（内嵌展示，替代原版 RecipeWindow 弹窗）：
          布局沿用原版两栏结构（左配方树 + 右内容区，可折叠），
          页签样式键与原版 RecipeWindow 一致（BorderRecipeTabItem / ButtonRecipeTabItem / TextBlockTableItem），
          Basic information summary 区原样使用迁移后的 RecipeBaseView；
          TestManage / RunParam / Summary 深度依赖厂内配方服务器与 Halcon（约 1.2 万行），先占位待 M4b。  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ovl.UI.Common;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="/Ovl.UI.Common;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="/Ovl.UI.Common;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BorderRecipeTabItem" TargetType="Border">
                <Setter Property="CornerRadius" Value="5,5,0,0" />
                <Setter Property="Background" Value="#fff" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="ButtonRecipeTabItem" TargetType="Button">
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style x:Key="TextBlockTableItem" TargetType="TextBlock">
                <Setter Property="Margin" Value="16,5,16,5" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="#444" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid IsEnabled="{Binding IsLocalOperationAllowed}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Width}" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左栏：配方树（对应原版 recipe:RecipeMenu）  -->
        <Border
            Grid.Column="0"
            Margin="5,5,0,5"
            Background="#fff"
            CornerRadius="5">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Height="26"
                        Margin="2"
                        VerticalContentAlignment="Center"
                        Text="{Binding SearchRecipeName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="26"
                        Height="26"
                        Margin="2"
                        Padding="0"
                        Command="{Binding SearchRecipeCommand}"
                        Content="🔍"
                        ToolTip="Search" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button
                        MinWidth="60"
                        Height="24"
                        Margin="2"
                        Command="{Binding OpenRecipeCommand}"
                        Content="Open" />
                    <Button
                        MinWidth="60"
                        Height="24"
                        Margin="2"
                        Command="{Binding ClearSearchCommand}"
                        Content="Clear" />
                    <Button
                        MinWidth="24"
                        Height="24"
                        Margin="2"
                        Padding="0"
                        Command="{Binding ToggleTreeExpandCommand}"
                        Content="{Binding TreeExpandButtonText}" />
                </StackPanel>
                <TreeView
                    Grid.Row="2"
                    Margin="0,5,0,0"
                    ItemsSource="{Binding MenuTree}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border
                                Padding="4,2"
                                Background="Transparent"
                                CornerRadius="3"
                                ToolTip="{Binding Name}">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                <Setter Property="TextBlock.Foreground" Value="#1A73E8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!--  折叠手柄（对应原版 imgMenuStrip）  -->
        <Border Grid.Column="1" VerticalAlignment="Center">
            <Button
                Height="50"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding MouseDownCommand}"
                Content="◀"
                Cursor="Hand"
                ToolTip="收起/展开" />
        </Border>

        <!--  右侧内容区：页签 + 内容  -->
        <Border
            Grid.Column="2"
            Margin="0,5,5,5"
            Background="#F3F4F7"
            CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="4,4,0,0"
                    Orientation="Horizontal">
                    <Button Command="{Binding OpenRecipeCommand}" Style="{StaticResource ButtonRecipeTabItem}">
                        <Border Style="{StaticResource BorderRecipeTabItem}">
                            <TextBlock Style="{StaticResource TextBlockTableItem}" Text="Basic Info" />
                        </Border>
                    </Button>
                    <Button Style="{StaticResource ButtonRecipeTabItem}">
                        <Border Style="{StaticResource BorderRecipeTabItem}">
                            <TextBlock Style="{StaticResource TextBlockTableItem}" Text="Test Manage" />
                        </Border>
                    </Button>
                    <Button Style="{StaticResource ButtonRecipeTabItem}">
                        <Border Style="{StaticResource BorderRecipeTabItem}">
                            <TextBlock Style="{StaticResource TextBlockTableItem}" Text="Run Param" />
                        </Border>
                    </Button>
                    <Button Style="{StaticResource ButtonRecipeTabItem}">
                        <Border Style="{StaticResource BorderRecipeTabItem}">
                            <TextBlock Style="{StaticResource TextBlockTableItem}" Text="Summary" />
                        </Border>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <local:RecipeBaseView Grid.Row="0" />
                    <Border
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Background="#fff"
                        CornerRadius="5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                Foreground="#888"
                                Text="Test Manage / Run Param / Summary 深度配方编辑（Test_Train*、Alignment* 等约 1.2 万行视图）"
                                TextAlignment="Center" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="14"
                                Foreground="#888"
                                Text="依赖厂内配方服务器与 Halcon 环境，将在 M4b（接入 nexus 凭据后）原样迁移"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
