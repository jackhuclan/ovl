<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ovl.Biz.Services\Ovl.Biz.Services.csproj" />
    <ProjectReference Include="..\Ovl.UI.Common\Ovl.UI.Common.csproj" />
    <ProjectReference Include="..\Ovl.UI.Common.ViewModels\Ovl.UI.Common.ViewModels.csproj" />
    <ProjectReference Include="..\Ovl.UI.ViewModels\Ovl.UI.ViewModels.csproj" />
    <!-- 自 packages 搬入的配方/系统配置层（M4b 深度配方编辑的基础） -->
    <ProjectReference Include="..\..\packages\InteVega.CBB.Config\InteVega.CBB.Recipe\InteVega.CBB.Recipe\InteVega.CBB.Recipe.csproj" />
    <ProjectReference Include="..\..\packages\InteVega.CBB.Config\InteVega.CBB.SystemConfig\InteVega.CBB.SystemConfig\InteVega.CBB.SystemConfig.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- conf 配置目录整体拷贝到输出（ConfFileService 默认根 = 运行目录/conf） -->
    <None Include="conf\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 嵌入资源：XAML 通过 pack URI（/Ovl.UI;component/Assets/...）引用 -->
  <ItemGroup>
    <Resource Include="Assets\ImageViewer.png" />
  </ItemGroup>

</Project>
