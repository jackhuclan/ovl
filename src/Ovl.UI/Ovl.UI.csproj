  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- conf 配置目录整体拷贝到输出（ConfFileService 默认根 = 运行目录/conf） -->
    <None Include="conf\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 嵌入资源：XAML 通过 pack URI（/Ovl.UI;component/Assets/...）引用 -->
  <ItemGroup>
    <Resource Include="Assets\ImageViewer.png" />
    <!-- 自 Ovl.UI.Common 合并：mega.png（Common/Resources/Icons 下相对引用） -->
    <Resource Include="Common\Assets\mega.png" />
    <Resource Include="Resources\Images\img_jit%402x.png" />
    <Resource Include="Resources\Images\img_jit%403x.png" />
    <Resource Include="Resources\Languages\ViewDict_ch.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Resource>
    <Resource Include="Resources\Languages\ViewDict_en.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <SubType>Designer</SubType>
