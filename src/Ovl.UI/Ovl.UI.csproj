    <ProjectReference Include="..\..\..\marvel\DomainService\InteVega.CBB.DomainService.Api\InteVega.CBB.DomainService.Api.csproj" />
    <ProjectReference Include="..\..\..\marvel\DomainService\InteVega.CBB.MotionController.Ui\InteVega.CBB.MotionController.Ui.csproj" />
    <ProjectReference Include="..\..\..\marvel\DomainService\InteVega.CBB.StageControlModule\InteVega.CBB.StageControlModule.csproj" />
    <ProjectReference Include="..\..\..\marvel\DomainService\InteVega.CBB.TemplateMatching.Core\InteVega.CBB.TemplateMatching.Core.csproj" />
    <ProjectReference Include="..\..\..\marvel\DomainService\InteVega.CBB.TemplateMatchingModule\InteVega.CBB.TemplateMatchingModule.csproj" />
