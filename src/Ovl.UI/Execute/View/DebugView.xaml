<UserControl x:Class="Ovl.UI.Execute.View.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:resources="marvel.st"
             xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
             xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
             xmlns:local="clr-namespace:Ovl.UI.Execute.View"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="940"  Background="#D5E0E6">
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto"/>
        <ColumnDefinition Width="auto"/>
        <ColumnDefinition Width="auto"/>
      </Grid.ColumnDefinitions>
      
     
      <stagetcontorl:StageControlImageView  Margin="0,0,5,0"
      x:Name="stageControlImageView" Grid.Column="1"
       Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}" HorizontalAlignment="Center"  VerticalAlignment="Stretch"  />

      <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="2" VerticalAlignment="Top" >
        <StackPanel VerticalAlignment="Top" Margin="0,0,10,10"  Background="#D5E0E6" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
          <stagetcontorl:StageFocusDebugView x:Name="stageFocus"/>
          <stagetcontorl:StageControlMotionView x:Name="stageMotionView"  Foreground="Black" />
          <tempmachview:TemplateMatchingControl x:Name="tmc"  Grid.Column="2" Width="420" Margin="0,10" IsDebug="True" />
        </StackPanel>
      </ScrollViewer>
     
    </Grid>
    </Grid>
</UserControl>
