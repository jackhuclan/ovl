<Window x:Class="Ovl.UI.Execute.AssitantDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ovl.UI.Execute"
        mc:Ignorable="d"
        Title="Assistant" Height="450" Width="800" SizeToContent="WidthAndHeight" ResizeMode="NoResize" >
    <Grid Margin="20">
    <Grid.RowDefinitions >
      <RowDefinition />
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>
    <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"  >
      
    </ContentPresenter>
    <TextBlock x:Name ="txtMessage" Grid.Row="1" HorizontalAlignment="Right"  Margin="0,20" TextWrapping="Wrap"  Foreground="Red" FontSize="14" MaxWidth="800" />
    <TextBlock x:Name ="txtTip" Grid.Row="2" HorizontalAlignment="Right"  Margin="0,0,0,20" TextWrapping="Wrap"  MaxWidth="800"  />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3" >
      <Button Content="Close Buzzer" Click="Button_Click_2"></Button>
      <Button Content="Retry" Style="{DynamicResource ButtonPrimary}" MinWidth="80" Margin="10,0" Click="Button_Click"/>
      <Button Content="Cancel" MinWidth="80" Click="Button_Click_1"/>
    </StackPanel>
  </Grid>
</Window>
