<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icon="clr-namespace:Ovl.UI.Common.Controls.Icon">

    <!--  原样移植自厂内 CustomStyleResourceDictionary.xaml（MainMenuIcon 样式，视觉不变）  -->
    <Style x:Key="MainMenuIcon" TargetType="icon:CustomIcon">
        <Setter Property="Foreground" Value="#0F54C6" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseCaptured, RelativeSource={RelativeSource AncestorType=Button, Mode=FindAncestor}}" Value="True">
                <Setter Property="Foreground" Value="#ffff" />
                <Setter Property="Background" Value="#0F54C6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
