<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dataModel="clr-namespace:Ovl.Biz.Common.Enums;assembly=Ovl.Biz.Common"
    xmlns:hc="https://handyorg.github.io/handycontrol">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ovl.UI;component/Common/Resources/Themes/ThemeConverters.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ContainerLabelStyle" TargetType="Label">
        <Setter Property="Background" Value="#F3F4F7" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        BorderBrush="#E6E7EA"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Height="32"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E6E7EA"
                                BorderThickness="0,0,0,1"
                                CornerRadius="5,5,0,0">
                                <TextBlock
                                    Margin="15,7,0,0"
                                    FontWeight="DemiBold"
                                    Text="{TemplateBinding Tag}" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Grid.Column="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ExpandGroupBoxStyle" TargetType="{x:Type GroupBox}">
        <Setter Property="Background" Value="#F3F4F7" />
        <Setter Property="hc:StatusSwitchElement.CheckedElement" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        BorderBrush="#E6E7EA"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Height="32"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E6E7EA"
                                BorderThickness="0,0,0,1"
                                CornerRadius="5,5,0,0">
                                <CheckBox
                                    x:Name="tb"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Path=(hc:StatusSwitchElement.CheckedElement), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    Tag="{TemplateBinding Header}">

                                    <ToggleButton.Style>
                                        <Style TargetType="{x:Type CheckBox}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type CheckBox}">
                                                        <Grid Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                FontWeight="DemiBold"
                                                                Text="{TemplateBinding Tag}" />
                                                            <Path
                                                                x:Name="path"
                                                                Grid.Column="1"
                                                                Width="20"
                                                                Height="20"
                                                                Margin="0,2,15,2"
                                                                HorizontalAlignment="Right"
                                                                Data="{DynamicResource DownGeometry}"
                                                                Fill="#FF1296DB"
                                                                Stretch="Uniform"
                                                                StrokeThickness="1" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="path" Property="Data" Value="{DynamicResource UpGeometry}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>

                                </CheckBox>

                            </Border>

                            <ContentPresenter
                                Grid.Row="1"
                                Grid.Column="0"
                                Visibility="{Binding IsChecked, ElementName=tb, Converter={StaticResource OtvCVT}}" />

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Container_PortLabelStyle" TargetType="Label">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        BorderBrush="#E6E7EA"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Height="32"
                                Background="#F3F4F7"
                                BorderBrush="#E6E7EA"
                                BorderThickness="0,0,0,1"
                                CornerRadius="5,5,0,0">
                                <TextBlock
                                    Margin="16,7,0,0"
                                    FontWeight="DemiBold"
                                    Text="{TemplateBinding Tag}" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Grid.Column="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Container_PortLabelStyleOther" TargetType="Label">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        BorderBrush="#E6E7EA"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Height="32"
                                Background="#F3F4F7"
                                BorderBrush="#E6E7EA"
                                BorderThickness="0,0,0,1"
                                CornerRadius="5,5,0,0">
                                <WrapPanel Margin="16,5,0,0">
                                    <Label
                                        x:Name="lblStatus"
                                        Grid.Column="0"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Content=""
                                        Style="{DynamicResource RoundLabelStyle}"
                                        Tag="运行" />
                                    <TextBlock
                                        Margin="3,3,0,0"
                                        FontWeight="DemiBold"
                                        Text="{TemplateBinding Tag}" />
                                </WrapPanel>
                            </Border>
                            <ContentPresenter Grid.Row="1" Grid.Column="0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter TargetName="lblStatus" Property="Tag" Value="{x:Static dataModel:EnumRunState.IDLE}" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="lblStatus" Property="Tag" Value="{x:Static dataModel:EnumRunState.STOPPING}" />
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RoundLabelStyle" TargetType="Label">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Border
                        x:Name="border"
                        Width="20"
                        Height="20"
                        Margin="{TemplateBinding Margin}"
                        BorderThickness="3"
                        CornerRadius="20" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.INIT}">
                            <Setter TargetName="border" Property="Background" Value="#666" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#ddd" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.IDLE}">
                            <Setter TargetName="border" Property="Background" Value="#13B323" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#75D97F" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.Running}">
                            <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#C1D8FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.PROCESS}">
                            <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#C1D8FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.SETUP}">
                            <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#C1D8FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.READY}">
                            <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#C1D8FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.LOAD}">
                            <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#C1D8FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.WORKING}">
                            <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#C1D8FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.UNLOAD}">
                            <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#C1D8FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.PAUSED}">
                            <Setter TargetName="border" Property="Background" Value="#D37C11" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#FFAF4B" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.PROCESS_PAUSED}">
                            <Setter TargetName="border" Property="Background" Value="#D37C11" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#FFAF4B" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.ALARM_PAUSED}">
                            <Setter TargetName="border" Property="Background" Value="#D31111" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#FFB1B1" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.IDLE_WITH_ALARM}">
                            <Setter TargetName="border" Property="Background" Value="#D31111" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#FFB1B1" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static dataModel:EnumRunState.STOPPING}">
                            <Setter TargetName="border" Property="Background" Value="#666" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#ddd" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RowLabelStyle" TargetType="Label">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Border
                        Margin="13,9,13,0"
                        BorderBrush="#E6E7EA"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,4"
                                VerticalAlignment="Center"
                                Foreground="#444"
                                Text="{TemplateBinding Tag}" />
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Right">
                                <ContentPresenter
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>