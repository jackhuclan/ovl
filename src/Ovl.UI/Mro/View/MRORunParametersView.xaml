<UserControl
    x:Class="Ovl.UI.Recipe.View.MRORunParametersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:converter="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
    xmlns:converts="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="750"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToStringConverter x:Key="BoolToStringConverter" />
            <converts:ObjectToBool x:Key="ObjectToBool" />
            <Style x:Key="TextBlockBase" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#666" />
            </Style>
            <Style
                x:Key="TextBlockTitle"
                BasedOn="{StaticResource TextBlockBase}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Black" />
                <Setter Property="Foreground" Value="#444" />
            </Style>
            <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Foreground" Value="#666" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="10,0,0,0" />
            </Style>
            <Style x:Key="BorderSlot" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E6E7EA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>

            <!--  切换开关样式  -->
            <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border
                                x:Name="Border"
                                Width="40"
                                Height="20"
                                Background="#E0E0E0"
                                BorderThickness="0"
                                CornerRadius="10">
                                <Ellipse
                                    x:Name="Thumb"
                                    Width="16"
                                    Height="16"
                                    Margin="2"
                                    HorizontalAlignment="Left"
                                    Fill="White"
                                    Stroke="#BDBDBD" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2196F3" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  列标题样式  -->
            <Style x:Key="CafColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="BorderBrush" Value="#E0E0E0" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Foreground" Value="#333333" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <!--  按钮样式  -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2196F3" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="15,8" />
                <Setter Property="Margin" Value="5,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!--  组框样式  -->
            <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#E0E0E0" />
                <Setter Property="Foreground" Value="#333333" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="10" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="Background" Value="#F9F9F9" />
            </Style>

            <!--  数据网格样式  -->
            <Style x:Key="TestsDataGridStyle" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#E0E0E0" />
            </Style>

            <!--  数据网格行样式  -->
            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Height" Value="35" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--  文本框样式  -->
            <Style x:Key="TextBoxStyle" TargetType="TextBox">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#CCCCCC" />
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <converter:EnumToDesConverter x:Key="EnumToDescriptionConverter" />
            <DataTemplate x:Key="EnumToDescriptionTemplate">
                <Border>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="20,0,0,0"
            VerticalAlignment="Center"
            FontSize="24"
            FontWeight="Bold"
            Foreground="Black"
            Text="RunParameters" />
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <Button
                Grid.Row="0"
                Grid.Column="0"
                Width="80"
                Margin="10"
                Command="{Binding SaveCommand}"
                Style="{StaticResource ButtonPrimary}">
                Save
            </Button>
        </StackPanel>

        <!--  主要内容区域  -->
        <Grid Grid.Row="1" Margin="15,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：Input Parameters  -->
            <Label
                Grid.Column="0"
                Margin="0"
                Style="{DynamicResource ContainerLabelStyle}"
                Tag="Input Parameters">
                <Border Margin="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0,5,0,0"
                                Padding="10"
                                FontWeight="Bold"
                                Text="Measure OVL :" />
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ToggleButton
                                    Margin="10,5"
                                    HorizontalAlignment="Left"
                                    Background="#DBDBDB"
                                    IsChecked="{Binding MeasureOvl}"
                                    Style="{StaticResource ToggleButtonSwitch}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,5,0,0"
                                Padding="10"
                                FontWeight="Bold"
                                Text="Compare Tests :" />
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ToggleButton
                                    Margin="10,5"
                                    HorizontalAlignment="Left"
                                    Background="#DBDBDB"
                                    IsChecked="{Binding CompareTests}"
                                    Style="{StaticResource ToggleButtonSwitch}" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <TextBlock
                                    Grid.Row="5"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="SBS Match Report :" />
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    MaxWidth="240"
                                    VerticalAlignment="Center"
                                    Text="{Binding MroRunParameter.SBSPath}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding MroRunParameter.SBSPath}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="10,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearSBSCommand}"
                                    Content="×"
                                    Style="{DynamicResource CircleButtonStyle}"
                                    Visibility="{Binding MroRunParameter.SBSPath, Converter={StaticResource OtvCVT}}" />
                                <Button
                                    Grid.Row="5"
                                    Grid.Column="2"
                                    Margin="10,5"
                                    HorizontalAlignment="Right"
                                    Background="#4CAF50"
                                    Command="{Binding LoadCommand}"
                                    Content="Load"
                                    Foreground="White" />
                            </Grid>
                            <TextBlock
                                Grid.Row="3"
                                Padding="10"
                                VerticalAlignment="Top"
                                FontWeight="Bold"
                                Text="Tests for Run :" />
                            <StackPanel
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="10,5"
                                    Background="#FF9800"
                                    Command="{Binding SelectAllTestsCommand}"
                                    Content="Select All"
                                    DockPanel.Dock="Right" />
                            </StackPanel>

                        </Grid>

                        <!--  测试列表表格  -->
                        <DataGrid
                            Grid.Row="1"
                            Margin="10"
                            ItemsSource="{Binding Tests}"
                            RowStyle="{StaticResource DataGridRowStyle}"
                            Style="{StaticResource TestsDataGridStyle}">
                            <DataGrid.Columns>
                                <!--  # 列  -->
                                <DataGridTextColumn
                                    Width="40"
                                    Binding="{Binding Id}"
                                    Header="#"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource CafColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Test Name 列  -->
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Testname}"
                                    Header="Test Name"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource CafColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="5,0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Testname}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Type 列  -->
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Type}"
                                    Header="Type"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource CafColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="5,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Select 列  -->
                                <DataGridTemplateColumn Width="80" Header="Select">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource CafColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Label>

            <!--  右侧：Output Parameters  -->
            <Label
                Grid.Column="1"
                Margin="10,0,0,0"
                Style="{DynamicResource ContainerLabelStyle}"
                Tag="Output Parameters">
                <Border Margin="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,5,0,0"
                                Padding="10"
                                FontWeight="Bold"
                                Text="Number of Recipes to Generate :" />
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <hc:NumericUpDown
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Height="24"
                                    DecimalPlaces="3"
                                    Minimum="0"
                                    PreviewMouseWheel="NumericUpDown_PreviewMouseWheel"
                                    Value="{Binding NumberOfRecipes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <!--<TextBlock Grid.Row="1" Text="Overwrite Recipe :" FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding OverwriteRecipe}" Margin="10" Background="#DBDBDB" Style="{StaticResource ToggleButtonSwitch}"  HorizontalAlignment="Left"/>
                            </StackPanel>-->
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,5,0,0"
                                Padding="10"
                                FontWeight="Bold"
                                Text="Output Table Creation on Last Cycle:" />
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ToggleButton
                                    Margin="10"
                                    HorizontalAlignment="Left"
                                    Background="#DBDBDB"
                                    IsChecked="{Binding OutputTableCreation}"
                                    Style="{StaticResource ToggleButtonSwitch}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,5,0,0"
                                Padding="10"
                                FontWeight="Bold"
                                Text="Send MRO data to Analyzer:" />
                            <StackPanel
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ToggleButton
                                    Margin="10"
                                    HorizontalAlignment="Left"
                                    Background="#DBDBDB"
                                    IsChecked="{Binding SendMroData}"
                                    Style="{StaticResource ToggleButtonSwitch}" />
                            </StackPanel>

                        </Grid>
                        <Label
                            Grid.Row="1"
                            Margin="10"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Generated Recipe Name">
                            <Border Margin="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Padding="10"
                                        FontWeight="Bold"
                                        Text="RecipeName Suffix (Sequence filling) :" />
                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBox
                                            Width="80"
                                            Margin="10"
                                            HorizontalAlignment="Left"
                                            Text="{Binding RecipeNameSuffix}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        Padding="10"
                                        FontWeight="Bold"
                                        Text="TestName Suffix (Sequence filling) :" />
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBox
                                            Width="80"
                                            Margin="10"
                                            HorizontalAlignment="Left"
                                            Text="{Binding TestNameSuffix}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Label>
                    </Grid>

                </Border>
            </Label>
        </Grid>
    </Grid>
</UserControl>
