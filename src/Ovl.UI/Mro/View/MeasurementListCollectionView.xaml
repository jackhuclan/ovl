<UserControl x:Class="Ovl.UI.Recipe.View.MeasurementListCollectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ovl.UI.ViewModels.Recipe;assembly=Ovl.UI.ViewModels"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:convert="clr-namespace:Ovl.UI.Resources.Converter"
      xmlns:dataModelenum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
      xmlns:converter="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
      xmlns:converts="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToStringConverter x:Key="BoolToStringConverter" />
            <converts:ObjectToBool x:Key="ObjectToBool" />
            <Style x:Key="TextBlockBase" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#666" />
            </Style>
            <Style
              x:Key="TextBlockTitle"
              BasedOn="{StaticResource TextBlockBase}"
              TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Black" />
                <Setter Property="Foreground" Value="#444" />
            </Style>
            <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Foreground" Value="#666" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="10" />
            </Style>
            <Style x:Key="BorderSlot" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E6E7EA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Foreground" Value="#333333"/>
            </Style>

            <Style x:Key="DataGridStyle" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="IsReadOnly" Value="False"/>
                <Setter Property="Margin" Value="5"/>
            </Style>

            <Style x:Key="AlternatingRowStyle" TargetType="DataGridRow">
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="#F5F5F5"/>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <converter:EnumToDesConverter x:Key="EnumToDescriptionConverter" />
            <DataTemplate x:Key="EnumToDescriptionTemplate">
                <Border>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
                </Border>
            </DataTemplate>
            <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Data Collection" FontSize="24" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" Margin="20,0,0,0"/>
        <StackPanel
Grid.Row="0"
HorizontalAlignment="Right"
VerticalAlignment="Center"
Orientation="Horizontal">

            <Button  Grid.Row="0" Width="80"  Grid.Column="0" Margin="10"  Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}">Save</Button>
        </StackPanel>

        <Grid Grid.Row="1" Margin="15,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Margin="0,0,0,0">
                <Grid x:Name="Na" Margin="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <Label Grid.Row="0" Margin="0" Style="{DynamicResource ContainerLabelStyle}" Tag="Na">
                        <Border Margin="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Row="0" Grid.Column="0" Content="Use Recipe" IsChecked="{Binding NaUseRecipe , Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.UseRecipe}, UpdateSourceTrigger=PropertyChanged}"
Style="{DynamicResource RadioButtonStyle}"  GroupName="NA"/>
                                <RadioButton  VerticalAlignment="Top" Grid.Row="1" Grid.Column="0" Content="Reset" 
                Style="{StaticResource RadioButtonStyle}" GroupName="NA" IsChecked="{Binding NaUseRecipe,Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}}"/>
                                <ItemsControl Grid.Row="0" Grid.Column="1">
                                    <CheckBox Content="All" IsChecked="{Binding NaAll , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource CheckBoxStyle}" Margin="10" IsEnabled="{Binding NaUseRecipe,Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}}"/>
                                </ItemsControl>
                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding NaOptions}" IsEnabled="{Binding NaUseRecipe,Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CheckBoxStyle}" Margin="10"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </Grid>
                        </Border>
                    </Label>
                    <Label Grid.Row="2" Margin="0,10,0,0" Style="{DynamicResource ContainerLabelStyle}" Tag="Polarizer">

                        <Border Margin="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                                <RadioButton Grid.Row="0" Grid.Column="0" Content="Use Recipe" IsChecked="{Binding PolarizerUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.UseRecipe}, UpdateSourceTrigger=PropertyChanged}" 
                                   Style="{StaticResource RadioButtonStyle}" GroupName="Polarizerwidth"/>
                            <RadioButton  VerticalAlignment="Top" Grid.Row="1" Grid.Column="0" Content="Reset" 
                                   Style="{StaticResource RadioButtonStyle}" GroupName="Polarizerwidth" IsChecked="{Binding PolarizerUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}"/>
                                <ItemsControl Grid.Row="0" Grid.Column="1">
                                    <CheckBox Content="All" IsChecked="{Binding PolarizerAll , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource CheckBoxStyle}" Margin="10" IsEnabled="{Binding PolarizerUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}"/>
                                </ItemsControl>
                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PolarizerOptions}" IsEnabled="{Binding PolarizerUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource CheckBoxStyle}" Margin="10"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                    </Border>

                </Label>
                </Grid>
            </ScrollViewer>
            <Label
      Grid.Column="1"
      Margin="10,0,0,0"
      Style="{DynamicResource ContainerLabelStyle}"
      Tag="WaveLength">
                <ScrollViewer>
                    <Border Margin="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                            <RadioButton Grid.Row="0" Grid.Column="0" Content="Use Recipe" IsChecked="{Binding WavelengthUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.UseRecipe}, UpdateSourceTrigger=PropertyChanged}" 
                                   Style="{StaticResource RadioButtonStyle}" GroupName="Wavelength"/>
                        <RadioButton  VerticalAlignment="Top" Grid.Row="1" Grid.Column="0" Content="Reset" 
                                   Style="{StaticResource RadioButtonStyle}" GroupName="Wavelength"  IsChecked="{Binding WavelengthUseRecipe , Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}"/>
                            <ItemsControl Grid.Row="0" Grid.Column="1">
                                <CheckBox Content="All" IsChecked="{Binding WavelengthAll , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Style="{StaticResource CheckBoxStyle}" Margin="10" IsEnabled="{Binding WavelengthUseRecipe , Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}"/>
                            </ItemsControl>
                            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ColorOptions}" IsEnabled="{Binding WavelengthUseRecipe , Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource CheckBoxStyle}" Margin="10"
                                                ToolTip="{Binding Name}">
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                </Border>
                </ScrollViewer>
            </Label>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="0"
Margin="10,0,10,0"
Style="{DynamicResource ContainerLabelStyle}"
Tag="Wave Tuner Settings" IsEnabled="{Binding WaveTunerEnable}">
                    <Border Margin="15">
                        <Grid>


                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Minimal WL (nm) :" FontWeight="Bold"  Margin="0,5,0,0" Padding="10"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                    <hc:NumericUpDown
                      Grid.Row="0"
                      Grid.Column="2"
                      Height="24"
                      DecimalPlaces="3"
                      Minimum="0"
                      PreviewMouseWheel="NumericUpDown_PreviewMouseWheel"
                      Value="{Binding WaveTunerMin, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Maximal WL (nm) :" FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                    <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Height="24"
DecimalPlaces="3"
Minimum="0"
PreviewMouseWheel="NumericUpDown_PreviewMouseWheel"
Value="{Binding WaveTunerMax, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="WL Step (nm):"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                    <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Height="24"
DecimalPlaces="3"
Minimum="0"
PreviewMouseWheel="NumericUpDown_PreviewMouseWheel"
Value="{Binding WaveTunerStep, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                    </Border>
                </Label>
                <Label
                    Grid.Row="1"
Margin="10,10,10,10"
Style="{DynamicResource ContainerLabelStyle}"
Tag="Wave Tuner Settings - Bandwidth" IsEnabled="{Binding WaveTunerEnable}">
                    <Border Margin="15">

                        <ScrollViewer>
                            <Border Margin="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Row="0" Grid.Column="0" Content="Use Recipe" IsChecked="{Binding BandwidthUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.UseRecipe}, UpdateSourceTrigger=PropertyChanged}" 
                   Style="{StaticResource RadioButtonStyle}" GroupName="Bandwidth"/>
                                    <RadioButton  VerticalAlignment="Top" Grid.Row="1" Grid.Column="0" Content="Reset" 
                   Style="{StaticResource RadioButtonStyle}" GroupName="Bandwidth" IsChecked="{Binding BandwidthUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ItemsControl Grid.Row="0" Grid.Column="1">
                                        <CheckBox Content="All" IsChecked="{Binding BandwidthAll , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource CheckBoxStyle}" Margin="10" IsEnabled="{Binding BandwidthUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}"/>
                                    </ItemsControl>
                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bandwidth}" IsEnabled="{Binding BandwidthUseRecipe, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:WavelengthMode.Reset}, UpdateSourceTrigger=PropertyChanged}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource CheckBoxStyle}" Margin="10"
                                ToolTip="{Binding Name}">
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </ScrollViewer>

                    </Border>
                </Label>
                <Label
                    Grid.Row="2"
Margin="10,10,10,0"
Style="{DynamicResource ContainerLabelStyle}"
Tag="High-level KPl Settings">
                    <Border Margin="15">

                        <Grid>
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Through Focus 3sigma Range :" FontWeight="Bold"  Margin="0,5,0,0" Padding="10"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                    <hc:NumericUpDown
                      Grid.Row="0"
                      Grid.Column="2"
                      Height="24"
                      DecimalPlaces="3"
                      Minimum="0"
                      PreviewMouseWheel="NumericUpDown_PreviewMouseWheel"
                      Value="{Binding Focus3sigmaRange, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Through Wavelength 3sigma Range :" FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                    <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Height="24"
DecimalPlaces="3"
Minimum="0"
PreviewMouseWheel="NumericUpDown_PreviewMouseWheel"
Value="{Binding Wavelength3sigmaRange, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Border>
                </Label>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
