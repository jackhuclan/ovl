<UserControl x:Class="Ovl.UI.Recipe.View.ParametersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ovl.UI.Recipe"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:convert="clr-namespace:Ovl.UI.Resources.Converter"
      xmlns:converter="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
      xmlns:converts="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToStringConverter x:Key="BoolToStringConverter" />
            <converts:ObjectToBool x:Key="ObjectToBool" />
            <Style x:Key="TextBlockBase" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#666" />
            </Style>
            <Style
              x:Key="TextBlockTitle"
              BasedOn="{StaticResource TextBlockBase}"
              TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Black" />
                <Setter Property="Foreground" Value="#444" />
            </Style>
            <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Foreground" Value="#666" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="10,0,0,0" />
            </Style>
            <Style x:Key="BorderSlot" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E6E7EA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <!-- 样式定义 -->
            <Style x:Key="TabItemStyle" TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border Name="Border" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,1,1,0">
                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" 
                                            HorizontalAlignment="Center" ContentSource="Header"
                                            Margin="20,10"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border" Width="40" Height="20" Background="#E0E0E0" 
                                CornerRadius="10" BorderThickness="0">
                                <Ellipse x:Name="Thumb" HorizontalAlignment="Left" Width="16" Height="16" 
                                   Margin="2" Fill="White" Stroke="#BDBDBD"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <converter:EnumToDesConverter x:Key="EnumToDescriptionConverter" />
            <DataTemplate x:Key="EnumToDescriptionTemplate">
                <Border>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Margin="0" Style="{DynamicResource ContainerLabelStyle}" Tag="Measurement">
                <Border Margin="15">
                    <Grid >
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enable :" FontWeight="Bold"  Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding IsEnable}" Margin="10" Background="#DBDBDB" Style="{StaticResource ToggleButtonSwitch}"  HorizontalAlignment="Left"/>
                            </StackPanel>

                           
                            <TextBlock Grid.Row="1" Text="TIS:" FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding IsTIS}" Margin="10" Background="#DBDBDB" Style="{StaticResource ToggleButtonSwitch}"  HorizontalAlignment="Left"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Through Focus Scan Range (um) :"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding FocusScanRange, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="Through Focus Scan step size (um):"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" IsEnabled="{Binding FocusScanStepEnable}" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding FocusScanStep, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="ANRA :"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding ANRA, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Row="5" Text="ROI Optimize Enable :" FontWeight="Bold"  Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding IsROI_OptimizeEnable}" Margin="10" Background="#DBDBDB" Style="{StaticResource ToggleButtonSwitch}" IsEnabled="{Binding ROIEnable}" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Grid.Row="6" Text="ROI Offset Adjust Range (Pixel):"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding ROIOffsetAdjustRange, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ROIEnable}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="7" Text="ROI Offset Adjust Step (Pixel):"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="7" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding ROIOffsetAdjustStep, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ROIEnable}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="8" Text="ROI Size Adjust Range (Pixel):"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="8" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding ROISizeAdjustRange, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ROIEnable}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="9" Text="ROl Size Adjust Step (Pixel):"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="9" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding ROISizeAdjustStep, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ROIEnable}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Border>
            </Label>
            <Label Grid.Row="1" Margin="0" Style="{DynamicResource ContainerLabelStyle}" Tag="Output">
                <Border Margin="15">
                    <Grid>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition />
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="MeasRank Flag :" FontWeight="Bold"  Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <ComboBox Width="150" ItemsSource="{Binding MeasRankFlagList}" SelectedItem="{Binding MeasRankFlagSelected}" SelectedIndex="0" 
Margin="30,0,0,0"></ComboBox>
                            </StackPanel>


                            <TextBlock Grid.Row="1" Text="OptRank Flag :" FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <ComboBox  Width="150" ItemsSource="{Binding OptRankFlagList}" SelectedItem="{Binding OptRankFlagSelected}" SelectedIndex="0" 
Margin="30,0,0,0"></ComboBox>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Trivial Focus Range (nm) :"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"                
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding FocusRange, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="Trivial WL Range (nm) :"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding WLRange, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="Number of Recipes to Accepted:"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding AcceptedNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Border>
            </Label>
        </Grid>

            <!-- 主体内容区域 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Margin="10,0,10,0" Style="{DynamicResource ContainerLabelStyle}" Tag="Sites">
                <Border Margin="15">
                    <Grid>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Select manually :" FontWeight="Bold"  Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="0" Grid.Column="1"   Panel.ZIndex="2" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Content="Select all" Command="{Binding SelectallCommand}" 
Background="White" Foreground="Black" Padding="15,5" Margin="0,5,0,0"/>
                                <Button Content="Clear All" Command="{Binding ClearAllCommand}" 
Background="White" Foreground="Black" Padding="15,5" Margin="10,5,0,0"/>
                            </StackPanel>

                            <StackPanel  Grid.Row="1"  Orientation="Vertical" Margin="0,0,0,0">

                                <ContentControl Margin="0,0,0,0" Width="200"  MaxWidth="200"  Content="{Binding WaferMapControl}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Vertical">
                                <!--<StackPanel Orientation="Horizontal" Margin="10" >
                                    <Rectangle Width="15" Height="15" Fill="Green"/>
                                    <TextBlock VerticalAlignment="Center" Margin="5 0 0 0">Selected</TextBlock>
                                </StackPanel>-->
                                <!-- 展示 Selectable 状态 -->
                                <StackPanel Orientation="Horizontal" Margin="10">
                                    <Rectangle Width="15" Height="15" Fill="Blue"/>
                                    <TextBlock VerticalAlignment="Center" Margin="5 0 0 0">Selectable</TextBlock>
                                </StackPanel>
                                <!-- 展示 Unselectable 状态 -->
                                <StackPanel Orientation="Horizontal" Margin="10">
                                    <Rectangle Width="15" Height="15" Fill="Gray"/>
                                    <TextBlock VerticalAlignment="Center" Margin="5 0 0 0">Unselectable</TextBlock>
                                </StackPanel>

                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Target Sampling :"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding TrainSiteSampling}" Margin="10" Background="#DBDBDB" Style="{StaticResource ToggleButtonSwitch}"  HorizontalAlignment="Left"/>
                            </StackPanel>


                            <TextBlock Grid.Row="3" Text="Number of Targets:"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding SamplingplanNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                        </Grid>
                    </Grid>

                </Border>
            </Label>
            <Label Grid.Row="1" Margin="10,10,10,0" Style="{DynamicResource ContainerLabelStyle}" Tag="Data Removal">
                <Border Margin="0">
                    <Grid>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Data Removal :" FontWeight="Bold"  Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <ComboBox  Width="150" ItemsSource="{Binding DataRemovalList}" SelectedItem="{Binding DataRemovalSelected}" SelectedIndex="0" 
Margin="30,0,0,0"></ComboBox>
                            </StackPanel>


                            <TextBlock Grid.Row="1" Text="RemovePercentage :" FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Height="24"
Width="150"
DecimalPlaces="3"
Minimum="0"
Value="{Binding RemovePercentage, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Multiplier :"  FontWeight="Bold" Margin="0,5,0,0" Padding="10"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"  VerticalAlignment="Center" Orientation="Horizontal">
                                <hc:NumericUpDown
Grid.Row="0"
Grid.Column="2"
Width="150"
Height="24"
DecimalPlaces="3"
Minimum="0"
Value="{Binding Multiplier, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Border>
            </Label>
        </Grid>
    </Grid>
</UserControl>
