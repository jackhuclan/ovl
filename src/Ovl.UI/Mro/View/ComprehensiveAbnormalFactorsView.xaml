<UserControl x:Class="Ovl.UI.Recipe.View.ComprehensiveAbnormalFactorsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ovl.UI.Recipe"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:convert="clr-namespace:Ovl.UI.Resources.Converter"
      xmlns:converter="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
      xmlns:converts="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToStringConverter x:Key="BoolToStringConverter" />
            <converts:ObjectToBool x:Key="ObjectToBool" />
            <Style x:Key="TextBlockBase" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#666" />
            </Style>
            <Style
              x:Key="TextBlockTitle"
              BasedOn="{StaticResource TextBlockBase}"
              TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Black" />
                <Setter Property="Foreground" Value="#444" />
            </Style>
            <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Foreground" Value="#666" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="10,0,0,0" />
            </Style>
            <Style x:Key="BorderSlot" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E6E7EA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <!-- 切换按钮样式 -->
            <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Border" Width="40" Height="20" Background="#E0E0E0" 
                                CornerRadius="10" BorderThickness="0">
                                <Ellipse x:Name="Thumb" HorizontalAlignment="Left" Width="16" Height="16" 
                                   Margin="2" Fill="White" Stroke="#BDBDBD"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 按钮样式 -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2196F3"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="5,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- 数据网格样式 -->
            <Style x:Key="CafDataGridStyle" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="False"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="IsReadOnly" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- 数据网格行样式 -->
            <Style x:Key="CafDataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="White"/>
                <!-- 或者设置最小行高 -->
                <Setter Property="MinHeight" Value="40"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="#F8F9FA"/>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 数据网格单元格样式 -->
            <Style x:Key="CafDataGridCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>

            <!-- 列标题样式 -->
            <Style x:Key="CafColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <converter:EnumToDesConverter x:Key="EnumToDescriptionConverter" />
            <DataTemplate x:Key="EnumToDescriptionTemplate">
                <Border>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="CAF (Comprehensive Abnormal Factors)" FontSize="24" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" Margin="20,0,0,0"/>
        <StackPanel
Grid.Row="0"
HorizontalAlignment="Right"
VerticalAlignment="Center"
Orientation="Horizontal">

            <Button  Grid.Row="0" Width="80"  Grid.Column="0" Margin="10"  Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}">Save</Button>
        </StackPanel>
        <!-- 数据表格区域 -->
        <Border Grid.Row="1" Margin="15,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
            <DataGrid  Grid.Row="1" Margin="0" x:Name="CafDataGrid"
                    ItemsSource="{Binding CafParameters}"
                    Style="{StaticResource CafDataGridStyle}"
                    RowStyle="{StaticResource CafDataGridRowStyle}"
                    AlternationCount="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                <DataGrid.Columns>
                    <!-- # 列 -->
                    <DataGridTextColumn Header="#" 
                                      Binding="{Binding Id}"
                                      Width="40"
                                      IsReadOnly="True"
                                      CanUserSort="False">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CafColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Name 列 -->
                    <DataGridTextColumn Header="Name" 
                                      Binding="{Binding Name}"
                                      Width="*"
                                      IsReadOnly="True"
                                      CanUserSort="False">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CafColumnHeaderStyle}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#333333"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Enable 列 -->
                    <DataGridTemplateColumn Header="Enable" 
                                         Width="100"
                                         CanUserSort="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CafColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ToggleSwitchStyle}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Contrast Precision Mean 列 -->
                    <DataGridTemplateColumn Header="Contrast Precision Mean" 
                                         Width="250"
                                         CanUserSort="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CafColumnHeaderStyle}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,20,0">

                                    <hc:NumericUpDown
                                        Height="24"
                                        DecimalPlaces="3"
                                        Minimum="0"
                                        Value="{Binding Mean, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Contrast Precision Alpha 列 -->
                    <DataGridTemplateColumn Header="Contrast Precision Alpha" 
                                         Width="250"
                                         CanUserSort="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CafColumnHeaderStyle}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,20,0">

                                    <hc:NumericUpDown
                                     Height="24"
                                     DecimalPlaces="3"
                                     Minimum="0"
                                     Value="{Binding Alpha, UpdateSourceTrigger=PropertyChanged}" />     
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
