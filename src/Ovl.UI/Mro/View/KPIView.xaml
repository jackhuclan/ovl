<UserControl x:Class="Ovl.UI.Recipe.View.KPIView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ovl.UI.Recipe.View"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:convert="clr-namespace:Ovl.UI.Resources.Converter"
      xmlns:converter="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI"
      xmlns:enums="clr-namespace:OVL.Algorithm.DoNet;assembly=OVL.Algorithm.DoNet"
      xmlns:converts="clr-namespace:InteVega.CBB.ComUI.ValueConverts;assembly=InteVega.CBB.ComUI" 
      xmlns:a="clr-namespace:System.Windows.Input;assembly=System"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToStringConverter x:Key="BoolToStringConverter" />
            <converts:ObjectToBool x:Key="ObjectToBool" />
            <!-- 切换开关样式 -->
            <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Border" Width="40" Height="20" Background="#E0E0E0" 
                                CornerRadius="10" BorderThickness="0">
                                <Ellipse x:Name="Thumb" HorizontalAlignment="Left" Width="16" Height="16" 
                                   Margin="2" Fill="White" Stroke="#BDBDBD"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#D0D0D0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 按钮样式 -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2196F3"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="5,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- 数值调节按钮样式 -->
            <Style x:Key="NumericButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#666666"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="2,0"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 数据网格行样式 -->
            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Height" Value="35"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="#F8F9FA"/>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 数据网格单元格样式 -->
            <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 列标题样式 -->
            <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="8,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            
            <ObjectDataProvider x:Key="ArrFilteringMethods" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="enums:FilteringMethod"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="Residual" 
                 MethodName="GetValues" 
                 ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="enums:ResidualModel"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <!-- 空字符串转Visibility -->
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <!-- 根据bool控制输入框可用状态 -->
            <local:BoolToCollapsedConverter x:Key="BoolToCollapsedConverter"/>
        </ResourceDictionary>
        
    </UserControl.Resources>
    <Grid Background="White">
        <!-- 主要内容区域 -->
        <Grid Margin="0">
            <DataGrid x:Name="KpiDataGrid"
                    ItemsSource="{Binding KpiParameters}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E0E0E0"
                    RowStyle="{StaticResource DataGridRowStyle}"
                    AlternationCount="2">

                <DataGrid.Columns>
                    <!-- # 列 -->
                    <DataGridTextColumn Header="#" 
                                      Binding="{Binding Order}"
                                      Width="40"
                                      IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Name 列 -->
                    <DataGridTemplateColumn  Header="Name" 
                                      Width="*"
                                      IsReadOnly="True">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!--标签名称-->
                                    <TextBlock Grid.Column="0" 
                                        Text="{Binding Name}" 
                                        Padding="10,5"
                                        VerticalAlignment="Center"/>

                                    <!--TAD Positions按钮-->
                                    <Button Grid.Column="1" 
                                    Content="TAD Positions"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    Foreground="#666"
                                    Cursor="Hand"
                                    ToolTip="关闭"
                                    Command="{Binding ButtonClickCommand}"
                                    Visibility="{Binding TADPositions, Converter={StaticResource BoolToCollapsedConverter}}"/>

                                    <ComboBox Grid.Column="2" Width="150" Visibility="{Binding W1F1, Converter={StaticResource BoolToCollapsedConverter}}" ItemsSource="{Binding  Source={StaticResource Residual}}" SelectedItem="{Binding ResidualModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="0" 
Margin="30,0,0,0"></ComboBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        
                    </DataGridTemplateColumn>

                    <!-- Enable 列 -->
                    <DataGridTemplateColumn Header="Enable" 
                                         Width="80">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnalbe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ToggleSwitchStyle}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Filtering Method 列 -->
                    <DataGridTemplateColumn Header="Filtering Method" 
                                         Width="120">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource ArrFilteringMethods}}"
                                        SelectedItem="{Binding FilteringMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        BorderThickness="1"
                                        BorderBrush="#CCCCCC"
                                        Padding="5,2"
                                        VerticalContentAlignment="Center" Margin="0,0,10,0">
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Threshold 列 -->
                    <DataGridTemplateColumn Header="Threshold" 
                                         Width="100">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,10,0">

                                    <hc:NumericUpDown
                                        Height="24"
                                        DecimalPlaces="3"
                                        Minimum="0"
                                        Value="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" 
                                        IsEnabled="{Binding FilteringMethod}"/>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Percentage 列 -->
                    <DataGridTemplateColumn Header="Percentage" 
                                         Width="100">

                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid  Margin="0,0,10,0">
                                    <hc:NumericUpDown
                                        Height="24"
                                        DecimalPlaces="3"
                                        Minimum="0"
                                        Value="{Binding Percentage, UpdateSourceTrigger=PropertyChanged}" 
                                        IsEnabled="{Binding FilteringMethod}"/>

                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
