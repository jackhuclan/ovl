<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_Train_DoubleFaceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataModelenum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stagecontorl1="clr-namespace:InteVega.CBB.StageControlModule.Views.CameraView;assembly=InteVega.CBB.StageControlModule"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:Test_Train40ViewModel_DoubleFace}"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    DataContext="{prism:ContainerProvider {x:Type vm:Test_Train40ViewModel_DoubleFace}}"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1800" />
            <Setter Property="Height" Value="800" />
            <!--  不允许调整窗体尺寸  -->
            <!--<Setter Property="ResizeMode" Value="NoResize" />-->
            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Marvel.ComModule;component/Style/CardPropertyGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <system:Boolean x:Key="True">True</system:Boolean>
            <system:Boolean x:Key="False">False</system:Boolean>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="350" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                        <stagetcontorl:StageControlCameraView
                            CameraColorPixEnable="False"
                            Foreground="Black"
                            ImageViewer="{Binding ImageViewer, ElementName=StageControlTrainView}"
                            Style="{x:Null}" />
                        <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                        <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlTrainView}" />
                        <stagetcontorl:StageControlMotionView Foreground="Black" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabControl
                    Name="TabMultiControl"
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    BorderBrush="#0F54C6"
                    FontSize="15"
                    Foreground="#0F54C6"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabItem
                        Width="200"
                        HorizontalAlignment="Left"
                        BorderBrush="#0F54C6"
                        FontWeight="Bold"
                        Header="Train">
                        <stagetcontorl:StageControlImageView x:Name="StageControlTrainView" />
                    </TabItem>
                    <TabItem
                        Width="200"
                        HorizontalAlignment="Left"
                        BorderBrush="#0F54C6"
                        FontWeight="Bold"
                        Header="Compare">
                        <stagecontorl1:StageControlImageMultiView x:Name="StageControlCompareView" />
                    </TabItem>
                </TabControl>
                <localControl:WaferMapStageControl
                    x:Name="wmsc"
                    Grid.Row="1"
                    MaxWidth="200"
                    MaxHeight="240"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnableMove="True"
                    Opacity="0.8" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>

            <Grid Grid.Column="2" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0">
                    <Border
                        Margin="1,0,3,0"
                        Background="#0F54C6"
                        BorderThickness="1"
                        CornerRadius="4">
                        <UniformGrid Rows="1">
                            <RadioButton
                                x:Name="Radio_Train_Inner"
                                MinWidth="130"
                                Margin="0,0,0,0"
                                Command="{Binding PatternTabChangedCommand}"
                                CommandParameter="0"
                                Content="①Inner"
                                IsChecked="True"
                                IsEnabled="True"
                                Style="{DynamicResource RadioTableItemButtonStyle_First}" />
                            <RadioButton
                                x:Name="Radio_Train_Outer"
                                Grid.Column="1"
                                MinWidth="130"
                                Command="{Binding PatternTabChangedCommand}"
                                CommandParameter="1"
                                Content="②Outer"
                                IsEnabled="True"
                                Style="{DynamicResource RadioTableItemButtonStyle}" />
                            <RadioButton
                                x:Name="Radio_Train_Measure"
                                Grid.Column="2"
                                MinWidth="130"
                                Command="{Binding PatternTabChangedCommand}"
                                CommandParameter="2"
                                Content="③Measurement"
                                IsEnabled="True"
                                Style="{DynamicResource RadioTableItemButtonStyle}" />
                        </UniformGrid>
                    </Border>
                </Grid>
                <!--  Inner Train Pannel  -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding ElementName=Radio_Train_Inner, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <StackPanel>
                        <Label
                            Margin="3"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Focus">
                            <StackPanel>
                                <Label
                                    Margin="5,5"
                                    Style="{DynamicResource ContainerLabelStyle}"
                                    Tag="Focus ROI">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{x:Null}">
                                            Inner:
                                        </Label>
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Orientation="Horizontal">
                                            <Button
                                                Width="75"
                                                Margin="5,0,0,0"
                                                Command="{Binding InnerFocusROI_SetCommand}"
                                                IsEnabled="{Binding FocusROI_SetEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Set
                                            </Button>
                                            <Button
                                                Width="75"
                                                Margin="5,0,0,0"
                                                Command="{Binding InnerFocusROI_ConfirmCommand}"
                                                IsEnabled="{Binding FocusROI_InnerEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Confirm
                                            </Button>
                                            <Button
                                                Width="75"
                                                Margin="5,0,5,0"
                                                Command="{Binding FocusROI_CancelCommand}"
                                                IsEnabled="{Binding FocusROI_InnerEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Cancel
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Label>
                                <WrapPanel Margin="10,5">
                                    <Button
                                        MinWidth="100"
                                        Margin="0,0,10,0"
                                        Command="{Binding FocusSettingCommand}"
                                        Content="Setting"
                                        Style="{StaticResource ButtonDefault}" />
                                    <Button
                                        MinWidth="100"
                                        Command="{Binding TrainFocus_SingleCommand}"
                                        Style="{StaticResource ButtonPrimary}">
                                        Run
                                    </Button>

                                </WrapPanel>

                                <!--  Inner Fine Focus Position Double 显示Recover，Run功能  -->
                                <Grid>
                                    <Label
                                        Margin="10,5"
                                        Style="{DynamicResource ContainerLabelStyle}"
                                        Tag="Focus Positon (Inner)">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Label
                                                Grid.Row="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}">
                                                Inner:
                                            </Label>
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}">
                                                Z (mm):
                                            </Label>
                                            <TextBox
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                MinWidth="50"
                                                Margin="0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                IsEnabled="False"
                                                Text="{Binding InnerFocusHeight, StringFormat=0.####}" />
                                        </Grid>
                                    </Label>
                                </Grid>
                            </StackPanel>
                        </Label>
                        <Grid>
                            <Label
                                Margin="3"
                                Style="{DynamicResource ContainerLabelStyle}"
                                Tag="Measurement">
                                <StackPanel>
                                    <Grid>
                                        <Label
                                            x:Name="measureroi"
                                            Margin="10,5"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag="Measurement ROI">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Style="{x:Null}">
                                                    Inner:
                                                </Label>
                                                <!--  CD OVL：L 型方向（内层）；仅 IsCdOvlAlgorithm 为 true 时显示。  -->
                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="0,5,5,5"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                                    <ComboBox
                                                        Margin="10,0,0,0"
                                                        ItemsSource="{Binding DirectionList}"
                                                        SelectedItem="{Binding CurrentDirection, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding IsCdOvlAlgorithm, Converter={StaticResource OtvCVT}}" />
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding InnerMeasureRoi_SetCommand}"
                                                        IsEnabled="{Binding MeasurementROI_SetEnabled}"
                                                        Style="{StaticResource ButtonPrimary}"
                                                        Visibility="{Binding MeasurementROI_InnerEnabled, Converter={StaticResource OtvReCVT}}">
                                                        Set ROI
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding MeasurementROI_InnerEnabled, Converter={StaticResource OtvCVT}}">
                                                        <Button
                                                            Width="75"
                                                            Margin="5,0,0,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding InnerMeasureRoi_ConfirmCommand}"
                                                            Style="{StaticResource ButtonPrimary}">
                                                            Confirm
                                                        </Button>
                                                        <Button
                                                            Width="75"
                                                            Margin="5,0,0,0"
                                                            Command="{Binding MeasureRoi_CancelCommand}"
                                                            Style="{StaticResource ButtonDefault}">
                                                            Cancel
                                                        </Button>

                                                        <Button
                                                            Width="75"
                                                            Margin="5,0,0,0"
                                                            Command="{Binding InnerMeasureRoi_ReSetCommand}"
                                                            Style="{StaticResource ButtonDefault}">
                                                            Reset
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>

                                            </Grid>
                                        </Label>
                                    </Grid>
                                </StackPanel>
                            </Label>
                        </Grid>
                        <StackPanel>
                            <GroupBox
                                Margin="3"
                                Header="Inner Model"
                                Style="{DynamicResource ExpandGroupBoxStyle}">
                                <StackPanel>
                                    <StackPanel
                                        Height="28"
                                        Margin="8,1,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <TextBlock Margin="0,8,10,00" Text="ExtendSize(pixel):" />
                                        <hc:NumericUpDown
                                            Width="85"
                                            Height="24"
                                            Margin="0,0,0,0"
                                            DecimalPlaces="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding RoiExtendSize_Outer, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <!--<tempmachview:TemplateMatchingControl DataContext="{Binding TemplateViewModel_Inner}" />-->
                                    <tempmachview:SingleTemplateControl
                                        x:Name="innerModelTemplateControl"
                                        ImageViewer="{Binding ImageViewer, ElementName=StageControlTrainView}"
                                        IsShowSearArea="False" />
                                </StackPanel>
                            </GroupBox>
                            <localControl:PositioningModelControl
                                x:Name="positioningModelControl_Inner"
                                IsForEachTarget="{Binding TestInfo.TrainSetting_DoubleFace.PositioningTemplateInfo_Inner.IsForEachTarget, Mode=TwoWay}"
                                IsPositioningEnabled="{Binding TestInfo.TrainSetting_DoubleFace.PositioningTemplateInfo_Inner.IsEnable, Mode=TwoWay}" />
                        </StackPanel>
                        <GroupBox
                            Margin="3,5"
                            Header="Auto Focus Correction"
                            Style="{DynamicResource ExpandGroupBoxStyle}"
                            Visibility="{Binding CorrectionVisibility}">
                            <UniformGrid
                                Margin="5,5"
                                IsEnabled="{Binding IsInnerCorrectionEnabled}"
                                Rows="1"
                                Visibility="{Binding InnerCorrectionVisibility}">
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Inner:" />
                                <TextBlock VerticalAlignment="Center" Text="Height(mm):" />
                                <TextBox
                                    Width="60"
                                    IsEnabled="False"
                                    Text="{Binding InnerCorrectionHeight, Mode=OneWay, StringFormat=0.####}" />
                                <TextBlock VerticalAlignment="Center" Text="Correction(mm):" />
                                <TextBox
                                    Width="60"
                                    IsEnabled="False"
                                    Text="{Binding InnerCorrectionValue, Mode=OneWay, StringFormat=0.####}" />
                                <Button
                                    Width="75"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ShowCorrectionValueSettingViewCommand}"
                                    CommandParameter="{StaticResource True}"
                                    Content="Set"
                                    Style="{StaticResource ButtonPrimary}" />
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
                <!--  Outer Train Pannel  -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding ElementName=Radio_Train_Outer, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <StackPanel>
                        <Label
                            Margin="3"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Focus">
                            <StackPanel>
                                <Label
                                    Margin="5,5"
                                    Style="{DynamicResource ContainerLabelStyle}"
                                    Tag="Focus ROI">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{x:Null}">
                                            Outer:
                                        </Label>
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Orientation="Horizontal">
                                            <Button
                                                Width="75"
                                                Margin="5,0,0,0"
                                                Command="{Binding OuterFocusROI_SetCommand}"
                                                IsEnabled="{Binding FocusROI_SetEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Set
                                            </Button>
                                            <Button
                                                Width="75"
                                                Margin="5,0,0,0"
                                                Command="{Binding OuterFocusROI_ConfirmCommand}"
                                                IsEnabled="{Binding FocusROI_OuterEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Confirm
                                            </Button>
                                            <Button
                                                Width="75"
                                                Margin="5,0,5,0"
                                                Command="{Binding FocusROI_CancelCommand}"
                                                IsEnabled="{Binding FocusROI_OuterEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Cancel
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Label>
                                <WrapPanel Margin="10,5">
                                    <Button
                                        MinWidth="100"
                                        Margin="0,0,10,0"
                                        Command="{Binding FocusSettingCommand}"
                                        Content="Setting"
                                        Style="{StaticResource ButtonDefault}" />
                                    <Button
                                        MinWidth="100"
                                        Command="{Binding TrainFocus_SingleCommand}"
                                        Style="{StaticResource ButtonPrimary}">
                                        Run
                                    </Button>

                                </WrapPanel>

                                <!--  Outer Fine Focus Position Double 显示Recover，Run功能  -->
                                <Grid>
                                    <Label
                                        Margin="10,5"
                                        Style="{DynamicResource ContainerLabelStyle}"
                                        Tag="Focus Positon (Outer)">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Label
                                                Grid.Row="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}">
                                                Outer:
                                            </Label>
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}">
                                                Z (mm):
                                            </Label>
                                            <TextBox
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                MinWidth="50"
                                                Margin="0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                IsEnabled="False"
                                                Text="{Binding OuterFocusHeight, StringFormat=0.####}" />
                                        </Grid>
                                    </Label>
                                </Grid>
                            </StackPanel>
                        </Label>
                        <Grid>
                            <Label
                                Margin="3"
                                Style="{DynamicResource ContainerLabelStyle}"
                                Tag="Measurement">
                                <StackPanel>
                                    <Grid>
                                        <Label
                                            x:Name="measureroi_Outer"
                                            Margin="10,5"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag="Measurement ROI">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Style="{x:Null}">
                                                    Outer:
                                                </Label>
                                                <!--  CD OVL：L 型方向（外层）；仅 IsCdOvlAlgorithm 为 true 时显示。  -->
                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="0,5,5,5"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                                    <ComboBox
                                                        Margin="10,0,0,0"
                                                        ItemsSource="{Binding DirectionList}"
                                                        SelectedItem="{Binding CurrentDirection, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding IsCdOvlAlgorithm, Converter={StaticResource OtvCVT}}" />
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding OuterMeasureRoi_SetCommand}"
                                                        IsEnabled="{Binding MeasurementROI_SetEnabled}"
                                                        Style="{StaticResource ButtonPrimary}"
                                                        Visibility="{Binding MeasurementROI_OuterEnabled, Converter={StaticResource OtvReCVT}}">
                                                        Set ROI
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding MeasurementROI_OuterEnabled, Converter={StaticResource OtvCVT}}">
                                                        <Button
                                                            Width="75"
                                                            Margin="5,0,0,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding OuterMeasureRoi_ConfirmCommand}"
                                                            Style="{StaticResource ButtonPrimary}">
                                                            Confirm
                                                        </Button>
                                                        <Button
                                                            Width="75"
                                                            Margin="5,0,0,0"
                                                            Command="{Binding MeasureRoi_CancelCommand}"
                                                            Style="{StaticResource ButtonDefault}">
                                                            Cancel
                                                        </Button>

                                                        <Button
                                                            Width="75"
                                                            Margin="5,0,0,0"
                                                            Command="{Binding OuterMeasureRoi_ReSetCommand}"
                                                            Style="{StaticResource ButtonDefault}">
                                                            Reset
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>

                                            </Grid>
                                        </Label>
                                    </Grid>
                                </StackPanel>
                            </Label>
                        </Grid>
                        <StackPanel>
                            <GroupBox
                                Margin="3"
                                Header="Outer Model"
                                Style="{DynamicResource ExpandGroupBoxStyle}">
                                <StackPanel>
                                    <StackPanel
                                        Height="28"
                                        Margin="8,1,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <TextBlock Margin="0,8,10,00" Text="ExtendSize(pixel):" />
                                        <hc:NumericUpDown
                                            Width="85"
                                            Height="24"
                                            Margin="0,0,0,0"
                                            DecimalPlaces="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding RoiExtendSize_Outer, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <!--<tempmachview:TemplateMatchingControl DataContext="{Binding TemplateViewModel_Outter}" />-->
                                    <tempmachview:SingleTemplateControl
                                        x:Name="outerModelTemplateControl"
                                        ImageViewer="{Binding ImageViewer, ElementName=StageControlTrainView}"
                                        IsShowSearArea="False" />
                                </StackPanel>
                            </GroupBox>
                            <localControl:PositioningModelControl
                                x:Name="positioningModelControl_Outer"
                                IsForEachTarget="{Binding TestInfo.TrainSetting_DoubleFace.PositioningTemplateInfo_Outer.IsForEachTarget, Mode=TwoWay}"
                                IsPositioningEnabled="{Binding TestInfo.TrainSetting_DoubleFace.PositioningTemplateInfo_Outer.IsEnable, Mode=TwoWay}" />
                        </StackPanel>
                        <!--  Auto Focus Correction  -->

                        <GroupBox
                            Margin="3,5"
                            Header="Auto Focus Correction"
                            Style="{DynamicResource ExpandGroupBoxStyle}"
                            Visibility="{Binding CorrectionVisibility}">
                            <UniformGrid
                                Margin="5,5"
                                IsEnabled="{Binding IsOuterCorrectionEnabled}"
                                Rows="1"
                                Visibility="{Binding OuterCorrectionVisibility}">
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Inner:" />
                                <TextBlock VerticalAlignment="Center" Text="Height(mm):" />
                                <TextBox
                                    Width="60"
                                    IsEnabled="False"
                                    Text="{Binding OuterCorrectionHeight, Mode=OneWay, StringFormat=0.####}" />
                                <TextBlock VerticalAlignment="Center" Text="Correction(mm):" />
                                <TextBox
                                    Width="60"
                                    IsEnabled="False"
                                    Text="{Binding OuterCorrectionValue, Mode=OneWay, StringFormat=0.####}" />
                                <Button
                                    Width="75"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ShowCorrectionValueSettingViewCommand}"
                                    CommandParameter="{StaticResource False}"
                                    Content="Set"
                                    Style="{StaticResource ButtonPrimary}" />
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
                <!--  Measurement Pannel  -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding ElementName=Radio_Train_Measure, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <StackPanel>
                        <Label
                            Margin="10,5"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Measurement Algorithm">
                            <StackPanel>
                                <Grid Visibility="{Binding BibAlgorithmParam, Converter={StaticResource OtvCVT}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Algorithm" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="5,2"
                                        ItemsSource="{Binding EnumBibAlgorithmType}"
                                        SelectedItem="{Binding BibAlgorithmParam.AlgorithmType}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Correlation" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Margin="5,2"
                                        ItemsSource="{Binding EnumCorrelationType}"
                                        SelectedItem="{Binding BibAlgorithmParam.CorrelationType}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="5,2"
                                        VerticalAlignment="Center"
                                        Text="Inner Search Area" />
                                    <hc:NumericUpDown
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="5,2"
                                        DecimalPlaces="3"
                                        Minimum="0"
                                        Value="{Binding BibAlgorithmParam.InnerSearchArea}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="5,2"
                                        VerticalAlignment="Center"
                                        Text="Outer Search Area" />
                                    <hc:NumericUpDown
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Margin="5,2"
                                        DecimalPlaces="3"
                                        Minimum="0"
                                        Value="{Binding BibAlgorithmParam.OuterSearchArea}" />
                                    <Grid Grid.Row="3" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Margin="5,2"
                                            VerticalAlignment="Center"
                                            Text="QMerit Derivative Order" />
                                        <hc:NumericUpDown
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="5,2"
                                            Minimum="0"
                                            Value="{Binding BibAlgorithmParam.QMeritDerivativeOrder}" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="ProfileCrop" />
                                    <CheckBox
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Margin="5,2"
                                        IsChecked="{Binding BibAlgorithmParam.IsProfileCrop}"
                                        Style="{StaticResource ToggleButtonSwitch}" />
                                </Grid>
                                <Grid Visibility="{Binding CDOvlAlgorithmParam, Converter={StaticResource OtvCVT}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="EdgePolarity" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="5,2"
                                        ItemsSource="{Binding EnumCDOVLPolarity}"
                                        SelectedItem="{Binding SelectEdgePolarity}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="EdgeSelect" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Margin="5,2"
                                        ItemsSource="{Binding EnumCDOVLEdgeSelect}"
                                        SelectedItem="{Binding SelectEdgeSelect}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="EdgeFilterLevel" />
                                    <hc:NumericUpDown
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="5,2"
                                        DecimalPlaces="0"
                                        Minimum="0"
                                        Value="{Binding EdgeFilterLevel}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="MinEdgeContrast" />
                                    <hc:NumericUpDown
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        Margin="5,2"
                                        Minimum="0"
                                        Value="{Binding MinEdgeContrast}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Inner Search Area" />
                                    <hc:NumericUpDown
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="5,2"
                                        DecimalPlaces="3"
                                        Minimum="0"
                                        Value="{Binding CDOvlAlgorithmParam.InnerSearchArea}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="Outer Search Area" />
                                    <hc:NumericUpDown
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Margin="5,2"
                                        DecimalPlaces="3"
                                        Minimum="0"
                                        Value="{Binding CDOvlAlgorithmParam.OuterSearchArea}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="IsContamProcessing" />
                                    <CheckBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="5,2"
                                        IsChecked="{Binding CDOvlAlgorithmParam.IsContamProcessing}"
                                        Style="{StaticResource ToggleButtonSwitch}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="MinContamScore" />
                                    <hc:NumericUpDown
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Margin="5,2"
                                        DecimalPlaces="2"
                                        Minimum="0"
                                        Value="{Binding CDOvlAlgorithmParam.MinContamScore}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="QMeritDerivativeOrder" />
                                    <hc:NumericUpDown
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="5,2"
                                        Minimum="0"
                                        Value="{Binding CDOvlAlgorithmParam.QMeritDerivativeOrder}" />
                                </Grid>
                            </StackPanel>
                        </Label>
                        <Grid>
                            <Label
                                Margin="10,5"
                                Style="{DynamicResource ContainerLabelStyle}"
                                Tag="Measurement Result Data">
                                <StackPanel>
                                    <localControl:ChartResult_ovl DataContext="{Binding CurveResultViewModel}" />
                                </StackPanel>
                            </Label>
                            <Button
                                Margin="0,7,15,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding RunCommand}"
                                Content="Run"
                                Style="{StaticResource ButtonPrimary}" />
                        </Grid>

                        <Grid Visibility="{Binding CDOvlAlgorithmParam, Converter={StaticResource OtvCVT}}">
                            <Label
                                Height="75"
                                Margin="10,5"
                                Style="{DynamicResource ContainerLabelStyle}"
                                Tag="Measurement EdgeSelect Set">
                                <StackPanel>
                                    <Button
                                        Width="100"
                                        Margin="5,5,5,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SetCdOvlCompensationCommand}"
                                        Style="{StaticResource ButtonPrimary}"
                                        Visibility="{Binding EdgeSelect, Converter={StaticResource OtvCVT}}">
                                        EdgeSelect
                                    </Button>
                                    <StackPanel
                                        Margin="0,7,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding EdgeSelect, Converter={StaticResource OtvReCVT}}">
                                        <Button
                                            Width="75"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ConfirmCdOvlCompensationCommand}"
                                            Style="{StaticResource ButtonPrimary}">
                                            Confirm
                                        </Button>
                                        <Button
                                            Width="75"
                                            Margin="5,0,0,0"
                                            Command="{Binding CancelCdOvlCompensationCommand}"
                                            Style="{StaticResource ButtonDefault}">
                                            Cancel
                                        </Button>
                                        <Button
                                            Width="75"
                                            Margin="5,0,0,0"
                                            Command="{Binding ResetCdOvlCompensationCommand}"
                                            Style="{StaticResource ButtonDefault}">
                                            Clear
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Label>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!--<Expander
                x:Name="StagetExpander"
                Grid.Column="1"
                MaxWidth="550"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                ExpandDirection="Right"
                Header="Train Panel"
                IsExpanded="True"
                Style="{StaticResource Expander.Small}"
                TextBlock.TextAlignment="Center">
            </Expander>-->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:Growl.Token="TestTrainMessage" />
        </Grid>
        <Grid Grid.Row="1">
            <WrapPanel HorizontalAlignment="Right">
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SubmitCommand}"
                    Content="Submit"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding CloseViewCommand}"
                    Content="Close"
                    Style="{StaticResource MarvelLightButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
