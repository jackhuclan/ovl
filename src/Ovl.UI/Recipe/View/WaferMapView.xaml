<UserControl
    x:Class="Ovl.UI.Recipe.View.WaferMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icon="clr-namespace:InteVega.CBB.Prism.UI.Extensions.Icon;assembly=InteVega.CBB.Prism.UI.Extensions"
    xmlns:lc="clr-namespace:Ovl.UI.ViewModels.Controls;assembly=Ovl.UI.ViewModels"
    xmlns:local="clr-namespace:Ovl.UI.ViewModels.Recipe;assembly=Ovl.UI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModel="clr-namespace:Ovl.UI.Recipe.ViewModel"
    xmlns:wafermap="clr-namespace:Marvel.WaferMapCommon;assembly=Marvel.WaferMapCommon"
    d:DesignHeight="650"
    d:DesignWidth="1800"
    DataContext="{prism:ContainerProvider {x:Type viewModel:WaferMapViewModel}}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BorderStyle_Local1" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#0F54C6" />
                        <Setter Property="TextBlock.Foreground" Value="White" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#D1D1D1" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TextBlockTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#444" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="NumInput" TargetType="hc:NumericUpDown">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Height" Value="26" />
                <Setter Property="DecimalPlaces" Value="6" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border
                                Name="border"
                                Width="40"
                                Height="28"
                                Background="#FFFFFF"
                                BorderBrush="#E6E7EA"
                                BorderThickness="1"
                                CornerRadius="3">
                                <icon:CustomIcon
                                    Name="icon"
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,4,4"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#0F54C6"
                                    Kind="ButtonEditIcon"
                                    Style="{StaticResource MainMenuIcon}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="icon" Property="Kind" Value="RecipeAdd" />
                                </Trigger>
                                <Trigger Property="Tag" Value="SaveImage">
                                    <Setter TargetName="icon" Property="Kind" Value="SaveImage" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#CDE0FF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                                    <Setter TargetName="icon" Property="Foreground" Value="#fff" />

                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0F54C6" />
                                    <Setter TargetName="icon" Property="Foreground" Value="#fff" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="15,0,15,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="btnEdit"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Checked="btnEdit_Checked"
                        Command="{Binding RunStopCommand}"
                        GroupName="GroupEdit"
                        ToolTip="Define field" />
                    <StackPanel
                        Panel.ZIndex="2"
                        Orientation="Horizontal"
                        Visibility="{Binding WaferMapInfo.IsShiftedFields, Converter={StaticResource OtvCVT}}">
                        <RadioButton
                            x:Name="btnShift"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Checked="btnShift_Checked"
                            Command="{Binding RunStopCommand}"
                            GroupName="GroupEdit"
                            Tag="Selected"
                            ToolTip="Select shift fields" />
                        <StackPanel
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsChecked, ElementName=btnShift}"
                            Orientation="Horizontal">
                            <Button
                                Width="40"
                                Padding="2,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                hc:IconElement.Geometry="{StaticResource LeftGeometry}"
                                Click="Button_Click_LeftField"
                                ToolTip="Shift Left" />
                            <Button
                                Width="40"
                                Padding="2,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                hc:IconElement.Geometry="{StaticResource RightGeometry}"
                                Click="Button_Click_RightField"
                                ToolTip="Shift Right" />
                            <Button
                                Width="40"
                                Padding="2,8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                hc:IconElement.Geometry="{StaticResource UpGeometry}"
                                Click="Button_Click_UpField"
                                ToolTip="Shift Up" />
                            <Button
                                Width="40"
                                Padding="2,8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                hc:IconElement.Geometry="{StaticResource DownGeometry}"
                                Click="Button_Click_DownField"
                                ToolTip="Shift Down" />
                        </StackPanel>
                    </StackPanel>
                    <RadioButton
                        x:Name="btnComplete"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Click="btnComplete_Click"
                        Command="{Binding RunStopCommand}"
                        GroupName="GroupEdit"
                        IsChecked="True"
                        Tag="SaveImage"
                        ToolTip="Complete"
                        Visibility="{Binding IsChecked, Converter={StaticResource OtvReCVT}, RelativeSource={RelativeSource Self}}" />
                </StackPanel>

                <wafermap:WaferMapControl
                    x:Name="wmc"
                    Grid.Row="1"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Cursor="Arrow"
                    EditMode="None" />

            </Grid>
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,15,20,15"
            VerticalAlignment="Top"
            Panel.ZIndex="3"
            Background="#fff"
            BorderBrush="#E6E7EA"
            BorderThickness="1"
            CornerRadius="3">
            <Grid Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,0,10"
                        Style="{DynamicResource ContainerLabelStyle}"
                        Tag="Wafer Info">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="38" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="38" />

                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Inch：" />
                            <ComboBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Height="24"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding WaferSizeTypeList}"
                                SelectedItem="{Binding WaferMapInfo.WaferSizeType}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Thickness(mm)：" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="3"
                                Width="100"
                                Height="24"
                                DecimalPlaces="6"
                                Maximum="10"
                                Minimum="0"
                                Style="{StaticResource NumericUpDownExtend}"
                                Value="{Binding WaferMapInfo.Thickness}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="4"
                                Margin="0,0,0,0"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Edge Exclusion(mm)：" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="5"
                                Height="24"
                                Margin="0,0,10,0"
                                DecimalPlaces="6"
                                Minimum="0"
                                Style="{StaticResource NumericUpDownExtend}"
                                Value="{Binding WaferMapInfo.EdgeExclusion}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Notch type：" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Height="24"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding NotchTypeDataList}"
                                SelectedItem="{Binding WaferMapInfo.NotchType}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Direction：" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="3"
                                Height="24"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding NotchDirectionDataList}"
                                SelectedItem="{Binding WaferMapInfo.NotchDirection}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="4"
                                Margin="5,0,0,0"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="ClipToBounds:" />
                            <CheckBox
                                Grid.Row="1"
                                Grid.Column="5"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding WaferMapInfo.ClipToBounds}" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Specific：" />
                            <CheckBox
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding WaferMapInfo.IsSpecificNotch}" />


                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Specific Angle(°)：" />
                            <hc:NumericUpDown
                                Grid.Row="3"
                                Grid.Column="3"
                                Height="24"
                                Margin="0"
                                VerticalAlignment="Center"
                                DecimalPlaces="2"
                                IsEnabled="{Binding WaferMapInfo.IsSpecificNotch}"
                                Maximum="360"
                                Minimum="-360"
                                Style="{StaticResource NumericUpDownExtend}"
                                Value="{Binding WaferMapInfo.SpecificNotch}" />
                        </Grid>

                    </Label>
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,10"
                        Style="{DynamicResource ContainerLabelStyle}"
                        Tag="Field Size">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Width (mm)：" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="1"
                                Height="24"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Left"
                                DecimalPlaces="6"
                                Minimum="1"
                                Style="{StaticResource NumericUpDownExtend}"
                                Value="{Binding WaferMapInfo.FieldWidth}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Height (mm)：" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="3"
                                Height="24"
                                HorizontalAlignment="Left"
                                DecimalPlaces="6"
                                Minimum="1"
                                Style="{StaticResource NumericUpDownExtend}"
                                Value="{Binding WaferMapInfo.FieldHeight}" />

                            <CheckBox
                                Grid.Row="0"
                                Grid.Column="4"
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Click="ShiftedField_Click"
                                Content="Shifted fields"
                                Foreground="#444"
                                IsChecked="{Binding WaferMapInfo.IsShiftedFields}" />
                            <Grid
                                Grid.Row="0"
                                Grid.Column="4"
                                Margin="0,-35,0,10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource TextBlockTitle}"
                                    Text="No Field" />

                                <CheckBox
                                    x:Name="cbIsNoFieldMode"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="cbIsNoFieldMode_Checked"
                                    IsChecked="{Binding IsCheckedNoField}" />
                                <!--  添加版本号可视化绑定  -->
                            </Grid>
                        </Grid>
                    </Label>

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,0,10"
                        Style="{DynamicResource ContainerLabelStyle}"
                        Tag="Shot/Field"
                        Visibility="{Binding WaferMapInfo.IsShiftedFields, Converter={StaticResource OtvCVT}}">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Horizontal：" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="1"
                                Height="24"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Left"
                                DecimalPlaces="0"
                                Minimum="1"
                                Style="{StaticResource NumericUpDownExtend}"
                                Value="{Binding WaferMapInfo.FieldColumnSpan}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{DynamicResource TextBlockTitle}"
                                Text="Vertical：" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="3"
                                Height="24"
                                HorizontalAlignment="Left"
                                DecimalPlaces="0"
                                Minimum="1"
                                Style="{StaticResource NumericUpDownExtend}"
                                Value="{Binding WaferMapInfo.FieldRowSpan}" />
                        </Grid>
                    </Label>
                    <Label
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,0,10"
                        IsEnabled="{Binding IsChecked, ElementName=cbIsNoFieldMode, Converter={StaticResource Boolean2BooleanReConverter}}"
                        Style="{DynamicResource ContainerLabelStyle}"
                        Tag="Wafer Grid Shift Vector - R1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="0,0,10,10"
                                Content="Manual"
                                Foreground="#444"
                                IsChecked="{Binding WaferMapInfo.IsManual}" />
                            <CheckBox
                                Grid.Row="0"
                                Grid.Column="3"
                                Grid.ColumnSpan="2"
                                Margin="0,0,10,10"
                                Click="CheckBoxFieldCenter_Click"
                                Content="Center of field"
                                Foreground="#444"
                                IsChecked="{Binding WaferMapInfo.IsFieldCenter}" />
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                IsEnabled="{Binding WaferMapInfo.IsManual}"
                                Orientation="Horizontal">
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{DynamicResource TextBlockTitle}"
                                    Text="X(mm)：" />
                                <Button
                                    Width="20"
                                    Padding="2,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    hc:IconElement.Geometry="{StaticResource LeftGeometry}"
                                    Command="{Binding DecreaseFieldXCommand}"
                                    ToolTip="Decrease by field width" />
                                <hc:NumericUpDown
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Height="24"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    DecimalPlaces="6"
                                    Style="{StaticResource NumericUpDownExtend}"
                                    Value="{Binding WaferMapInfo.R1.X, Mode=TwoWay}" />
                                <Button
                                    Width="20"
                                    Padding="2,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    hc:IconElement.Geometry="{StaticResource RightGeometry}"
                                    Command="{Binding IncreaseFieldXCommand}"
                                    ToolTip="Increase by field width" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="3"
                                Grid.ColumnSpan="2"
                                IsEnabled="{Binding WaferMapInfo.IsManual}"
                                Orientation="Horizontal">

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Style="{DynamicResource TextBlockTitle}"
                                    Text="Y(mm)：" />
                                <Button
                                    Width="20"
                                    Padding="2,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    hc:IconElement.Geometry="{StaticResource DownGeometry}"
                                    Command="{Binding DecreaseFieldYCommand}"
                                    ToolTip="Decrease by field height" />
                                <hc:NumericUpDown
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    DecimalPlaces="6"
                                    IsEnabled="{Binding WaferMapInfo.IsManual}"
                                    Style="{StaticResource NumericUpDownExtend}"
                                    Value="{Binding WaferMapInfo.R1.Y}" />
                                <Button
                                    Width="20"
                                    Padding="2,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    hc:IconElement.Geometry="{StaticResource UpGeometry}"
                                    Command="{Binding IncreaseFieldYCommand}"
                                    ToolTip="Increase by field height" />
                            </StackPanel>


                        </Grid>
                    </Label>

                    <WrapPanel Grid.Row="4" Visibility="{Binding IsChecked, ElementName=cbIsNoFieldMode, Converter={StaticResource Boolean2VisibilityReConverter}}">
                        <Button
                            Margin="0,5,5,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="Button_Create_Click"
                            Content="Create Wafer Map"
                            Style="{DynamicResource MarvelDarkButton}" />
                        <Button
                            Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="Button_Edit_Click"
                            Content="Edit Wafer Map"
                            Cursor=""
                            Visibility="Collapsed" />

                        <Button
                            Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="Button_Select_Click"
                            Content="Select"
                            Cursor=""
                            Visibility="Collapsed" />
                        <Button
                            Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="Button_Check_Click"
                            Content="Check"
                            Cursor=""
                            Visibility="Collapsed" />
                        <Button
                            Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="Button_Move_Click"
                            Content="Move"
                            Cursor=""
                            Visibility="Collapsed" />
                    </WrapPanel>


                </Grid>

            </Grid>

        </Border>
        <Button
            Grid.Row="4"
            Grid.Column="1"
            Margin="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="BtnSave_Click"
            Content="Save" />
    </Grid>
</UserControl>
