<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_Train_CD_Param_View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Marvel.ComModule;component/Style/CardPropertyGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="MenuPopupBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="{DynamicResource ControlLightColor}" />
                <GradientStop Offset="0.5" Color="{DynamicResource ControlMediumColor}" />
                <GradientStop Offset="1" Color="{DynamicResource ControlLightColor}" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill" StartPoint="0,0" EndPoint="1,0">
                <LinearGradientBrush.GradientStops>
                    <GradientStopCollection>
                        <GradientStop Offset="0" Color="#000000FF" />
                        <GradientStop Offset="0.4" Color="#00000000" />
                        <GradientStop Offset="0.6" Color="#600000FF" />
                        <GradientStop Offset="1" Color="#000000FF" />
                    </GradientStopCollection>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <Grid>
                <StackPanel
                    Margin="0,8,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="100"
                        Margin="0,0,10,0"
                        Command="{Binding TrainFocusCommand}"
                        Content="Run"
                        IsEnabled="{Binding FocusROI_SetEnabled}"
                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                        MinWidth="100"
                        Command="{Binding FocusSettingCDCommand}"
                        Content="Setting"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
                <Label
                    Margin="5"
                    Style="{DynamicResource ContainerLabelStyle}"
                    Tag="Focus Setting">
                    <StackPanel Orientation="Vertical">
                        <StackPanel
                            Margin="5"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                Margin="5,10,20,0"
                                FontSize="15"
                                Text="Select Camera:" />
                            <ComboBox
                                Width="200"
                                Margin="0,5,0,0"
                                DisplayMemberPath="Name"
                                IsEnabled="False"
                                ItemsSource="{Binding TurrentMetaList}"
                                SelectedItem="{Binding TurrentMeta, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <b:InvokeCommandAction Command="{Binding SelectTurrentChangedCommand}" CommandParameter="{Binding}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </ComboBox>
                        </StackPanel>
                        <Label
                            Margin="5"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Focus Position">
                            <Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="10,3"
                                        VerticalAlignment="Center"
                                        Content="WLI Focus Position (mm):"
                                        Style="{x:Null}"
                                        Visibility="{Binding WliVisible}" />
                                    <hc:NumericUpDown
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Center"
                                        DecimalPlaces="6"
                                        IsEnabled="False"
                                        Visibility="{Binding WliVisible}"
                                        Value="{Binding AbsolateWliHeight, StringFormat=0.####}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="10,3"
                                        VerticalAlignment="Center"
                                        Content="Fine Focus Position (mm):"
                                        Style="{x:Null}" />
                                    <hc:NumericUpDown
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Center"
                                        DecimalPlaces="6"
                                        IsEnabled="False"
                                        Value="{Binding AutoFocusHeight, StringFormat=0.####}" />
                                    <Label
                                        Grid.Row="2"
                                        Margin="10,3"
                                        VerticalAlignment="Center"
                                        Style="{x:Null}">
                                        Z Position (mm):
                                    </Label>
                                    <hc:NumericUpDown
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Width="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Center"
                                        DecimalPlaces="6"
                                        IsEnabled="False"
                                        Value="{Binding FocusZHeight, StringFormat=0.####}" />
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="10,3"
                                        VerticalAlignment="Center"
                                        Content="Pzt Position (μm):"
                                        Style="{x:Null}" />
                                    <hc:NumericUpDown
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Center"
                                        DecimalPlaces="3"
                                        IsEnabled="False"
                                        Value="{Binding FocusPztOffset, StringFormat=0.####}" />
                                </Grid>
                            </Grid>
                        </Label>

                        <!--  Focus ROI  -->
                        <Label
                            Margin="5"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Focus ROI">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="ROI:"
                                    Style="{x:Null}" />

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="75"
                                        Margin="5,0,0,0"
                                        Command="{Binding FocusROI_SetCommand}"
                                        Content="Set"
                                        IsEnabled="{Binding FocusROI_SetEnabled, Converter={StaticResource OtbCVT}}"
                                        Style="{StaticResource ButtonDefault}" />

                                    <Button
                                        Width="75"
                                        Margin="5,0,0,0"
                                        Command="{Binding FocusROI_ConfirmCommand}"
                                        Content="Confirm"
                                        IsEnabled="{Binding FocusROI_ConfirmEnabled, Converter={StaticResource OtbCVT}}"
                                        Style="{StaticResource ButtonDefault}" />

                                    <Button
                                        Width="75"
                                        Margin="5,0,5,0"
                                        Command="{Binding FocusROI_CancelCommand}"
                                        Content="Cancel"
                                        IsEnabled="{Binding FocusROI_CancelEnabled, Converter={StaticResource OtbCVT}}"
                                        Style="{StaticResource ButtonDefault}" />

                                </StackPanel>
                            </Grid>
                        </Label>
                    </StackPanel>
                </Label>
            </Grid>
            <Label
                Margin="5"
                Style="{DynamicResource ContainerLabelStyle}"
                Tag="Measurement ROI">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Visibility="{Binding IsShowSelectROI, Converter={StaticResource OtvCVT}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{x:Null}"
                            Visibility="{Binding IsShowSelectROI, Converter={StaticResource OtvCVT}}">
                            Select Roi 1：
                        </Label>
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="100"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding ROITypeList}"
                            SelectedItem="{Binding TrainSetting_CD.DsROIType1, Mode=TwoWay}" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{x:Null}"
                            Visibility="{Binding IsAcrossTheCameraVision, Converter={StaticResource OtvReCVT}}">
                            Select Roi 2：
                        </Label>
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="3"
                            Width="100"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding ROITypeList}"
                            SelectedItem="{Binding TrainSetting_CD.DsROIType2, Mode=TwoWay}"
                            Visibility="{Binding IsAcrossTheCameraVision, Converter={StaticResource OtvReCVT}}" />
                    </Grid>
                    <DataGrid
                        x:Name="dgCDMultiRoi"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0,0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="True"
                        CanUserSortColumns="False"
                        CellStyle="{DynamicResource TargetDataGridCellStyle}"
                        ItemsSource="{Binding MultiRoiList}"
                        RowHeight="40"
                        RowStyle="{DynamicResource TargetListDataGridRowStyle}"
                        SelectionMode="Single"
                        Style="{DynamicResource DataGrid.Small}"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ID" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Label
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Content="{Binding Id}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CD Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Label
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Content="{Binding Name}" />
                                        <!--<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="100"></TextBox>-->
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CD Orientation">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,0" Orientation="Horizontal">
                                            <ComboBox
                                                Width="110"
                                                Margin="0,0,5,0"
                                                ItemsSource="{Binding DataContext.CDOrientention, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedItem="{Binding CDOrientention, UpdateSourceTrigger=PropertyChanged}">
                                                <b:Interaction.Triggers>
                                                    <b:EventTrigger EventName="SelectionChanged">
                                                        <b:InvokeCommandAction Command="{Binding DataContext.CDOriententionChangedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                    </b:EventTrigger>
                                                </b:Interaction.Triggers>
                                            </ComboBox>
                                            <!--  垂直或者水平，角度不能调整  -->
                                            <hc:NumericUpDown
                                                Width="60"
                                                Height="24"
                                                Margin="0,0,0,0"
                                                DecimalPlaces="0"
                                                IsEnabled="{Binding IsEnableAngle}"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding Angle, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="210" Header="Measurement ROI">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button
                                                Width="60"
                                                Command="{Binding DataContext.SetROIMultiRoiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Set ROI"
                                                Style="{StaticResource MarvelDarkButton}"
                                                Visibility="{Binding IsSetROI, Converter={StaticResource OtvReCVT}}" />
                                            <Button
                                                Width="70"
                                                Margin="5,0,0,0"
                                                Command="{Binding DataContext.ConfirmMultiRoiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Confirm"
                                                Visibility="{Binding IsSetROI, Converter={StaticResource OtvCVT}}" />
                                            <Button
                                                Width="60"
                                                Margin="5,0,0,0"
                                                Command="{Binding DataContext.CancelMultiRoiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Cancel"
                                                Visibility="{Binding IsSetROI, Converter={StaticResource OtvCVT}}" />
                                            <Button
                                                Width="60"
                                                Margin="5,0,0,0"
                                                Command="{Binding DataContext.ResetMultiRoiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Reset"
                                                Visibility="{Binding IsSetROI, Converter={StaticResource OtvCVT}}" />
                                        </StackPanel>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Label
                        Grid.Row="1"
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{x:Null}">
                        Search Area ROI:
                    </Label>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5,5,5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="75"
                            Margin="5,0,0,0"
                            Command="{Binding AreaRoiSetCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            Visibility="{Binding AreaROIEnabled, Converter={StaticResource OtvReCVT}}">
                            Set ROI
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding AreaROIEnabled, Converter={StaticResource OtvCVT}}">
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding AreaRoiConfirmCommand}"
                                Style="{StaticResource ButtonPrimary}">
                                Confirm
                            </Button>
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding AreaRoiCancelCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Cancel
                            </Button>
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding AreaRoiClearCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Clear
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!--<Label Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{x:Null}" Margin="15,0,0,0">
                        Vision:
                    </Label>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5,5,5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="75"
                            Margin="5,0,0,0"
                            Command="{Binding MeasureRoi_SetCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            IsEnabled="{Binding MeasurementROI_SetEnabled}"
                            Visibility="{Binding MeasurementROI_Enabled, Converter={StaticResource OtvReCVT}}"
                            >
                            Set ROI
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding MeasurementROI_Enabled, Converter={StaticResource OtvCVT}}">
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding MeasureRoi_ConfirmCommand}"
                                Style="{StaticResource ButtonPrimary}">
                                Confirm
                            </Button>
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding MeasureRoi_CancelCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Cancel
                            </Button>
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding MeasureRoi_ReSetCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Reset
                            </Button>
                        </StackPanel>
                    </StackPanel>-->
                </Grid>
            </Label>
            <!--<GroupBox
                Margin="3,5"
                Header="Auto Focus Correction"
                Style="{DynamicResource ExpandGroupBoxStyle}"
                Visibility="{Binding CorrectionVisibility}">
                <StackPanel>
                    <StackPanel Margin="8,5" Orientation="Horizontal">

                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Inner Focus Correction(μm):"/>
                        <hc:NumericUpDown
                            Margin="10,0,0,0"
                            DecimalPlaces="3"
                            Increment="0.1"
                            IsEnabled="{Binding IsCorrectionEnabled}"
                            Maximum="20"
                            Minimum="-20"
                            Value="{Binding CorrectionValue, Mode=TwoWay}" />
                        <Button
                            Width="75"
                            Margin="5,0,0,0"
                            Command="{Binding SetCorrectionCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            IsEnabled="{Binding IsCorrectionEnabled}"
                            Visibility="{Binding MeasurementROI_Enabled, Converter={StaticResource OtvReCVT}}"
                            >
                            Set
                        </Button>
                    </StackPanel>
                </StackPanel>

            </GroupBox>-->
            <GroupBox
                Margin="3,5"
                Header="Auto Focus Correction"
                Style="{DynamicResource ExpandGroupBoxStyle}"
                Visibility="{Binding CorrectionVisibility}">
                <UniformGrid
                    Margin="5,5"
                    IsEnabled="{Binding IsCorrectionEnabled}"
                    Rows="1">
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="Inner:" />
                    <TextBlock VerticalAlignment="Center" Text="Pzt Height(μm):" />
                    <TextBox
                        Width="60"
                        IsEnabled="False"
                        Text="{Binding CorrectionHeight, Mode=OneWay, StringFormat=0.####}" />
                    <TextBlock VerticalAlignment="Center" Text="Correction(μm):" />
                    <TextBox
                        Width="60"
                        IsEnabled="False"
                        Text="{Binding CorrectionValue, Mode=OneWay, StringFormat=0.####}" />
                    <Button
                        Width="75"
                        HorizontalAlignment="Right"
                        Command="{Binding ShowCorrectionValueSettingViewCommand}"
                        Content="Set"
                        Style="{StaticResource ButtonPrimary}" />
                    <!--  CommandParameter="{StaticResource True}"  -->
                </UniformGrid>
            </GroupBox>

            <Label
                Margin="5"
                Style="{DynamicResource ContainerLabelStyle}"
                Tag="Mark Model">
                <tempmachview:SingleTemplateControl
                    x:Name="modelTemplateControl"
                    ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                    IsShowSearArea="False" />
            </Label>
        </StackPanel>
    </Grid>
</UserControl>
