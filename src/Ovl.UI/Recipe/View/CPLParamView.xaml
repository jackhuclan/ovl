<UserControl x:Class="Ovl.UI.Recipe.View.CPLParamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:resources="clr-namespace:InteVega.CBB.StageControlModule.ViewModels;assembly=InteVega.CBB.StageControlModule"
             xmlns:local="clr-namespace:Ovl.UI.Recipe"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Visibility="{Binding IsEnableCPL,Converter={StaticResource OtvCVT}}"  >
  <Grid x:Name="grid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="auto" MinWidth="75" />
    </Grid.ColumnDefinitions>

    <TextBlock
         Grid.Row="0"
         Margin="8,10,0,0"
         VerticalAlignment="Center"
         Foreground="Black"
         
         Text="Color Filter:"
          />
    <ComboBox
         Grid.Row="0"
         Grid.Column="1"
         Grid.ColumnSpan="2"
         Margin="8,10,8,0"
         VerticalAlignment="Center"
         ItemsSource="{Binding Filters}"
         SelectedIndex="{Binding CurFilter}"
         IsEnabled="{Binding IsFilterEnable}"
        />

    <TextBlock
      Grid.Row="2"
      Margin="8,10,0,0"
      VerticalAlignment="Center"
      Foreground="Black"
      
      Text="Wave(nm):"
       Visibility ="{Binding IsEnableWave,Converter={StaticResource OtvCVT}}"/>
    <Grid   Grid.Row="2"
 Grid.Column="1" Grid.ColumnSpan="2" Margin="8,10,8,0"    Visibility ="{Binding IsEnableWave,Converter={StaticResource OtvCVT}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="auto"/>
        <ColumnDefinition Width="auto"/>
      </Grid.ColumnDefinitions>
      <hc:NumericUpDown
 Grid.Column="0"
 HorizontalAlignment="Left"  
 VerticalAlignment="Center"
 MinWidth="50"
 DecimalPlaces="0" Minimum="{Binding MinWave}" Maximum="{Binding MaxWave}" Increment="{Binding SelectedStep}"
 Value ="{Binding CurWave}" MaxWidth="100"
  
/>
      <TextBlock  Foreground="Black"
  Grid.Column="1" Margin="10,0"  Text="Step:" VerticalAlignment="Center" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding WaveSteps}" SelectedItem="{Binding SelectedStep}" VerticalAlignment="Center" />
    </Grid>

    <TextBlock
      Grid.Row="1"
      Margin="8,10,0,0"
      VerticalAlignment="Center"
      Foreground="Black"
      
      Text="Bandwidth:"
        Visibility ="{Binding IsEnableWave,Converter={StaticResource OtvCVT}}" />
    <ComboBox
      Grid.Row="1"
      Grid.Column="1"
      Grid.ColumnSpan="2"
      Margin="8,10,8,0"
      VerticalAlignment="Center"
      ItemsSource="{Binding Bandwidths}"
      SelectedIndex="{Binding CurBandwidthIndex}"
       Visibility ="{Binding IsEnableWave,Converter={StaticResource OtvCVT}}"/>
  </Grid>
</UserControl>
