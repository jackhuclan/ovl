<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_TrainFocusPredictionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:OMVersion="clr-namespace:Ovl.UI.Recipe"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="clr-namespace:InteVega.CBB.Prism.UI.Extensions.Converters;assembly=InteVega.CBB.Prism.UI.Extensions"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">
    <UserControl.Resources>

        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <Style x:Key="TextBlockBase" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#666" />
            </Style>
            <Style
                x:Key="TextBlockTitle"
                BasedOn="{StaticResource TextBlockBase}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="#444" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        VerticalScrollBarVisibility="Visible"
        HorizontalScrollBarVisibility="Disabled"
        CanContentScroll="False">
        <StackPanel Margin="0,0,0,12">
            <GroupBox
                Grid.ColumnSpan="2"
                Margin="3"
                hc:StatusSwitchElement.CheckedElement="true"
                Header="Focus Prediction Parameter Set"
                Style="{DynamicResource ExpandGroupBoxStyle}">

                <Grid Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Focus Prediction:" />
                    <ToggleButton
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding UseFocus}"
                        Style="{StaticResource ToggleButtonSwitch}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Focus Surface Training Method:" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="150"
                        Margin="5"
                        HorizontalAlignment="Right"
                        ItemsSource="{Binding TrainingMethod}"
                        SelectedIndex="0"
                        SelectedItem="{Binding SelectedTrainingMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Focus Surface Prediction Algorithm:" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="150"
                        Margin="5"
                        HorizontalAlignment="Right"
                        ItemsSource="{Binding PredictioAlgorithm}"
                        SelectedIndex="0"
                        SelectedItem="{Binding SelectedpredictioAlgorithm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Predicted Number Of Images:" />
                    <ComboBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="150"
                        Margin="5"
                        HorizontalAlignment="Right"
                        ItemsSource="{Binding NumberImages}"
                        SelectedIndex="0"
                        SelectedItem="{Binding SelectedprenumberImages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Minimum Predicted Score:" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Width="105"
                        Margin="5"
                        HorizontalAlignment="Right"
                        BorderThickness="1"
                        Text="{Binding MinimumScore, StringFormat=F2}" />

                    <hc:NumericUpDown
                        Grid.Row="4"
                        Grid.Column="1"
                        Width="105"
                        Margin="5"
                        HorizontalAlignment="Right"
                        BorderThickness="1"
                        DecimalPlaces="2"
                        Increment="0.1"
                        Maximum="1"
                        Minimum="0"
                        Value="{Binding MinimumScore, StringFormat=F2}" />
                </Grid>
            </GroupBox>
            <GroupBox
                Margin="3"
                hc:StatusSwitchElement.CheckedElement="True"
                Header="Focus Prediction FeildID And Target Set"
                Style="{DynamicResource ExpandGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="3"
                        Style="{DynamicResource ContainerLabelStyle}"
                        Tag="Field Selection">

                        <ContentControl Content="{Binding WaferMapControl}" />
                    </Label>
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="3"
                        Style="{DynamicResource ContainerLabelStyle}"
                        Tag="Target Selection">
                        <ContentControl
                            Margin="20,20,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="Red"
                            Content="{Binding TargetSettingControl}" />
                    </Label>
                    <Button
                        Grid.Row="1"
                        Margin="10"
                        HorizontalAlignment="Left"
                        Command="{Binding TrainFocusModelCommand}"
                        Content="Train Focus Model"
                        IsEnabled="{Binding IsTraining, Converter={StaticResource InverseBooleanConverter}}" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
