<UserControl
    x:Class="Ovl.UI.Recipe.View.OMVersion.AlignmentView_100"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Ovl.UI.Recipe.View.OMVersion"
    xmlns:localControl="clr-namespace:Ovl.UI.ViewModels.Controls;assembly=Ovl.UI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:uicommon="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel.OMVersion"
    x:Name="alignmentControl"
    d:DesignWidth="1600"
    DataContext="{prism:ContainerProvider {x:Type vm:AlignmentVm_100}}"
    Style="{x:Null}"
    mc:Ignorable="d"  IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
    <!--  Height="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}, Path=ActualHeight}"  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Control colors.  -->

            <converter:BoolToXmalWidthConvert x:Key="BoolToWidthConvert" />
            <converter:BoolToColor x:Key="BoolToColor" />
            <converter:ModelBoolToStringConvert x:Key="ModelBoolToStringConvert" />
            <Style BasedOn="{StaticResource MarvelTextBoxStyle}" TargetType="TextBox">
                <Setter Property="Margin" Value="2" />
            </Style>
            <Style BasedOn="{x:Null}" TargetType="Label" />
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Unloaded">
            <b:InvokeCommandAction Command="{Binding UnloadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftControlPanal" Width="{Binding StagePanalWidth}" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="0"
                Margin="0,0,5,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Expander
                    x:Name="StagetExpander"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    ExpandDirection="Right"
                    Header="Stage Control"
                    IsExpanded="{Binding StageExpanderState}"
                    Style="{StaticResource Expander.Small}">
                    <Border
                        Margin="3,0,3,0"
                        BorderBrush="#F2F2F2"
                        BorderThickness="1"
                        CornerRadius="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                                <stagetcontorl:StageControlCameraView
                                    CameraColorPixEnable="False"
                                    Foreground="Black"
                                    Style="{x:Null}" ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"/>
                                <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                                <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                                <stagetcontorl:StageControlMotionView Foreground="Black" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>
            <Grid
                x:Name="imgGrid"
                Grid.Column="1"
                Margin="5,0"
                IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <stagetcontorl:StageControlImageView
                    x:Name="StageControlImageView"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />
                <localControl:WaferMapStageControl
                    x:Name="wmsc"
                    MaxWidth="200"
                    MaxHeight="240"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnableMove="True"
                    Opacity="0.8" />
                <TextBlock
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>
            <Grid
                Grid.Column="2"
                Margin="5,0,0,0"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
        <Grid Grid.Row="0" VerticalAlignment="Top"  IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <RadioButton
                            x:Name="edgeSel"
                            Checked="edgeSel_Checked"
                            Content="{DynamicResource StrEdgeAlignmentEng}"
                            IsChecked="True"
                            Style="{DynamicResource RadioTableItemButtonStyle_First}" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <RadioButton
                            x:Name="finesel"
                            Content="{DynamicResource StrFineAlignmentEng}"
                            Style="{DynamicResource RadioTableItemButtonStyle}" />
                    </Grid>
          
         
                    <Border
                        Grid.ColumnSpan="2"
                        Background="Gray"
                        Opacity="0.3"
                        Visibility="{Binding IsEnableSwitchTable, Converter={StaticResource OtvReCVT}}" />
          
        </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer
                        Padding="0,0,0,20"
                        VerticalAlignment="Top"
                        HorizontalScrollBarVisibility="Auto">
                        <TabControl
                            Margin="0"
                            BorderThickness="0"
                            SelectedIndex="{Binding CoarseOrFineAlignmentSel}">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Grid>
                                                    <Border
                                                        x:Name="Border"
                                                        Background="{x:Null}"
                                                        BorderBrush="Black"
                                                        BorderThickness="0.1"
                                                        CornerRadius="0 20 20 0">
                                                        <ContentPresenter Margin="4" ContentSource="Header" />
                                                    </Border>

                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="0" />
                                                        <Setter TargetName="Border" Property="Background" Value="#0F54C6" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabItem
                                x:Name="CoarseTabitem"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                IsSelected="{Binding ElementName=edgeSel, Path=IsChecked, Mode=TwoWay}"
                                Visibility="Collapsed">
                                <local:EdgeAlignView />
                            </TabItem>
                            <TabItem
                                x:Name="FineAlignmentSel"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                IsSelected="{Binding ElementName=finesel, Path=IsChecked}"
                                Visibility="Collapsed">
                <local:FineAlignView/>
              </TabItem>
                        </TabControl>
                    </ScrollViewer>
                </Grid>
                <WrapPanel
                    Grid.Row="2"
                    Margin="20,20,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding IsEnableSwitchTable}">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=CoarseTabitem, Path=IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <Button
                            Margin="10,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ToNextStepCommand}"
                            Content="{DynamicResource StrNextToFineAlignmentEN}"
                            Style="{StaticResource MarvelLightButton}" />
                        <Button
                            Width="80"
                            Command="{Binding SaveAlignmentResultCommand}"
                            Style="{StaticResource MarvelDarkButton}">
                            Save
                        </Button>
                    </StackPanel>
                    <StackPanel Width="{Binding ElementName=CoarseTabitem, Path=IsSelected, Converter={StaticResource BoolToWidthConvert}}" Orientation="Horizontal">
                        <Button
                            Margin="10,0"
                            Command="{Binding ToLastStepCommand}"
                            Content="{DynamicResource StrBackToCoarseAlignmentEn}"
                            Style="{StaticResource MarvelLightButton}" />
                        <Button
                            Width="80"
                            Command="{Binding SaveAlignmentResultCommand}"
                            Style="{StaticResource MarvelDarkButton}">
                            Save
                        </Button>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
