<UserControl
    x:Class="Ovl.UI.Recipe.View.OMVersion.FineAlignView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Ovl.UI.ViewModels.Recipe;assembly=Ovl.UI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        Grid.Row="2"
        Margin="0,5"
        VerticalAlignment="Top">
        <StackPanel>
            <GroupBox
                Header="Go Wafer Key Point" 
                IsEnabled="{Binding IsEnableSwitchTable}"
                hc:StatusSwitchElement.CheckedElement="{Binding IsShowKeyPoint}"
                Style="{DynamicResource ExpandGroupBoxStyle}">
                <WrapPanel HorizontalAlignment="Left" IsEnabled="{Binding IsEnableClick}">
                    <Button
                        Margin="5,2"
                        VerticalAlignment="Center"
                        Command="{Binding GotoCowCommand}"
                        Content="Goto Cow" />
                    <Button
                        Margin="5,2"
                        VerticalAlignment="Center"
                        Command="{Binding GotoField0Command}"
                        Content="Goto Field0" />

                    <Button
                        Margin="5,2"
                        VerticalAlignment="Center"
                        Command="{Binding GoModelToAcsPosCommand}"
                        Content="Goto Fine Align Mark" />


                </WrapPanel>
            </GroupBox>
            <Label
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,10,0,0"
                Style="{DynamicResource ContainerLabelStyle}"
                Tag="Fine Align Model">
                <Border Margin="5" IsEnabled="{Binding IsEnableClick}">
                    <tempmachview:TemplateMatchingControl MaxWidth="420" DataContext="{Binding FineAlignTemplateViewModel}" />
                </Border>
            </Label>
            <GroupBox
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,10,0,0"
                Header="Align Field Selection"
                IsEnabled="{Binding IsEnableSwitchTable}"
                Style="{DynamicResource ExpandGroupBoxStyle}">
                <ContentControl
                    Height="300"
                    Margin="0"
                    Padding="0"
                    Content="{Binding WaferMapControlinstance}"
                    IsEnabled="{Binding IsEnableClick}" />
            </GroupBox>
            <Grid Margin="0,10">
                <StackPanel>
                    <WrapPanel>
                       
                        <Button
                 MinWidth="80"
                 Command="{Binding AlignAndTrainCommand}"
                 IsEnabled="{Binding RunFineAlignmentBtnEnable}"
                 Style="{StaticResource ButtonPrimary}"
                 Visibility="{Binding IsErrored, Converter={StaticResource OtvReCVT}}">
                            <StackPanel
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     Orientation="Horizontal">
                                    <TextBlock Text="Run" />
                                <Viewbox>
                                    <hc:LoadingCircle
                             Margin="10,0,0,0"
                             Foreground="Yellow"
                             Visibility="{Binding IsEnableClick, Converter={StaticResource OtvReCVT}}" />
                                </Viewbox>
                            </StackPanel>
                        </Button>
                        <Button
                 Width="80"
                 Command="{Binding ContinueAlignCommand}"
                 Style="{StaticResource ButtonPrimary}"
                 Visibility="{Binding IsErrored, Converter={StaticResource OtvCVT}}">
                            <TextBlock
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="Continue" />
                        </Button>
                        <Button
                 Width="80"
                 Margin="10,0,0,0"
                 Command="{Binding ExecuteAlignmentScanRangeCancelCommand}"
                 Style="{StaticResource ButtonDefault}"
                 Visibility="{Binding IsErrored, Converter={StaticResource OtvCVT}}">
                            <TextBlock
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="Cancel" />
                        </Button>
                        <Button
                 Width="80"
                 Margin="10,0,0,0"
                 Command="{Binding ExecuteAlignmentScanRangeCancelCommand}"
                 Style="{StaticResource ButtonDefault}"
                 Visibility="{Binding IsEnableClick, Converter={StaticResource OtvReCVT}}">
                            <StackPanel
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     Orientation="Horizontal">
                                <TextBlock Text="Cancel" />
                                <Viewbox>
                                    <hc:LoadingCircle
                             Margin="10,0,0,0"
                             FontWeight="Bold"
                             Foreground="Red"
                             Visibility="{Binding StopFineAlignVis}" />
                                </Viewbox>
                            </StackPanel>
                        </Button>

                        <Label VerticalAlignment="Center"  Margin="10,0" Visibility="{Binding IsEnableClick, Converter={StaticResource OtvCVT}}">Angle(°):</Label>
                        <TextBox
Width="60"
Margin="0,0,10,0"
VerticalAlignment="Center"
BorderBrush="#E6E7EA"
BorderThickness="1"
IsEnabled="False"
Text="{Binding Angle_FineAlign, StringFormat=F5}" Visibility="{Binding IsEnableClick, Converter={StaticResource OtvCVT}}"/>
                    </WrapPanel>
                   

                </StackPanel>


            </Grid>
            <Grid Margin="0,10" IsEnabled="{Binding IsEnableSwitchTable}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <!--<Label Margin="0,0,10,5" VerticalAlignment="Center">LLC Position:</Label>-->
                <StackPanel
                        Margin="0,0,0,10"
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                    <Button
                            MinWidth="80"
                            Command="{Binding UpdateLLCCommand}"
                            Content="Define LLC"
                            Style="{DynamicResource ButtonPrimary}" />
                    <Button
                            MinWidth="80" Margin="10,0"
                            Command="{Binding ToLLCCommand}"
                            Content="To LLC" />
                </StackPanel>

                <Label
                        Grid.Row="1"
                        Style="{DynamicResource ContainerLabelStyle}"
                        Tag="Wafer Grid Shift Vector - R1">
                    <WrapPanel>
                        <Label Margin="20,0">X(mm):</Label>
                        <TextBox
                                Width="70"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                BorderBrush="#E6E7EA"
                                BorderThickness="1"
                                IsEnabled="False"
                                Text="{Binding WaferInfo.R1.X, StringFormat=F6}" />
                        <Label Margin="10,0">Y(mm):</Label>
                        <TextBox
                                Width="70"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                BorderBrush="#E6E7EA"
                                BorderThickness="1"
                                IsEnabled="False"
                                Text="{Binding WaferInfo.R1.Y, StringFormat=F6}" />

                    </WrapPanel>
                </Label>

                <Label  
Grid.Row="2"
Grid.Column="0"
Margin="0,10,0,0"
Style="{DynamicResource ContainerLabelStyle}" 
Tag="Alignment Mark Position">
                    <WrapPanel>
                        <Label Margin="20,0">X(mm):</Label>
                        <TextBox
        Width="75"
        Margin="0,0,10,0"
        VerticalAlignment="Center"
        BorderBrush="#E6E7EA"
        BorderThickness="1"
        IsEnabled="False"
        Text="{Binding AlignmentMarkPos.X, StringFormat=F6}" />

                        <Label Margin="10,0">Y(mm):</Label>
                        <TextBox
        Width="70"
        Margin="0,0,10,0"
        VerticalAlignment="Center"
        BorderBrush="#E6E7EA"
        BorderThickness="1"
        IsEnabled="False"
        Text="{Binding AlignmentMarkPos.Y, StringFormat=F6}" />
                    </WrapPanel>
                </Label>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
