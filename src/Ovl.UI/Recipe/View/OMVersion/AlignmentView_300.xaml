<UserControl
    x:Class="Ovl.UI.Recipe.View.OMVersion.AlignmentView_300"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Ovl.UI.Recipe.View.OMVersion"
    xmlns:localControl="clr-namespace:Ovl.UI.ViewModels.Controls;assembly=Ovl.UI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:uicommon="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel.OMVersion"
    x:Name="alignmentControl"
    d:DesignWidth="1600"
    DataContext="{prism:ContainerProvider {x:Type vm:AlignmentVm_300}}"
    IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}"
    Style="{x:Null}"
    mc:Ignorable="d">
    <!--  Height="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}, Path=ActualHeight}"  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:BoolToXmalWidthConvert x:Key="BoolToWidthConvert" />
            <converter:BoolToColor x:Key="BoolToColor" />
            <converter:ModelBoolToStringConvert x:Key="ModelBoolToStringConvert" />
            <Style BasedOn="{StaticResource MarvelTextBoxStyle}" TargetType="TextBox">
                <Setter Property="Margin" Value="2" />
            </Style>
            <Style BasedOn="{x:Null}" TargetType="Label" />
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Unloaded">
            <b:InvokeCommandAction Command="{Binding UnloadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftControlPanal" Width="{Binding StagePanalWidth}" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="0"
                Margin="0,0,5,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Expander
                    x:Name="StagetExpander"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    ExpandDirection="Right"
                    Header="Stage Control"
                    IsExpanded="{Binding StageExpanderState}"
                    Style="{StaticResource Expander.Small}">
                    <Border
                        Margin="3,0,3,0"
                        BorderBrush="#F2F2F2"
                        BorderThickness="1"
                        CornerRadius="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                                <stagetcontorl:StageControlCameraView
                                    CameraColorPixEnable="False"
                                    Foreground="Black"
                                    ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                                    Style="{x:Null}" />
                                <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                                <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                                <stagetcontorl:StageControlMotionView Foreground="Black" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>
            <Grid
                x:Name="imgGrid"
                Grid.Column="1"
                Margin="5,0"
                IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <stagetcontorl:StageControlImageView
                    x:Name="StageControlImageView"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />
                <localControl:WaferMapStageControl
                    x:Name="wmsc"
                    MaxWidth="200"
                    MaxHeight="240"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnableMove="True"
                    Opacity="0.8" />
                <TextBlock
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>
            <Grid
                Grid.Column="2"
                Margin="5,0,0,0"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    VerticalAlignment="Top"
                    IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.ColumnSpan="3"
                        Panel.ZIndex="1"
                        Background="Gray"
                        Opacity="0.3"
                        Visibility="{Binding IsEnableSwitchTable, Converter={StaticResource OtvReCVT}}" />
                    <RadioButton
                        x:Name="edgeSel"
                        Checked="edgeSel_Checked"
                        Content="{DynamicResource StrEdgeAlignmentEng}"
                        IsChecked="True"
                        Style="{DynamicResource RadioTableItemButtonStyle_First}" />
                    <RadioButton
                        x:Name="coarsesel"
                        Grid.Column="1"
                        Content="{DynamicResource StrCoarseAlignmentEng}"
                        Style="{DynamicResource RadioTableItemButtonStyle}" />
                    <RadioButton
                        x:Name="finesel"
                        Grid.Column="2"
                        Content="{DynamicResource StrFineAlignmentEng}"
                        Style="{DynamicResource RadioTableItemButtonStyle}" />

                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer
                        Padding="0,0,0,20"
                        VerticalAlignment="Top"
                        HorizontalScrollBarVisibility="Auto">
                        <TabControl
                            Margin="0"
                            BorderThickness="0"
                            SelectedIndex="{Binding CoarseOrFineAlignmentSel}">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Grid>
                                                    <Border
                                                        x:Name="Border"
                                                        Background="{x:Null}"
                                                        BorderBrush="Black"
                                                        BorderThickness="0.1"
                                                        CornerRadius="0 20 20 0">
                                                        <ContentPresenter Margin="4" ContentSource="Header" />
                                                    </Border>

                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="0" />
                                                        <Setter TargetName="Border" Property="Background" Value="#0F54C6" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabItem
                                x:Name="CoarseTabitem"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                Header="{DynamicResource StrEdgeAlignment}"
                                IsSelected="{Binding ElementName=edgeSel, Path=IsChecked}"
                                Visibility="Collapsed">
                                <local:EdgeAlignView />

                            </TabItem>
                            <TabItem
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                IsSelected="{Binding ElementName=coarsesel, Path=IsChecked}"
                                Visibility="Collapsed">

                                <Grid
                                    Grid.Row="2"
                                    Margin="0,5"
                                    VerticalAlignment="Top">
                                    <StackPanel>
                                        <GroupBox
                                            Header="Go Wafer Key Point"
                                            IsEnabled="{Binding IsEnableSwitchTable}"
                                            Style="{DynamicResource ExpandGroupBoxStyle}">
                                            <WrapPanel HorizontalAlignment="Left" IsEnabled="{Binding IsEnableClick}">
                                                <Button
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding GotoCowCommand}"
                                                    Content="Goto Cow" />
                                                <Button
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding GotoField0Command}"
                                                    Content="Goto Field0"
                                                    Visibility="Collapsed" />
                                                <Button
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding GoModelToAcsPosCommand}"
                                                    Content="Goto Coarse Align Mark" />
                                            </WrapPanel>
                                        </GroupBox>
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,10,0,0"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag="Coarse Align Model">
                                            <Border Margin="5" IsEnabled="{Binding IsEnableClick}">
                                                <tempmachview:TemplateMatchingControl MaxWidth="420" DataContext="{Binding CoarseAlignTemplateViewModel}" />
                                            </Border>
                                        </Label>

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,10,0,0"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag="Coarse Alignment">
                                            <Grid Margin="5,10">
                                                <StackPanel>
                                                    <WrapPanel>
                                                       
                                                        <Button
                                                            MinWidth="80"
                                                            Command="{Binding CoarseAlignTrainCommand}"
                                                            IsEnabled="{Binding RunFineAlignmentBtnEnable}"
                                                            Style="{StaticResource ButtonPrimary}"
                                                            Visibility="{Binding IsErrored, Converter={StaticResource OtvReCVT}}">
                                                            <StackPanel
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock Text="Run" />
                                                                <Viewbox>
                                                                    <hc:LoadingCircle
                                                                        Margin="10,0,0,0"
                                                                        Foreground="Yellow"
                                                                        Visibility="{Binding IsEnableClick, Converter={StaticResource OtvReCVT}}" />
                                                                </Viewbox>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Width="80"
                                                            Command="{Binding ContinueAlignCommand}"
                                                            Style="{StaticResource ButtonPrimary}"
                                                            Visibility="{Binding IsErrored, Converter={StaticResource OtvCVT}}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Text="Continue" />
                                                        </Button>
                                                        <Button
                                                            Width="80"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding ExecuteAlignmentScanRangeCancelCommand}"
                                                            Style="{StaticResource ButtonDefault}"
                                                            Visibility="{Binding IsErrored, Converter={StaticResource OtvCVT}}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Text="Cancel" />
                                                        </Button>
                                                        <Button
                                                            Width="80"
                                                            Margin="10,0,0,0"
                                                            Command="{Binding ExecuteAlignmentScanRangeCancelCommand}"
                                                            Style="{StaticResource ButtonDefault}"
                                                            Visibility="{Binding IsEnableClick, Converter={StaticResource OtvReCVT}}">
                                                            <StackPanel
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock Text="Cancel" />
                                                                <Viewbox>
                                                                    <hc:LoadingCircle
                                                                        Margin="10,0,0,0"
                                                                        FontWeight="Bold"
                                                                        Foreground="Red"
                                                                        Visibility="{Binding StopFineAlignVis}" />
                                                                </Viewbox>
                                                            </StackPanel>
                                                        </Button>

                                                        <Label Margin="10,0" VerticalAlignment="Center"  Visibility="{Binding IsEnableClick, Converter={StaticResource OtvCVT}}">Angle(°):</Label>
                                                        <TextBox Width="60"
                                                                 Margin="0,0,10,0"
                                                                 VerticalAlignment="Center" 
                                                                 BorderBrush="#E6E7EA"
                                                                 BorderThickness="1"
                                                                 IsEnabled="False"
                                                                 Visibility="{Binding IsEnableClick, Converter={StaticResource OtvCVT}}"
                                                                 Text="{Binding Angle_CoarseAlign, StringFormat=F5}" />
                                                    </WrapPanel>
                                                    <Label
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Margin="0,10,0,0"
                                                        Style="{DynamicResource ContainerLabelStyle}"
                                                        Tag="Alignment Mark Position">
                                                        <WrapPanel>
                                                            <Label Margin="20,0">X(mm):</Label>
                                                            <TextBox
                                                                Width="75"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                BorderBrush="#E6E7EA"
                                                                BorderThickness="1"
                                                                IsEnabled="False"
                                                                Text="{Binding AlignmentMarkPos.X, StringFormat=F6}" />

                                                            <Label Margin="10,0">Y(mm):</Label>
                                                            <TextBox
                                                                Width="70"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                BorderBrush="#E6E7EA"
                                                                BorderThickness="1"
                                                                IsEnabled="False"
                                                                Text="{Binding AlignmentMarkPos.Y, StringFormat=F6}" />
                                                        </WrapPanel>
                                                    </Label>
                                                </StackPanel>
                                            </Grid>
                                        </Label>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem
                                x:Name="FineAlignmentSel"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                Header="{DynamicResource StrFineAlignment}"
                                IsSelected="{Binding ElementName=finesel, Path=IsChecked}"
                                Visibility="Collapsed">

                                <local:FineAlignView />
                            </TabItem>

                        </TabControl>
                    </ScrollViewer>


                </Grid>
                <WrapPanel
                    Grid.Row="2"
                    Margin="20,20,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding IsEnableSwitchTable}">
                    <Button
                        Margin="10,0"
                        Command="{Binding ToLastStepCommand}"
                        Content="{DynamicResource StrBackToCoarseAlignmentEn}"
                        IsEnabled="{Binding ElementName=CoarseTabitem, Path=IsSelected, Converter={StaticResource OtbReCVT}}"
                        Style="{StaticResource MarvelLightButton}" />
                    <Button
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        Command="{Binding ToNextStepCommand}"
                        Content="{DynamicResource StrNextToFineAlignmentEN}"
                        IsEnabled="{Binding ElementName=FineAlignmentSel, Path=IsSelected, Converter={StaticResource OtbReCVT}}"
                        Style="{StaticResource MarvelLightButton}" />


                    <Button
                        Width="80"
                        Command="{Binding SaveAlignmentResultCommand}"
                        Style="{StaticResource MarvelDarkButton}">
                        Save
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
