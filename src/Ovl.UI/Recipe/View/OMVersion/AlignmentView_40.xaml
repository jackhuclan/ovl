<UserControl
    x:Class="Ovl.UI.Recipe.View.OMVersion.AlignmentView_40"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:hp="clr-namespace:HPImageViewer;assembly=HPImageViewer"
    xmlns:local="clr-namespace:Ovl.UI.Recipe.View.OMVersion"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:uicommon="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel.OMVersion"
    x:Name="alignmentControl"
    d:DesignWidth="1600"
    DataContext="{prism:ContainerProvider {x:Type vm:AlignmentVm_40}}"
    IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}"
    Style="{x:Null}"
    Unloaded="alignmentControl_Unloaded"
    mc:Ignorable="d">
    <!--  Height="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}, Path=ActualHeight}"  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Control colors.  -->

            <converter:BoolToXmalWidthConvert x:Key="BoolToWidthConvert" />
            <converter:BoolToColor x:Key="BoolToColor" />
            <converter:ModelBoolToStringConvert x:Key="ModelBoolToStringConvert" />
            <Style BasedOn="{StaticResource MarvelTextBoxStyle}" TargetType="TextBox">
                <Setter Property="Margin" Value="2" />
            </Style>
            <Style BasedOn="{x:Null}" TargetType="Label" />
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Unloaded">
            <b:InvokeCommandAction Command="{Binding UnloadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftControlPanal" Width="{Binding StagePanalWidth}" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="0"
                Margin="0,0,5,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Expander
                    x:Name="StagetExpander"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    ExpandDirection="Right"
                    Header="Stage Control"
                    IsExpanded="{Binding StageExpanderState}"
                    Style="{StaticResource Expander.Small}">
                    <Border
                        Margin="3,0,3,0"
                        BorderBrush="#F2F2F2"
                        BorderThickness="1"
                        CornerRadius="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                                <stagetcontorl:StageControlCameraView
                                    CameraColorPixEnable="False"
                                    Foreground="Black"
                                    ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                                    Style="{x:Null}" />
                                <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                                <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                                <stagetcontorl:StageControlMotionView Foreground="Black" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>
            <Grid
                x:Name="imgGrid"
                Grid.Column="1"
                Margin="5,0"
                IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <TabControl>
                    <TabItem Header="Camera Live">
                        <Grid>
                            <stagetcontorl:StageControlImageView
                                x:Name="StageControlImageView"
                                Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch" />
                            <localControl:WaferMapStageControl
                                x:Name="wmsc"
                                MaxWidth="200"
                                MaxHeight="240"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsEnableMove="True"
                                Opacity="0.8" />
                            <TextBlock
                                Margin="0,60,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{Binding ChangeCameraInfo}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Wafer Panorama" Visibility="Collapsed">
                        <Grid>
                            <!--  全局扫描图  -->
                            <Border
                                BorderBrush="{StaticResource TitleBorderColorBrush}"
                                BorderThickness="1,1,0,0"
                                CornerRadius="3">
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Border
                                        BorderBrush="{StaticResource TitleBorderColorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3,3,0,0">
                                        <Grid>
                                            <Button
                                                Margin="10,5"
                                                HorizontalAlignment="Right"
                                                Command="{Binding AdaptCommand}"
                                                Content="Adapt" />
                                        </Grid>

                                    </Border>

                                    <Viewbox Grid.Row="1" Stretch="Uniform">

                                        <Canvas
                                            Grid.Row="1"
                                            Width="{Binding ImageWidth}"
                                            Height="{Binding ImageHeight}"
                                            PreviewMouseUp="Grid_PreviewMouseUp">
                                            <Canvas.Background>
                                                <ImageBrush ImageSource="{Binding WaferImage}" Stretch="Uniform" />
                                            </Canvas.Background>
                                            <Path
                                                x:Name="pathCross"
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Panel.ZIndex="5"
                                                Data="M0,1 2,1 M1,0 1,2"
                                                Fill="Red"
                                                Stretch="Uniform"
                                                StrokeThickness="3" />
                                        </Canvas>
                                    </Viewbox>
                                    <!--<Image Grid.Row="1"  Source="{Binding WaferImage}" Stretch="Uniform" />-->

                                    <hp:ImageViewer
                                        x:Name="hpImage"
                                        Grid.Row="1"
                                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                                        Background="AliceBlue" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            <Grid
                Grid.Column="2"
                Margin="5,0,0,0"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    VerticalAlignment="Top"
                    IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <!--<ColumnDefinition Width="*" />-->
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <RadioButton
                            x:Name="edgeSel"
                            Checked="edgeSel_Checked"
                            Content="{DynamicResource StrEdgeAlignmentEng}"
                            IsChecked="True"
                            Style="{DynamicResource RadioTableItemButtonStyle_First}" />
                    </Grid>
                    <!--<Grid Grid.Column="1" Visibility="Collapsed" >
                        <RadioButton  Visibility="Collapsed"
                            x:Name="panoramaSel"
                            Content="{DynamicResource StrScanPanoramaEng}"
                            Style="{DynamicResource RadioTableItemButtonStyle}" />
                    </Grid>-->
                    <Grid Grid.Column="1">
                        <RadioButton
                            x:Name="nofieldcoarsesel"
                            Content="{DynamicResource StrCoarseAlignmentEng}"
                            Style="{DynamicResource RadioTableItemButtonStyle}" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <RadioButton
                            x:Name="finesel"
                            Content="{DynamicResource StrFineAlignmentEng}"
                            Style="{DynamicResource RadioTableItemButtonStyle}" />
                    </Grid>


                    <Border
                        Grid.ColumnSpan="2"
                        Background="Gray"
                        Opacity="0.3"
                        Visibility="{Binding IsEnableSwitchTable, Converter={StaticResource OtvReCVT}}" />

                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer
                        Padding="0,0,0,20"
                        VerticalAlignment="Top"
                        HorizontalScrollBarVisibility="Auto">
                        <TabControl
                            Margin="0"
                            BorderThickness="0"
                            SelectedIndex="{Binding CoarseOrFineAlignmentSel}">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Grid>
                                                    <Border
                                                        x:Name="Border"
                                                        Background="{x:Null}"
                                                        BorderBrush="Black"
                                                        BorderThickness="0.1"
                                                        CornerRadius="0 20 20 0">
                                                        <ContentPresenter Margin="4" ContentSource="Header" />
                                                    </Border>

                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="0" />
                                                        <Setter TargetName="Border" Property="Background" Value="#0F54C6" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabItem
                                x:Name="CoarseTabitem"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                IsSelected="{Binding ElementName=edgeSel, Path=IsChecked, Mode=TwoWay}"
                                Visibility="Collapsed">
                                <local:EdgeAlignView />
                            </TabItem>
                            <!--<TabItem
                                x:Name="ScanPanoramaSel"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                IsSelected="{Binding ElementName=panoramaSel, Path=IsChecked}"
                                Visibility="Collapsed">
                                <StackPanel  Width="Auto" >
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="200"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Width="Auto" >Quick Operation：</Label>
                                        <Button Grid.Column="1" HorizontalAlignment="Right" Width="100">To Center</Button>
                                    </Grid>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="100"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0"    >Scan Panorama：</Label>
                                        <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MarvelDarkButton}"  Width="100" >Run</Button>
                                    </Grid>
                                </StackPanel>
                            </TabItem>-->
                            <TabItem
                                x:Name="NoFieldCoarseAlignmentSel"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                IsSelected="{Binding ElementName=nofieldcoarsesel, Path=IsChecked}"
                                Visibility="Collapsed">
                                <Grid
                                    Grid.Row="2"
                                    Margin="0,5"
                                    VerticalAlignment="Top">
                                    <StackPanel>


                                        <GroupBox Header="Go Wafer Key Point" Style="{DynamicResource ExpandGroupBoxStyle}">
                                            <WrapPanel HorizontalAlignment="Left">
                                                <Button
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding GotoCowCommand}"
                                                    Content="Goto Cow" />
                                                <Button
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding GotoAlignFirstMarkCommand}"
                                                    Content="To Alignmark1" />
                                                <Button
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding GotoAlignSecondMarkCommand}"
                                                    Content="To Alignmark2" />
                                            </WrapPanel>
                                        </GroupBox>
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,10,0,0"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag="Alignment Model">
                                            <Border Margin="5" IsEnabled="{Binding IsEnableClick}">
                                                <tempmachview:TemplateMatchingNofieldControl MaxWidth="420" DataContext="{Binding Path=.}" />
                                            </Border>
                                        </Label>
                                        <GroupBox
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,10,0,0"
                                            Header="Align Mark Selection"
                                            Style="{DynamicResource ExpandGroupBoxStyle}"
                                            Visibility="Collapsed">
                                            <ContentControl
                                                Height="300"
                                                Margin="0"
                                                Padding="0"
                                                Content="{Binding WaferMapControlinstance}" />
                                        </GroupBox>
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,10,0,0"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag=" Alignment">
                                            <Grid Margin="5,10">
                                                <StackPanel>
                                                    <WrapPanel Margin="0,5,0,5">
                                                        <Label Margin="10,0" VerticalAlignment="Center">Threshold:</Label>
                                                        <hc:NumericUpDown
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            Margin="0,0,0,0"
                                                            HorizontalAlignment="Stretch"
                                                            DecimalPlaces="3"
                                                            Increment="0.01"
                                                            Maximum="0.1"
                                                            Minimum="0.001"
                                                            Value="{Binding AngleThreshold_CoarseAlign}" />
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,5,0,5">
                                                        <Label Margin="10,0" VerticalAlignment="Center">Angle(°):</Label>
                                                        <TextBox
                                                            Width="60"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="#E6E7EA"
                                                            BorderThickness="1"
                                                            IsEnabled="False"
                                                            Text="{Binding Angle_CoarseAlign, StringFormat=F5}" />
                                                        <Button
                                                            MinWidth="80"
                                                            Command="{Binding CoarseAlignTrainCommand}"
                                                            IsEnabled="{Binding RunFineAlignmentBtnEnable}"
                                                            Style="{StaticResource ButtonPrimary}"
                                                            Visibility="{Binding IsErrored, Converter={StaticResource OtvReCVT}}">
                                                            <StackPanel
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock Text="Run" />
                                                                <Viewbox>
                                                                    <hc:LoadingCircle
                                                                        Margin="10,0,0,0"
                                                                        Foreground="Yellow"
                                                                        Visibility="{Binding IsEnableClick, Converter={StaticResource OtvReCVT}}" />
                                                                </Viewbox>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Width="80"
                                                            Command="{Binding ContinueAlignCommand}"
                                                            Style="{StaticResource ButtonPrimary}"
                                                            Visibility="{Binding IsErrored, Converter={StaticResource OtvCVT}}">
                                                            <StackPanel
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock Text="Continue" />

                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Width="80"
                                                            Margin="10,0,0,0"
                                                            Command="{Binding ExecuteAlignmentScanRangeCancelCommand}"
                                                            Style="{StaticResource ButtonDefault}"
                                                            Visibility="{Binding IsEnableClick, Converter={StaticResource OtvReCVT}}">
                                                            <StackPanel
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock Text="Cancel" />
                                                                <Viewbox>
                                                                    <hc:LoadingCircle
                                                                        Margin="10,0,0,0"
                                                                        FontWeight="Bold"
                                                                        Foreground="Red"
                                                                        Visibility="{Binding StopFineAlignVis}" />
                                                                </Viewbox>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                    <Label
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Margin="0,10,0,0"
                                                        Style="{DynamicResource ContainerLabelStyle}"
                                                        Tag="Alignment Mark Position"
                                                        Visibility="Collapsed">
                                                        <WrapPanel>
                                                            <Label Margin="20,0">X(mm):</Label>
                                                            <TextBox
                                                                Width="75"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                BorderBrush="#E6E7EA"
                                                                BorderThickness="1"
                                                                IsEnabled="False"
                                                                Text="{Binding AlignmentMarkPos.X, StringFormat=F6}" />

                                                            <Label Margin="10,0">Y(mm):</Label>
                                                            <TextBox
                                                                Width="70"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                BorderBrush="#E6E7EA"
                                                                BorderThickness="1"
                                                                IsEnabled="False"
                                                                Text="{Binding AlignmentMarkPos.Y, StringFormat=F6}" />
                                                        </WrapPanel>
                                                    </Label>
                                                </StackPanel>
                                            </Grid>
                                        </Label>

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,10,0,0"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag="Define LLC"
                                            Visibility="Collapsed">
                                            <Grid Margin="5,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Label Margin="0,0,10,5" VerticalAlignment="Center">LLC Position:</Label>
                                                <StackPanel
                                                    Margin="0,0,0,10"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        MinWidth="60"
                                                        Margin="10,0"
                                                        Command="{Binding UpdateLLCCommand}"
                                                        Content="Get"
                                                        Style="{DynamicResource ButtonPrimary}" />
                                                    <Button
                                                        MinWidth="60"
                                                        Command="{Binding ToLLCCommand}"
                                                        Content="To" />
                                                </StackPanel>
                                                <Label
                                                    Grid.Row="1"
                                                    Style="{DynamicResource ContainerLabelStyle}"
                                                    Tag="Wafer Grid Shift Vector - R1">
                                                    <WrapPanel>
                                                        <Label Margin="20,0">X(mm):</Label>
                                                        <TextBox
                                                            Width="70"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="#E6E7EA"
                                                            BorderThickness="1"
                                                            IsEnabled="False"
                                                            Text="{Binding WaferInfo.R1.X, StringFormat=F6}" />
                                                        <Label Margin="10,0">Y(mm):</Label>
                                                        <TextBox
                                                            Width="70"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="#E6E7EA"
                                                            BorderThickness="1"
                                                            IsEnabled="False"
                                                            Text="{Binding WaferInfo.R1.Y, StringFormat=F6}" />

                                                    </WrapPanel>
                                                </Label>
                                            </Grid>
                                        </Label>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <TabItem
                                x:Name="FineAlignmentSel"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                Header="{DynamicResource StrFineAlignment}"
                                IsSelected="{Binding ElementName=finesel, Path=IsChecked}"
                                Visibility="Collapsed">

                                <local:FineAlignView />
                            </TabItem>
                        </TabControl>
                    </ScrollViewer>
                </Grid>
                <WrapPanel
                    Grid.Row="2"
                    Margin="20,20,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding IsEnableSwitchTable}">
                    <Button
                        Margin="10,0"
                        Command="{Binding ToLastStepCommand}"
                        Content="{DynamicResource StrBackToCoarseAlignmentEn}"
                        IsEnabled="{Binding ElementName=CoarseTabitem, Path=IsSelected, Converter={StaticResource OtbReCVT}}"
                        Style="{StaticResource MarvelLightButton}" />
                    <Button
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        Command="{Binding ToNextStepCommand}"
                        Content="{DynamicResource StrNextToFineAlignmentEN}"
                        IsEnabled="{Binding ElementName=FineAlignmentSel, Path=IsSelected, Converter={StaticResource OtbReCVT}}"
                        Style="{StaticResource MarvelLightButton}" />

                    <Button
                        Width="80"
                        Command="{Binding SaveAlignmentResultCommand}"
                        Style="{StaticResource MarvelDarkButton}">
                        Save
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
