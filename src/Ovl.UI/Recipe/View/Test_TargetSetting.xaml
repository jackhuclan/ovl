<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_TargetSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:control="clr-namespace:Ovl.UI.ViewModels.Controls;assembly=Ovl.UI.ViewModels"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataModelenum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
    xmlns:enumhelper="clr-namespace:InteVega.CBB.ComUI.Helpers;assembly=InteVega.CBB.ComUI"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icon="clr-namespace:InteVega.CBB.Prism.UI.Extensions.Icon;assembly=InteVega.CBB.Prism.UI.Extensions"
    xmlns:ioc="http://prismlibrary.com/"
    xmlns:local="clr-namespace:Ovl.UI.ViewModels.Recipe;assembly=Ovl.UI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stageViewModels="clr-namespace:InteVega.CBB.StageControlModule.ViewModels;assembly=InteVega.CBB.StageControlModule"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:views="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:Test_TargetSettingViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{prism:ContainerProvider {x:Type vm:Test_TargetSettingViewModel}}"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1600" />
            <!--  不允许调整窗体尺寸  -->
            <Setter Property="ResizeMode" Value="NoResize" />
            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DrawingImage x:Key="downDrawingImage">
                <DrawingImage.Drawing>
                    <DrawingGroup ClipGeometry="M0,0 V1024 H1024 V0 H0 Z">
                        <GeometryDrawing Brush="#FF1296DB" Geometry="F1 M1024,1024z M0,0z M530.304,565.632L757.888,338.048A64,64,0,0,1,848.384,428.608L576.896,700.096A64,64,0,0,1,491.712,704.896A64.064,64.064,0,0,1,478.144,694.528L206.72,423.04A64,64,0,0,1,297.216,332.48L530.368,565.632z" />
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <!--  Control colors.  -->
            <Color x:Key="WindowColor">#FFE8EDF9</Color>
            <Color x:Key="ContentAreaColorLight">#FFC5CBF9</Color>
            <Color x:Key="ContentAreaColorDark">#FF7381F9</Color>

            <Color x:Key="DisabledControlLightColor">#FFE8EDF9</Color>
            <Color x:Key="DisabledControlDarkColor">#FFC5CBF9</Color>
            <Color x:Key="DisabledForegroundColor">#FF888888</Color>

            <Color x:Key="SelectedBackgroundColor">#FFC5CBF9</Color>
            <Color x:Key="SelectedUnfocusedColor">#FFDDDDDD</Color>

            <Color x:Key="ControlLightColor">White</Color>
            <Color x:Key="ControlMediumColor">GRAY</Color>
            <Color x:Key="ControlDarkColor">#FF211AA9</Color>

            <Color x:Key="ControlMouseOverColor">#FF3843C4</Color>
            <Color x:Key="ControlPressedColor">#FF211AA9</Color>


            <Color x:Key="GlyphColor">#FF444444</Color>
            <Color x:Key="GlyphMouseOver">sc#1, 0.004391443, 0.002428215, 0.242281124</Color>

            <!--  Border colors  -->
            <Color x:Key="BorderLightColor">#FFCCCCCC</Color>
            <Color x:Key="BorderMediumColor">#FF888888</Color>
            <Color x:Key="BorderDarkColor">#FF444444</Color>

            <Color x:Key="PressedBorderLightColor">#FF888888</Color>
            <Color x:Key="PressedBorderDarkColor">#FF444444</Color>

            <Color x:Key="DisabledBorderLightColor">#FFAAAAAA</Color>
            <Color x:Key="DisabledBorderDarkColor">#FF888888</Color>

            <Color x:Key="DefaultBorderBrushDarkColor">Black</Color>

            <!--  Control-specific resources.  -->
            <Color x:Key="HeaderTopColor">#FFC5CBF9</Color>
            <Color x:Key="DatagridCurrentCellBorderColor">Black</Color>
            <Color x:Key="SliderTrackDarkColor">#FFC5CBF9</Color>

            <Color x:Key="NavButtonFrameColor">#FF3843C4</Color>

            <LinearGradientBrush x:Key="MenuPopupBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="{DynamicResource ControlLightColor}" />
                <GradientStop Offset="0.5" Color="{DynamicResource ControlMediumColor}" />
                <GradientStop Offset="1" Color="{DynamicResource ControlLightColor}" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill" StartPoint="0,0" EndPoint="1,0">
                <LinearGradientBrush.GradientStops>
                    <GradientStopCollection>
                        <GradientStop Offset="0" Color="#000000FF" />
                        <GradientStop Offset="0.4" Color="#00000000" />
                        <GradientStop Offset="0.6" Color="#600000FF" />
                        <GradientStop Offset="1" Color="#000000FF" />
                    </GradientStopCollection>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
            <ControlTemplate x:Key="ToggleButtonWithTextBlockTemplate" TargetType="ContentControl">
                <UniformGrid Margin="5" Rows="1">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{DynamicResource TextBlockBaseStyle}"
                        Text="{TemplateBinding Content}" />
                    <ToggleButton
                        HorizontalAlignment="Right"
                        IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Path=Tag}"
                        Style="{StaticResource ToggleButtonSwitch}" />
                </UniformGrid>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
        <ScrollViewer VerticalScrollBarVisibility="Visible">
          <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
            <views:StageControlCameraListView/>
            <stagetcontorl:StageControlCameraView CameraColorPixEnable="False" Foreground="Black"  Style="{x:Null}" ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"/>
            <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
            <stagetcontorl:StageFocusControlView  ImageViewer="{Binding ImageViewer,ElementName=StageControlImageView}"/>
            <stagetcontorl:StageControlMotionView   Foreground="Black" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
            <Grid Grid.Column="1" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <views:StageControlImageView
                    x:Name="StageControlImageView"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    />
                <TextBlock
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>
            <StackPanel Grid.Column="2">
                <Label
                    Margin="5"
                    Style="{DynamicResource ContainerLabelStyle}"
                    Tag="Target Manual Setting">
                    <StackPanel>
                        <Label
                            Margin="5"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Target Info">
                            <UniformGrid Margin="5" Rows="1">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TextBlockBaseStyle}"
                                    Text="Target ID:" />
                                <hc:NumericUpDown
                                    Height="24"
                                    MinWidth="100"
                                    MaxWidth="550"
                                    HorizontalAlignment="Right"
                                    DecimalPlaces="0"
                                    Style="{StaticResource NumericUpDownExtend}"
                                    Value="{Binding Value}" />
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TextBlockBaseStyle}"
                                    Text="Origin Point: " />
                                <ComboBox
                                    Margin="5,2"
                                    ItemsSource="{Binding Source={enumhelper:EnumBindingSource {x:Type dataModelenum:EnumR3OrigionPoint}}}"
                                    SelectedItem="{Binding OrgionPoint, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Confirm" Style="{StaticResource ButtonPrimary}" Visibility="Hidden" />

                            </UniformGrid>
                        </Label>
                        <Label
                            Margin="5"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Target Vector - R3">
                            <UniformGrid Margin="5" Rows="1">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TextBlockBaseStyle}"
                                    Text="X (mm):" />
                                <hc:NumericUpDown
                                    Height="24"
                                    MinWidth="100"
                                    MaxWidth="550"
                                    HorizontalAlignment="Right"
                                    DecimalPlaces="0"
                                    Style="{StaticResource NumericUpDownExtend}"
                                    Value="{Binding R3Vector_X}" />
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TextBlockBaseStyle}"
                                    Text="Origin Point: " />
                                <hc:NumericUpDown
                                    Height="24"
                                    MinWidth="100"
                                    MaxWidth="550"
                                    HorizontalAlignment="Right"
                                    DecimalPlaces="0"
                                    Style="{StaticResource NumericUpDownExtend}"
                                    Value="{Binding R3Vector_Y}" />
                                <Button Content="Confirm" Style="{StaticResource ButtonPrimary}" />
                            </UniformGrid>
                        </Label>
                    </StackPanel>
                </Label>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <WrapPanel HorizontalAlignment="Right">
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SubmitCommand}"
                    Content="Submit"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding CloseCommand}"
                    Content="Close"
                    Style="{StaticResource MarvelLightButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
