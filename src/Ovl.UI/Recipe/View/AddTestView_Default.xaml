<UserControl
    x:Class="Ovl.UI.Recipe.View.AddTestView_Default"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:Ovl.UI.ViewModels.Controls;assembly=Ovl.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mtc="clr-namespace:Marvel.TargetSelectionControl.Control;assembly=Marvel.TargetSelectionControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Marvel.TargetSelectionControl;component/Control/ControlStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>

            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="gd" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition MinWidth="200" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                FontSize="12"
                Style="{DynamicResource TextBlockTitle}"
                Text="Test Name：" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Height="24"
                Margin="10"
                Text="{Binding Test.Name}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                FontSize="12"
                Style="{DynamicResource TextBlockTitle}"
                Text="Test Type："
                Visibility="{Binding IsRename, Converter={StaticResource OtvReCVT}}" />
            <ComboBox
                x:Name="cbType"
                Grid.Row="1"
                Grid.Column="1"
                Height="24"
                Margin="10"
                VerticalAlignment="Center"
                SelectionChanged="cbType_SelectionChanged"
                Visibility="{Binding IsRename, Converter={StaticResource OtvReCVT}}" />
            <ComboBox
                x:Name="cbSubType"
                Grid.Row="2"
                Grid.Column="1"
                Height="24"
                Margin="10"
                VerticalAlignment="Center"
                SelectionChanged="cbSubType_SelectionChanged"
                Visibility="{Binding IsRename, Converter={StaticResource OtvReCVT}}" />
            <mtc:ControlTestIcon
                x:Name="cti"
                Grid.RowSpan="3"
                Grid.Column="2"
                Width="80"
                Height="80"
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsRename, Converter={StaticResource OtvReCVT}}" />
        </Grid>
        <StackPanel
            Grid.Row="1"
            Margin="20,10"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                Margin="0,0,15,0"
                Command="{Binding SaveDataCommand}"
                Content="Submit" />
            <Button Command="{Binding CloseCommand}" Content="Cancel" />
        </StackPanel>
    </Grid>

</UserControl>
