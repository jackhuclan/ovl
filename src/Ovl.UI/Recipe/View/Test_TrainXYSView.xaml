<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_TrainXYSView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataModelenum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:ioc="http://prismlibrary.com/"
    xmlns:local="clr-namespace:Ovl.UI.Recipe.View"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stageViewModels="clr-namespace:InteVega.CBB.StageControlModule.ViewModels;assembly=InteVega.CBB.StageControlModule"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:uicommon="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:views="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel"
    Margin="5"
    d:DataContext="{d:DesignInstance Type=vm:Test_TrainXYSViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1600"
    DataContext="{prism:ContainerProvider {x:Type vm:Test_TrainXYSViewModel}}"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1600" />
            <Setter Property="Height" Value="700" />
            <!--  不允许调整窗体尺寸  -->
            <!--<Setter Property="ResizeMode" Value="NoResize" />-->
            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>

    </b:Interaction.Triggers>
    <Grid IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                        <Border IsEnabled="{Binding IsVisionParamEnable}">
                            <stagetcontorl:StageControlCameraView
                                CameraColorPixEnable="False"
                                Foreground="Black"
                                ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                                Style="{x:Null}" />
                        </Border>

                        <Border IsEnabled="{Binding IsVisionParamEnable}">
                            <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                        </Border>
                        <Border IsEnabled="{Binding IsFocusable}">
                            <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                        </Border>
                        <Border IsEnabled="{Binding IsAxisMoveable}">
                            <stagetcontorl:StageControlMotionView Foreground="Black" />
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="1" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <views:StageControlImageView
                    x:Name="StageControlImageView"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />
                <localControl:WaferMapStageControl
                    x:Name="wmsc"
                    MaxWidth="200"
                    MaxHeight="240"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnableMove="True"
                    Opacity="0.8" />
                <TextBlock
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>
      <Grid Grid.Column="2" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}"  Visibility="{Binding TrainSettingVisible}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="AUTO" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.ColumnSpan="3"
                        Panel.ZIndex="1"
                        Background="Gray"
                        Opacity="0.3"
                        Visibility="Collapsed" />
                    <RadioButton
                        x:Name="rbFirst"
                        Command="{Binding FirstTableCheckedCommand}"
                        Content="{Binding TableFirst}"
                        IsChecked="True"
                        Style="{DynamicResource RadioTableItemButtonStyle_First}" />
                    <RadioButton
                        x:Name="rbSecond"
                        Grid.Column="1"
                        Width="{Binding ActualWidth, ElementName=rbFirst}"
                        Command="{Binding SecondTableCheckedCommand}"
                        Content="{Binding TableSecond}"
                        IsEnabled="{Binding SetRoiVM1.IsComplete}"
                        Style="{DynamicResource RadioTableItemButtonStyle}"
                        Visibility="{Binding TableSecond, Converter={StaticResource OtvCVT}}" />
                    <RadioButton
                        x:Name="rbRun"
                        Grid.Column="2"
                        Content="Measurement"
                        IsEnabled="{Binding LastRoiVM.IsComplete}"
                        Style="{DynamicResource RadioTableItemButtonStyle}" />
                    <RadioButton
                        x:Name="rbFocusPrediction"
                        Grid.Column="3"
                         Command="{Binding FocusPredictionCheckedCommand}"
                        Content="FocusPrediction"
                        IsEnabled= "True"
                        Style="{DynamicResource RadioTableItemButtonStyle}"
                        Visibility="Hidden"/>


                </Grid>

                <ScrollViewer Grid.Row="2">
                    <Grid Grid.Row="2">
                        <local:Test_TrainSetRoiView
                            Margin="5,10,0,20"
                            DataContext="{Binding SetRoiVM1}"
                            Visibility="{Binding IsChecked, ElementName=rbFirst, Converter={StaticResource OtvCVT}}" />
                        <local:Test_TrainSetRoiView
                            Margin="5,10,0,20"
                            DataContext="{Binding SetRoiVM2}"
                            Visibility="{Binding IsChecked, ElementName=rbSecond, Converter={StaticResource OtvCVT}}" />
                        <Grid Visibility="{Binding IsChecked, ElementName=rbRun, Converter={StaticResource OtvCVT}}">

                            <StackPanel>
                                <GroupBox
                                    Margin="5,10,5,10"
                                    Header="Measurement Algorithm"
                                    Style="{DynamicResource ExpandGroupBoxStyle}">
                                    <StackPanel>


                                        <Grid Visibility="{Binding AIMAlgorithmParam, Converter={StaticResource OtvCVT}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Algorithm" />
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                ItemsSource="{Binding EnumAimAlgorithmType}"
                                                SelectedItem="{Binding AIMAlgorithmParam.AlgorithmType}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Correlation" />
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                ItemsSource="{Binding EnumCorrelationType}"
                                                SelectedItem="{Binding AIMAlgorithmParam.CorrelationType}" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Search Area" />
                                            <hc:NumericUpDown
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                DecimalPlaces="3"
                                                Minimum="0"
                                                Value="{Binding AIMAlgorithmParam.SearchArea}" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Kernel roi count" />
                                            <hc:NumericUpDown
                                                Grid.Row="2"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                DecimalPlaces="0"
                                                Minimum="0"
                                                Value="{Binding AIMAlgorithmParam.K3SSubRoiNumber}" />
                                            <Grid
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Text="QMerit Derivative Order" />
                                                <hc:NumericUpDown
                                                    Grid.Row="3"
                                                    Grid.Column="2"
                                                    Margin="5,2"
                                                    Minimum="0"
                                                    Value="{Binding AIMAlgorithmParam.QMeritDerivativeOrder}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <Grid>
                                    <GroupBox
                                        Margin="5"
                                        hc:StatusSwitchElement.CheckedElement="True"
                                        Header="Measurement Result Data"
                                        Style="{DynamicResource ExpandGroupBoxStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,5,10,5">
                                                <StackPanel
                                                    Margin="8,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding IsFocusSingle, Converter={StaticResource OtvReCVT}}">
                                                    <TextBlock
                                                        MinWidth="60"
                                                        VerticalAlignment="Center"
                                                        Text="Profile：" />
                                                    <RadioButton
                                                        MinWidth="60"
                                                        Margin="5,0"
                                                        Command="{Binding LoadProfileCommand}"
                                                        Content="{Binding ProfileFirst_Inner}"
                                                        GroupName="profileType"
                                                        IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=0, UpdateSourceTrigger=PropertyChanged}" />
                                                    <RadioButton
                                                        MinWidth="60"
                                                        Margin="5,0"
                                                        Command="{Binding LoadProfileCommand}"
                                                        Content="{Binding ProfileFirst_Outer}"
                                                        GroupName="profileType"
                                                        IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=1, UpdateSourceTrigger=PropertyChanged}" />
                                                    <RadioButton
                                                        MinWidth="60"
                                                        Margin="5,0"
                                                        Command="{Binding LoadProfileCommand}"
                                                        Content="{Binding ProfileSecond_Inner}"
                                                        GroupName="profileType"
                                                        IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=2, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding ProfileSecond_Outer, Converter={StaticResource OtvCVT}}" />
                                                    <RadioButton
                                                        MinWidth="60"
                                                        Margin="5,0"
                                                        Command="{Binding LoadProfileCommand}"
                                                        Content="{Binding ProfileSecond_Outer}"
                                                        GroupName="profileType"
                                                        IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=3, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding ProfileSecond_Outer, Converter={StaticResource OtvCVT}}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Margin="8,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding IsFocusSingle, Converter={StaticResource OtvCVT}}">
                                                    <TextBlock
                                                        MinWidth="60"
                                                        VerticalAlignment="Center"
                                                        Text="Profile：" />
                                                    <RadioButton
                                                        MinWidth="60"
                                                        Command="{Binding LoadProfileCommand}"
                                                        Content="{Binding TableFirst}"
                                                        IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=0, UpdateSourceTrigger=PropertyChanged}" />
                                                    <RadioButton
                                                        MinWidth="60"
                                                        Margin="5,0"
                                                        Command="{Binding LoadProfileCommand}"
                                                        Content="{Binding TableSecond}"
                                                        IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=1, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding TableSecond, Converter={StaticResource OtvCVT}}" />
                                                </StackPanel>
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding CorrelationCommand}"
                                                    Content="Correlation"
                                                    Visibility="Collapsed"/>
                                            </Grid>
                                            <DataGrid
                                                x:Name="dg"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="False"
                                                CanUserReorderColumns="False"
                                                ItemsSource="{Binding MeasurementResultDataList}">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="X/Y">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding Axit}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="OVLMisreg">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding OVLMisreg, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="CenterInner">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding CenterInner, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="CenterOuter">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding CenterOuter, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="QMeritTarget">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritTarget, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="QMeritInner">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritInner, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="QMeritOuter">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritOuter, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <localControl:ChartResult_ovl DataContext="{Binding CurveResultViewModel}" />
                                        </StackPanel>
                                    </GroupBox>
                                    <Button
                                        Margin="0,7,60,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Command="{Binding RunCommand}"
                                        Content="Run"
                                        Style="{StaticResource ButtonPrimary}" />

                                </Grid>

                                <local:Test_TrainTemplatesView
                                    x:Name="templatesView"
                                    ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                            </StackPanel>
                        </Grid>

                        <local:Test_TrainFocusPredictionView
                            DataContext="{Binding FocusPrediction}"
                            Margin="5,10,0,20"
                            Visibility="{Binding IsChecked, ElementName=rbFocusPrediction, Converter={StaticResource OtvCVT}}" />
                    </Grid>
                </ScrollViewer>

            </Grid>
            <StackPanel
                Grid.RowSpan="2"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:Growl.Token="TestTrainMessage" />
        </Grid>
        <Grid Grid.Row="1">
            <WrapPanel HorizontalAlignment="Right">
        <Button
Command="{Binding TestPreviewCommand}"
Content="Test Focus Prediction"
Visibility="Hidden"  />
        <Button
              Command="{Binding TestAutoTrainCommand}"
              Content="Auto Train"   
              Style="{StaticResource MarvelLightButton}"
 Visibility="{Binding IsShowAutoTrainButton,Converter={StaticResource OtvCVT}}"  />
        <Button
                    MinWidth="60"
                    Margin="10,1,10,1"
                    Command="{Binding SubmitCommand}"
                    Content="Submit"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    MinWidth="60"
                    Margin="10,1,10,1"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    MinWidth="60"
                    Margin="10,1,10,1"
                    Command="{Binding CloseViewCommand}"
                    Content="Close"
                    Style="{StaticResource MarvelLightButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
