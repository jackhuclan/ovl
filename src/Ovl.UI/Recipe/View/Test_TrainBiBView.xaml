<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_TrainBiBView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:commonModelEnum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.Commons" 
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:ioc="http://prismlibrary.com/"
    xmlns:local="clr-namespace:Ovl.UI.Recipe.View"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stageViewModels="clr-namespace:InteVega.CBB.StageControlModule.ViewModels;assembly=InteVega.CBB.StageControlModule"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:uicommon="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:views="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel"
    xmlns:alg="clr-namespace:OVL.Algorithm.DoNet;assembly=OVL.Algorithm.DoNet"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    Margin="5"
    d:DataContext="{d:DesignInstance Type=vm:Test_TrainBiBViewModel}"
    d:DesignHeight="1000"
    d:DesignWidth="1600"
    DataContext="{prism:ContainerProvider {x:Type vm:Test_TrainBiBViewModel}}"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1600" />
            <Setter Property="Height" Value="700" />
            <!--  不允许调整窗体尺寸  -->
            <!--<Setter Property="ResizeMode" Value="NoResize" />-->
            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <ObjectDataProvider
                x:Key="InsPolarityTypes"
                MethodName="GetValues"
                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="alg:InsPolarityType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>

    </b:Interaction.Triggers>

    <!--<i:Interaction.Triggers>
    <i:EventTrigger EventName="SizeChanged">
      <i:InvokeCommandAction Command="{Binding ControlSizeChangedCommand}" PassEventArgsToCommand="True" />
    </i:EventTrigger>
  </i:Interaction.Triggers>-->

    <Grid IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <ScrollViewer VerticalScrollBarVisibility="Visible">
          <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
            <!--此处使用一个Border容易来装StageControlCameraView 控件，通过Border的IsEnable属性来控制StageControlCameraView控件的可用性，否则设置绑定IsVisionParamEnable 属性不会生效，因为StageControlCameraView 的DataContext 不是TestTrainView的 ViewModel-->
            <Border  IsEnabled="{Binding  IsVisionParamEnable}">
              <stagetcontorl:StageControlCameraView
        CameraColorPixEnable="False"
        Foreground="Black"
        ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
        Style="{x:Null}" />
            </Border>
            <Border  IsEnabled="{Binding  IsVisionParamEnable}">
              <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}"   />
            </Border>
            <Border  IsEnabled="{Binding  IsFocusable}">
              <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
            </Border>
            <Border  IsEnabled="{Binding IsAxisMoveable}">
              <stagetcontorl:StageControlMotionView Foreground="Black" />
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Column="1" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <views:StageControlImageView
                    x:Name="StageControlImageView"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />
                <localControl:WaferMapStageControl
                    x:Name="wmsc"
                    MaxWidth="200"
                    MaxHeight="240"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnableMove="True"
                    Opacity="0.8" />
                <TextBlock
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="8,0" Visibility="Collapsed">
                    <Border
                        Margin="3,0,3,0"
                        Background="#0F54C6"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Label
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Location and Measurement"
                            Foreground="White"
                            Style="{x:Null}" />
                    </Border>

                </Grid>
                <!-- 必须落在 Column2 的 * 行，否则 ScrollViewer 高度随内容无限增高，滚动条不出现 -->
                <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  Tab 导航  -->
                    <UniformGrid
         Grid.Row="0"
         Margin="2,2,2,0"
         Rows="1">
                        <RadioButton
             x:Name="rbTrain"
             Content="Train"
             IsChecked="True"
             Style="{DynamicResource RadioTableItemButtonStyle_First}" />
                        <RadioButton
             x:Name="rbFocusPrediction"
             Command="{Binding FocusPredictionCheckedCommand}"
             Content="Focus Prediction"
             IsEnabled="{Binding IsFocusPredictionTabEnabled}"
             Style="{DynamicResource RadioTableItemButtonStyle}" />
                    </UniformGrid>
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Visible"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        Visibility="{Binding TrainSettingVisible}">
                        <Grid Margin="10,0,10,20">
                            <StackPanel Visibility="{Binding ElementName=LocationAndMeas, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <local:Test_TrainSetRoiView DataContext="{Binding SetRoiVM}" />
                                <StackPanel Margin="2,0">
                                    <GroupBox 
                                         Margin="0,5"
 Header="Damage Settings"
 Style="{DynamicResource ExpandGroupBoxStyle}"
                                        Visibility="{Binding IsDamageSettingsVisible,Converter={StaticResource OtvCVT}}">
                                        <Grid >
                                            <Grid.ColumnDefinitions >
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Inner Polarity" />
                                            <ComboBox
                                                Grid.Column="1"
                                                Margin="5,2"
                                                ItemsSource="{Binding Source={StaticResource InsPolarityTypes}}"
                                                SelectedItem="{Binding TrainParam.InnerLayer.PolarityType}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Outer Polarity" />
                                            <ComboBox
                                                Grid.Column="3"
                                                Margin="5,2"
                                                ItemsSource="{Binding Source={StaticResource InsPolarityTypes}}"
                                                SelectedItem="{Binding TrainParam.OuterLayer.PolarityType}" />
                                        </Grid>
                                        
                                    </GroupBox>
                                    <GroupBox
                     Margin="0,5"
                     Header="Measurement Algorithm"
                     Style="{DynamicResource ExpandGroupBoxStyle}">
                                        <StackPanel>
                                            <Grid Visibility="{Binding BibAlgorithmParam, Converter={StaticResource OtvCVT}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                 Grid.Row="0"
                                 Grid.Column="0"
                                 Margin="5,2"
                                 VerticalAlignment="Center"
                                 Text="Algorithm" />
                                                <ComboBox
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="5,2"
                                 ItemsSource="{Binding EnumBibAlgorithmType}"
                                 SelectedItem="{Binding BibAlgorithmParam.AlgorithmType}" />
                                                <TextBlock
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Margin="5,2"
                                 VerticalAlignment="Center"
                                 Text="Correlation" />
                                                <ComboBox
                                 Grid.Row="0"
                                 Grid.Column="3"
                                 Margin="5,2"
                                 ItemsSource="{Binding EnumCorrelationType}"
                                 SelectedItem="{Binding BibAlgorithmParam.CorrelationType}" />

                                                <TextBlock
                                 Grid.Row="2"
                                 Grid.Column="0"
                                 Margin="5,2"
                                 VerticalAlignment="Center"
                                 Text="Inner Search Area" />
                                                <hc:NumericUpDown
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="5,2"
                                 DecimalPlaces="3"
                                 Minimum="0"
                                 Value="{Binding BibAlgorithmParam.InnerSearchArea}" />
                                                <TextBlock
                                 Grid.Row="2"
                                 Grid.Column="2"
                                 Margin="5,2"
                                 VerticalAlignment="Center"
                                 Text="Outer Search Area" />
                                                <hc:NumericUpDown
                                 Grid.Row="2"
                                 Grid.Column="3"
                                 Margin="5,2"
                                 DecimalPlaces="3"
                                 Minimum="0"
                                 Value="{Binding BibAlgorithmParam.OuterSearchArea}" />
                                                <Grid Grid.Row="3" Grid.ColumnSpan="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                     Grid.Row="3"
                                     Grid.Column="0"
                                     Margin="5,2"
                                     VerticalAlignment="Center"
                                     Text="QMerit Derivative Order" />
                                                    <hc:NumericUpDown
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Margin="5,2"
                                     Minimum="0"
                                     Value="{Binding BibAlgorithmParam.QMeritDerivativeOrder}" />
                                                </Grid>

                                                <TextBlock
                                 Grid.Row="3"
                                 Grid.Column="2"
                                 Margin="5,2"
                                 VerticalAlignment="Center"
                                 Text="ProfileCrop" />
                                                <CheckBox
                                 Grid.Row="3"
                                 Grid.Column="3"
                                 Margin="5,2"
                                 IsChecked="{Binding BibAlgorithmParam.IsProfileCrop}"
                                 Style="{StaticResource ToggleButtonSwitch}" />
                                            </Grid>

                                            <Grid Visibility="{Binding AIMAlgorithmParam, Converter={StaticResource OtvCVT}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                 Grid.Row="0"
                                 Grid.Column="0"
                                 Margin="5,2"
                                 VerticalAlignment="Center"
                                 Text="Algorithm" />
                                                <ComboBox
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="5,2"
                                 ItemsSource="{Binding EnumAimAlgorithmType}"
                                 SelectedItem="{Binding AIMAlgorithmParam.AlgorithmType}" />
                                                <TextBlock
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Margin="5,2"
                                 VerticalAlignment="Center"
                                 Text="Correlation" />
                                                <ComboBox
                                 Grid.Row="0"
                                 Grid.Column="3"
                                 Margin="5,2"
                                 ItemsSource="{Binding EnumCorrelationType}"
                                 SelectedItem="{Binding AIMAlgorithmParam.CorrelationType}" />

                                                <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Search Area" />
                                                <hc:NumericUpDown
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                DecimalPlaces="3"
                                                Minimum="0"
                                                Value="{Binding AIMAlgorithmParam.SearchArea}" />
                                                <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Kernel roi count" />
                                                <hc:NumericUpDown
                                                Grid.Row="2"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                DecimalPlaces="0"
                                                Minimum="0"
                                                Value="{Binding AIMAlgorithmParam.K3SSubRoiNumber}" />
                                                <Grid
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Text="QMerit Derivative Order" />
                                                    <hc:NumericUpDown
                                                    Grid.Row="3"
                                                    Grid.Column="2"
                                                    Margin="5,2"
                                                    Minimum="0"
                                                    Value="{Binding AIMAlgorithmParam.QMeritDerivativeOrder}" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <Grid>
                                        <GroupBox
                                        Margin="0,5"
                                        Header="Measurement Result Data"
                                        Style="{DynamicResource ExpandGroupBoxStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,5,10,5">
                                                    <StackPanel
                                                    Margin="8,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding IsFocusSingle, Converter={StaticResource OtvReCVT}}">
                                                        <TextBlock
                                                        Width="60"
                                                        VerticalAlignment="Center"
                                                        Text="Profile：" />
                                                        <RadioButton
                                                        Width="60"
                                                        Command="{Binding RunCommand}"
                                                        Content="Inner"
                                                        GroupName="profileType"
                                                        IsChecked="{Binding SelectedLayer, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static commonModelEnum:EnumFocusBasedOn.Inner}, UpdateSourceTrigger=PropertyChanged}" />
                                                        <RadioButton
                                                        Width="60"
                                                        Command="{Binding RunCommand}"
                                                        Content="Outer"
                                                        GroupName="profileType"
                                                        IsChecked="{Binding SelectedLayer, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static commonModelEnum:EnumFocusBasedOn.Outer}, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <Button
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding CorrelationCommand}"
                                                    Content="Correlation"
                                                    Visibility="Collapsed"/>
                                                </Grid>
                                                <DataGrid
                                                x:Name="dg"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="False"
                                                CanUserReorderColumns="False"
                                                ItemsSource="{Binding MeasurementResultDataList}">
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="X/Y">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding Axit}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="OVLMisreg">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding OVLMisreg, StringFormat=0.####}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="CenterInner">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding CenterInner, StringFormat=0.####}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="CenterOuter">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding CenterOuter, StringFormat=0.####}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="QMeritTarget">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritTarget, StringFormat=0.####}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="QMeritInner">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritInner, StringFormat=0.####}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="QMeritOuter">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritOuter, StringFormat=0.####}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <localControl:ChartResult_ovl DataContext="{Binding CurveResultViewModel}" />
                                            </StackPanel>
                                        </GroupBox>
                                        <Button
                                        Margin="0,7,60,0"  
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Command="{Binding RunCommand}"
                                        Content="Run"
                                        Style="{StaticResource ButtonPrimary}" />

                                    </Grid>
                                    <local:Test_TrainTemplatesView
    x:Name="templatesView"
    ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <local:Test_TrainFocusPredictionView
     Grid.Row="1"
     VerticalAlignment="Stretch"
     DataContext="{Binding FocusPrediction}"
     Visibility="{Binding IsChecked, ElementName=rbFocusPrediction, Converter={StaticResource OtvCVT}}" />
                </Grid>
               
            </Grid>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:Growl.Token="TestTrainMessage" />
        </Grid>
        <Grid Grid.Row="1">
            <WrapPanel HorizontalAlignment="Right">
        <Button
      Command="{Binding TestPreviewCommand}"
      Content="Test Preview "
      Visibility="Collapsed"  />
        <Button
                    Command="{Binding TestAutoTrainCommand}"
                    Content="Auto Train"    Style="{StaticResource MarvelLightButton}"
                    Visibility="{Binding IsShowAutoTrainButton,Converter={StaticResource OtvCVT}}"  />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SubmitCommand}"
                    Content="Submit"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding CloseViewCommand}"
                    Content="Close"
                    Style="{StaticResource MarvelLightButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>

