<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_SetR3"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:comControl="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:control="clr-namespace:Ovl.UI.Controls"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataModelenum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
    xmlns:enumhelper="clr-namespace:InteVega.CBB.ComUI.Helpers;assembly=InteVega.CBB.ComUI"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icon="clr-namespace:InteVega.CBB.Prism.UI.Extensions.Icon;assembly=InteVega.CBB.Prism.UI.Extensions"
    xmlns:ioc="http://prismlibrary.com/"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stageViewModels="clr-namespace:InteVega.CBB.StageControlModule.ViewModels;assembly=InteVega.CBB.StageControlModule"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:views="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:Test_TargetSettingViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1500" />

            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
            </ResourceDictionary.MergedDictionaries>




        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                        <views:StageControlCameraListView />
                        <stagetcontorl:StageControlCameraView
                            CameraColorPixEnable="False"
                            Foreground="Black"
                            ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                            Style="{x:Null}" />
                        <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                        <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                        <stagetcontorl:StageControlMotionView Foreground="Black" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="1" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <views:StageControlImageView
                    x:Name="StageControlImageView"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />
                <localControl:WaferMapStageControl
                    x:Name="wmsc"
                    MaxWidth="200"
                    MaxHeight="240"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnableMove="True"
                    Opacity="0.8" />
                <TextBlock
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DataGrid
                    x:Name="targetinfos"
                    Grid.Row="2"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderThickness="0,0"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="True"
                    CanUserSortColumns="False"
                    CellStyle="{DynamicResource TargetDataGridCellStyle}"
                    ItemsSource="{Binding TestInfo.TargetSetting.TargetPoints2}"
                    LoadingRow="targetinfos_LoadingRow"
                    MouseRightButtonDown="targetinfos_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonDown="targetinfos_PreviewMouseLeftButtonDown"
                    RowHeight="40"
                    RowStyle="{DynamicResource TargetListDataGridRowStyle}"
                    SelectedItem="{Binding SelectTarget}"
                    SelectionMode="Single"
                    Style="{DynamicResource DataGrid.Small}"
                    VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="30"
                            Header=""
                            IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <comControl:CtlAutoNo
                                            Margin="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AncestorType="{x:Type DataGrid}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Origin Point" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding Source={enumhelper:EnumBindingSource {x:Type dataModelenum:EnumR3OrigionPoint}}}"
                                        SelectedItem="{Binding OrgionPoint, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="X(mm)">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!--<TextBox Text="{Binding R3Vector.X, UpdateSourceTrigger=PropertyChanged}" Width="100"></TextBox>-->

                                    <hc:NumericUpDown
                                        Height="24"
                                        Margin="0,0,0,0"
                                        DecimalPlaces="6"
                                        Style="{StaticResource NumericUpDownExtend}"
                                        Value="{Binding R3Vector.X, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Y(mm)">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:NumericUpDown
                                        Height="24"
                                        Margin="0,0,0,0"
                                        DecimalPlaces="6"
                                        Style="{StaticResource NumericUpDownExtend}"
                                        Value="{Binding R3Vector.Y, UpdateSourceTrigger=PropertyChanged}" />
                                    <!--<TextBox Text="{Binding R3Vector.Y, UpdateSourceTrigger=PropertyChanged}" Width="100"></TextBox>-->
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>



                        <DataGridTemplateColumn Header="Get" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Button
                                            Width="50"
                                            Margin="5,2"
                                            Padding="4"
                                            Click="btnGetR3_Click"
                                            Command="{Binding GetR3Command}"
                                            Content="Get" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="To" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Button
                                            Width="50"
                                            Margin="5,2"
                                            Padding="4"
                                            Click="btnGoto_Click"
                                            Command="{Binding GotoCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            Content="To" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>


                </DataGrid>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Visibility="Collapsed">
            <WrapPanel HorizontalAlignment="Right">
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SubmitCommand}"
                    Content="Submit"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding CloseCommand}"
                    Content="Close"
                    Style="{StaticResource MarvelLightButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
