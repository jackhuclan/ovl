<UserControl
    x:Class="Ovl.UI.Recipe.View.CorrectionValueSettingDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:Ovl.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    d:DesignHeight="450"
    d:DesignWidth="860"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1400" />
            <Setter Property="Height" Value="770" />

            <!--  不允许调整窗体尺寸  -->
            <!--<Setter Property="ResizeMode" Value="NoResize" />-->
            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="Manual" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width=".85*" />
        </Grid.ColumnDefinitions>
        <Grid Margin="5,5,0,5">
            <views:StageControlImageView
                x:Name="StageControlImageView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>
        <Grid
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Chart  -->
            <control:ChartCurveControl
                x:Name="CorrectionChart"
                Grid.Row="0"
                Margin="5,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                FixedMarkerAxisXPosition="{Binding FinalFousHeight}"
                FixedVerticalLinePosition="{Binding FocusPosition}"
                PointHighlightThreshold="{Binding HightLightThreshHold}"
                XAxisLabel="Focus Position"
                YAxisLabel="Sharpness">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="HighLightPointSelected">
                        <prism:InvokeCommandAction Command="{Binding PointSelectedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </control:ChartCurveControl>
            <UniformGrid
                Grid.Row="1"
                Margin="5,5"
                HorizontalAlignment="Stretch"
                Columns="2"
                Rows="1">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{Binding Unit, StringFormat='AutoFocus Position({0}):'}" />
                <Border
                    Padding="5,0,0,0"
                    HorizontalAlignment="Right"
                    BorderBrush="Green"
                    BorderThickness="2"
                    CornerRadius="3">
                    <TextBlock
                        Width="90"
                        HorizontalAlignment="Right"
                        FontSize="16"
                        Foreground="Green"
                        Text="{Binding FocusPosition, Mode=TwoWay, StringFormat={}{0:F4}}" />
                </Border>
            </UniformGrid>
            <UniformGrid
                Grid.Row="2"
                Margin="5,5"
                Rows="1">
                <TextBlock
                    HorizontalAlignment="Left"
                    FontSize="16"
                    Text="{Binding Unit, StringFormat='Correction Focus Position({0}):'}" />
                <hc:NumericUpDown
                    Width="100"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    DecimalPlaces="4"
                    FontSize="16"
                    Increment="0.001"
                    Maximum="20"
                    Minimum="-20"
                    Value="{Binding CorrectionValue, Mode=TwoWay, StringFormat={}{0:F4}}" />
            </UniformGrid>
            <StackPanel
                Grid.Row="3"
                Margin="10,5"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="60"
                    Margin="20,0"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    FontSize="15"
                    Style="{StaticResource ResourceKey=ButtonPrimary}" />
                <Button
                    Command="{Binding ResetCommand}"
                    Content="Default"
                    FontSize="15" />
                <Button
                    Margin="15,0,0,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    FontSize="15" />
            </StackPanel>
        </Grid>

    </Grid>

</UserControl>
