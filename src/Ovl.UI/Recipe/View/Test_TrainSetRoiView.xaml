<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_TrainSetRoiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:Ovl.UI.ViewModels.Recipe;assembly=Ovl.UI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="800"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>

        <ResourceDictionary>
            <system:Boolean x:Key="True">True</system:Boolean>
            <system:Boolean x:Key="False">False</system:Boolean>
            <Style x:Key="TextBlockBase" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#666" />
            </Style>
            <Style
                x:Key="TextBlockTitle"
                BasedOn="{StaticResource TextBlockBase}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="#444" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel>

            <GroupBox
                Grid.ColumnSpan="2"
                Margin="3"
                hc:StatusSwitchElement.CheckedElement="false"
                Header="The imaging settings are same as the X direction"
                Style="{DynamicResource ExpandGroupBoxStyle}"
                Visibility="{Binding SameParamsVisible}">

                <Grid Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="NA:" />
                    <ToggleButton
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="5"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding IsSameNA}"
                        Style="{StaticResource ToggleButtonSwitch}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Color Filter:" />
                    <ToggleButton
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding IsSameFilter}"
                        Style="{StaticResource ToggleButtonSwitch}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Polarizer:" />
                    <ToggleButton
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding IsSamePolarizer}"
                        Style="{StaticResource ToggleButtonSwitch}" />

                </Grid>
            </GroupBox>
            <GroupBox
                Margin="3"
                hc:StatusSwitchElement.CheckedElement="True"
                Header="Focus"
                Style="{DynamicResource ExpandGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <GroupBox
                            Margin="3"
                            Header="Focus on temporary ROI"
                            hc:StatusSwitchElement.CheckedElement="{Binding IsShowTempRoi}"
                            Style="{DynamicResource ExpandGroupBoxStyle}">
                            <Grid HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                               
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,10"
                                    Orientation="Horizontal">
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="5,0,10,0" Width="50"
                                        VerticalAlignment="Center"
                                        Style="{x:Null}">
                                        Inner:
                                    </Label>
                                    <Button
                                        Width="75"
                                        Margin="5,0,0,0"
                                        Command="{Binding InnerFocusROI_SetCommand}"
                                        IsEnabled="{Binding FocusROI_SetEnabled, Converter={StaticResource OtbCVT}}"
                                        Style="{StaticResource ButtonDefault}">
                                        Set
                                    </Button>
                                    <Button
                                        x:Name="btnConfirmInner"
                                        Width="75"
                                        Margin="5,0,0,0"
                                        Command="{Binding InnerFocusROI_ConfirmCommand}"
                                        IsEnabled="{Binding FocusROI_InnerEnabled, Converter={StaticResource OtbCVT}}"
                                        Style="{StaticResource ButtonDefault}">
                                        Confirm
                                    </Button>
                                    <Button
                                        Width="75"
                                        Margin="5,0,5,0"
                                        Command="{Binding FocusROI_CancelCommand}"
                                        IsEnabled="{Binding FocusROI_InnerEnabled, Converter={StaticResource OtbCVT}}"
                                        Style="{StaticResource ButtonDefault}">
                                        Cancel
                                    </Button>
                                </StackPanel>

                                <StackPanel
     Grid.Row="1"
     Grid.Column="1"
     Margin="0,10" 
     Orientation="Horizontal">
                                    <Label
         Grid.Row="1"
         Grid.Column="0"
         Margin="5,0,10,0" Width="50"
         VerticalAlignment="Center"
         Style="{x:Null}">
                                        Outer:
                                    </Label>
                                    <Button
         Width="75"
         Margin="5,0,0,0"
         Command="{Binding OuterFocusROI_SetCommand}"
         IsEnabled="{Binding FocusROI_SetEnabled, Converter={StaticResource OtbCVT}}"
         Style="{StaticResource ButtonDefault}">
                                        Set
                                    </Button>
                                    <Button
         x:Name="btnConfirmOuter"
         Width="75"
         Margin="5,0,0,0"
         Command="{Binding OuterFocusROI_ConfirmCommand}"
         IsEnabled="{Binding FocusROI_OuterEnabled, Converter={StaticResource OtbCVT}}"
         Style="{StaticResource ButtonDefault}">
                                        Confirm
                                    </Button>
                                    <Button
         Width="75"
         Margin="5,0,5,0"
         Command="{Binding FocusROI_CancelCommand}"
         IsEnabled="{Binding FocusROI_OuterEnabled, Converter={StaticResource OtbCVT}}"
         Style="{StaticResource ButtonDefault}">
                                        Cancel
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </GroupBox>


                        <GroupBox
                            Grid.Row="1"
                            Margin="3"
                            Header="Focus_Outer"
                            Style="{DynamicResource ExpandGroupBoxStyle}" Visibility="Collapsed" >
                            <Grid HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <!--<local:CPLParamView
                                    Grid.Row="1"
                                    Margin="0,0,0,10"
                                    DataContext="{Binding CplParamViewModel_Outer}"
                                    IsEnabled="{Binding IsEnabled, ElementName=btnConfirmOuter}" />-->
                               
                            </Grid>
                        </GroupBox>


                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="10,5">
                        <Button
                            MinWidth="100"
                            Margin="0,0,10,0"
                            Command="{Binding FocusSettingCommand}"
                            Content="Setting"
                            Style="{StaticResource ButtonDefault}" />
                        <Button
                            MinWidth="100"
                            Command="{Binding TrainFocus_SingleCommand}"
                            Style="{StaticResource ButtonPrimary}">
                            Train Focus
                        </Button>

                    </WrapPanel>

                    <!--  Inner Fine Focus Position (Z+Pzt-Z) Double 显示Recover，Run功能  -->
                    <Grid Grid.Row="2">
                        <Label
                            Margin="10,5"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Focus Positon (Z + Zpzt)"
                            Visibility="{Binding IsFocusSingle, Converter={StaticResource OtvReCVT}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="10,3"
                                    VerticalAlignment="Center"
                                    Content="WLI Focus Position (mm):"
                                    Style="{x:Null}"
                                    Visibility="{Binding WliVisible}" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    MinWidth="50"
                                    Margin="0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Text="{Binding AbsolateWliHeight, StringFormat=0.####}"
                                    Visibility="{Binding WliVisible}" />
                                <Label
                                    Grid.Row="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{x:Null}">
                                    Inner:
                                </Label>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{x:Null}">
                                    Z (mm):
                                </Label>
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    MinWidth="50"
                                    Margin="0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Text="{Binding InnerFocusHeight, StringFormat=0.####}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{x:Null}">
                                    Pzt (μm):
                                </Label>
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    MinWidth="50"
                                    Margin="10,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Text="{Binding InnerPztOffset, StringFormat=0.###}" />

                                <Label
                                    Grid.Row="2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{x:Null}">
                                    Outer:
                                </Label>
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{x:Null}">
                                    Z (mm):
                                </Label>
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    MinWidth="50"
                                    Margin="0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Text="{Binding OuterFocusHeight, StringFormat=0.####}" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{x:Null}">
                                    Pzt (μm):
                                </Label>
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="4"
                                    MinWidth="50"
                                    Margin="10,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Text="{Binding OuterPztOffset, StringFormat=0.###}" />
                            </Grid>
                        </Label>
                        <Label
                            Margin="10,5"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Focus Positon"
                            Visibility="{Binding IsFocusSingle, Converter={StaticResource OtvCVT}}">
                            <Grid
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="10,3"
                                    VerticalAlignment="Center"
                                    Content="WLI Focus Position (mm):"
                                    Style="{x:Null}"
                                    Visibility="{Binding WliVisible}" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    MinWidth="50"
                                    Margin="0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Text="{Binding AbsolateWliHeight, StringFormat=0.####}"
                                    Visibility="{Binding WliVisible}" />
                                <Label
                                    Grid.Row="1"
                                    Margin="10,3"
                                    VerticalAlignment="Center"
                                    Style="{x:Null}">
                                    Single Grab Focus Position (mm):
                                </Label>
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    MinWidth="50"
                                    Margin="0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Text="{Binding AutoFocusHeight, StringFormat=0.####}" />
                            </Grid>
                        </Label>
                    </Grid>
                </Grid>
            </GroupBox>
            <GroupBox
                x:Name="measureroi"
                Margin="3,5"
                hc:StatusSwitchElement.CheckedElement="{Binding IsShowMeasureRoi}"
                Header="Measurement ROI"
                Style="{DynamicResource ExpandGroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{x:Null}">
                        Inner:
                    </Label>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5,5,5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="75"
                            Margin="5,0,0,0"
                            Command="{Binding InnerMeasureRoi_SetCommand}"
                            IsEnabled="{Binding MeasurementROI_SetEnabled}"
                            Style="{StaticResource ButtonPrimary}"
                            Visibility="{Binding MeasurementROI_InnerEnabled, Converter={StaticResource OtvReCVT}}">
                            Set ROI
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding MeasurementROI_InnerEnabled, Converter={StaticResource OtvCVT}}">
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding InnerMeasureRoi_ConfirmCommand}"
                                Style="{StaticResource ButtonPrimary}">
                                Confirm
                            </Button>
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding MeasureRoi_CancelCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Cancel
                            </Button>

                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding InnerMeasureRoi_ReSetCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Reset
                            </Button>
                        </StackPanel>

                    </StackPanel>

                    <Label
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{x:Null}">
                        Outer:
                    </Label>
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,5,5,5"
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding MeasurementROIEnabled, Converter={StaticResource OtbReCVT}}"
                        Orientation="Horizontal">
                        <CheckBox
                            Width="150"
                            Margin="5,0,0,0"
                            Visibility="{Binding CrossUseBib, Converter={StaticResource OtvReCVT}}" IsChecked="{Binding UseCross4rectan}" >
                            Use NewCross
                        </CheckBox>
                        <Button
                            Width="75"
                            Margin="5,0,0,0"
                            Command="{Binding OuterMeasureRoi_SetCommand}"
                            IsEnabled="{Binding MeasurementROI_SetEnabled}"
                            Style="{StaticResource ButtonPrimary}"
                            Visibility="{Binding MeasurementROI_OuterEnabled, Converter={StaticResource OtvReCVT}}">
                            Set ROI
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding MeasurementROI_OuterEnabled, Converter={StaticResource OtvCVT}}">
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding OuterMeasureRoi_ConfirmCommand}"
                                Style="{StaticResource ButtonPrimary}">
                                Confirm
                            </Button>
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding MeasureRoi_CancelCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Cancel
                            </Button>

                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding OuterMeasureRoi_ReSetCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Reset
                            </Button>
                        </StackPanel>

                    </StackPanel>

                   
                </Grid>
            </GroupBox>

            <GroupBox
                Margin="3,5"
                Header="Auto Focus Correction"
                Style="{DynamicResource ExpandGroupBoxStyle}"
                Visibility="{Binding CorrectionVisibility}">
                <StackPanel>
                    <UniformGrid
                        Margin="5,5"
                        IsEnabled="True"
                        Rows="1"
                        Visibility="{Binding InnerCorrectionVisibility}">
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Inner:" />
                        <TextBlock VerticalAlignment="Center" Text="Pzt Height(μm):" />
                        <TextBox
                            Width="60"
                            IsEnabled="False"
                            Text="{Binding InnerCorrectionHeight, Mode=OneWay, StringFormat=0.####}" />
                        <TextBlock VerticalAlignment="Center" Text="Correction(μm):" />
                        <TextBox
                            Width="60"
                            IsEnabled="False"
                            Text="{Binding InnerCorrectionValue, Mode=OneWay, StringFormat=0.####}" />
                        <Button
                            Width="75"
                            HorizontalAlignment="Right"
                            Command="{Binding ShowCorrectionValueSettingViewCommand}"
                            CommandParameter="{StaticResource True}"
                            Content="Set"
                            Style="{StaticResource ButtonPrimary}" />
                    </UniformGrid>
                    <UniformGrid
                        Margin="5,5"
                        IsEnabled="{Binding IsOuterCorrectionEnabled}"
                        Rows="1"
                        Visibility="{Binding OuterCorrectionVisibility}">
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Outer:" />
                        <TextBlock VerticalAlignment="Center" Text="Pzt Height(μm):" />
                        <TextBox
                            Width="60"
                            IsEnabled="False"
                            Text="{Binding OuterCorrectionHeight, Mode=OneWay, StringFormat=0.####}" />
                        <TextBlock VerticalAlignment="Center" Text="Correction(μm):" />
                        <TextBox
                            Width="60"
                            IsEnabled="False"
                            Text="{Binding OuterCorrectionValue, Mode=OneWay, StringFormat=0.####}" />
                        <Button
                            Width="75"
                            HorizontalAlignment="Right"
                            Command="{Binding ShowCorrectionValueSettingViewCommand}"
                            CommandParameter="{StaticResource False}"
                            Content="Set"
                            Style="{StaticResource ButtonPrimary}" />
                    </UniformGrid>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </Grid>
</UserControl>
