<Window
    x:Class="Ovl.UI.Recipe.View.RecipeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:RecipeViewModel="clr-namespace:Ovl.UI.Recipe.ViewModel"
    xmlns:convert="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extension="clr-namespace:InteVega.CBB.Prism.UI.Extensions;assembly=InteVega.CBB.Prism.UI.Extensions"
    xmlns:handy="https://handyorg.github.io/handycontrol"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Ovl.UI.ViewModels.Recipe;assembly=Ovl.UI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:recipe="clr-namespace:InteVega.CBB.Recipe.Ui.View;assembly=InteVega.CBB.Recipe.Ui"
    Title="RecipeWindow"
    Width="1600"
    Height="850"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    Closed="Window_Closed"
    DataContext="{prism:ContainerProvider {x:Type RecipeViewModel:RecipeWindowViewModel}}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Stop}" Executed="EscCommand" />
    </Window.CommandBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToStringConverter x:Key="BoolToStringConverter" />
            <Style x:Key="BorderRecipeTabItem" TargetType="Border">
                <Setter Property="CornerRadius" Value="5,5,0,0" />
                <Setter Property="Background" Value="#fff" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="ButtonRecipeTabItem" TargetType="Button">
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style x:Key="TextBlockTableItem" TargetType="TextBlock">
                <Setter Property="Margin" Value="16,5,16,5" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="#444" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid IsEnabled="{Binding IsLocalOperationAllowed}">
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Width}" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <recipe:RecipeMenu
            Grid.Row="0"
            Grid.Column="0"
            Margin="5,5,0,5"
            DataContext="{Binding RecipeMenuViewModel}" />
        <Border Grid.Row="0" Grid.Column="1">
            <Image
                x:Name="imgMenuStrip"
                Height="50"
                Cursor="Hand"
                Source="{Binding ImgSouce}"
                Stretch="Fill"
                Tag="关闭">
                <handy:Interaction.Triggers>
                    <handy:EventTrigger EventName="MouseDown">
                        <handy:InvokeCommandAction Command="{Binding MouseDownCommand}" />
                    </handy:EventTrigger>
                </handy:Interaction.Triggers>
            </Image>
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="2"
            Margin="0,5,5,5"
            BorderBrush="#eee"
            BorderThickness="1">
            <Grid Background="#ccc">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="2"
                    hc:Growl.Token="RecipeMessage" />
                <TabControl
                    x:Name="TbContent"
                    Grid.Row="1"
                    Panel.ZIndex="1"
                    BorderThickness="0"
                    ItemsSource="{Binding TabItemView}"
                    SelectedIndex="{Binding SelectIndex}"
                    Visibility="{Binding IsShowContent}">
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Content}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
                <Border
                    Margin="-1"
                    BorderBrush="#D5E0E6"
                    BorderThickness="1"
                    CornerRadius="2,2,0,0" />
                <Grid
                    Grid.Row="0"
                    Panel.ZIndex="1"
                    Background="#D5E0E6">
                    <TextBlock
                        Margin="16,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Black"
                        Text="{Binding RecipeName}" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding TabItemDataList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding DataContext.OpenTabItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding Id}"
                                        Style="{DynamicResource ButtonRecipeTabItem}">
                                        <Border Background="{Binding IsSelect, Converter={StaticResource BoolToStringConverter}, ConverterParameter=#fff;#60ffffff}" Style="{DynamicResource BorderRecipeTabItem}">
                                            <TextBlock Style="{DynamicResource TextBlockTableItem}" Text="{Binding Name}" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="76"
                    Foreground="#a1a1a1"
                    Text="Please select a recipe"
                    Visibility="{Binding IsShowContent, Converter={StaticResource OtvReCVT}}" />
            </Grid>
        </Border>

    </Grid>
</Window>
