<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_Train_CD_View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataCore="clr-namespace:Marvel.DataModels.Core;assembly=Marvel.DataModels"
    xmlns:dataModelenum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:param="clr-namespace:Ovl.UI.Recipe.View"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:uicommon="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:views="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel"
    Margin="5"
    d:DataContext="{d:DesignInstance Type=vm:Test_TrainCDViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1600"
    DataContext="{prism:ContainerProvider {x:Type vm:Test_TrainCDViewModel}}"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1600" />
            <Setter Property="Height" Value="700" />
            <!--  不允许调整窗体尺寸  -->
            <!--<Setter Property="ResizeMode" Value="NoResize" />-->
            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <!--  隐藏标题栏  -->
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Marvel.ComModule;component/Style/CardPropertyGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

            <LinearGradientBrush x:Key="MenuPopupBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="{DynamicResource ControlLightColor}" />
                <GradientStop Offset="0.5" Color="{DynamicResource ControlMediumColor}" />
                <GradientStop Offset="1" Color="{DynamicResource ControlLightColor}" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill" StartPoint="0,0" EndPoint="1,0">
                <LinearGradientBrush.GradientStops>
                    <GradientStopCollection>
                        <GradientStop Offset="0" Color="#000000FF" />
                        <GradientStop Offset="0.4" Color="#00000000" />
                        <GradientStop Offset="0.6" Color="#600000FF" />
                        <GradientStop Offset="1" Color="#000000FF" />
                    </GradientStopCollection>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                        <stagetcontorl:StageControlCameraView
                            Foreground="Black"
                            ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                            Style="{x:Null}" />
                        <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                        <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                        <stagetcontorl:StageControlMotionView Foreground="Black" Style="{x:Null}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="1" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <views:StageControlImageView
                    x:Name="StageControlImageView"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />
                <localControl:WaferMapStageControl
                    x:Name="wmsc"
                    MaxWidth="200"
                    MaxHeight="240"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnableMove="True"
                    Opacity="0.8" />
                <TextBlock
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Border
                        Margin="3,0,3,0"
                        Background="#0F54C6"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Label
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Location and Measurement"
                            Foreground="White"
                            Style="{x:Null}" />
                    </Border>

                </Grid>
                <StackPanel
                    Grid.Row="1"
                    Margin="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsAcrossTheCameraVision, Converter={StaticResource OtvCVT}}">
                    <RadioButton
                        x:Name="Vision_1"
                        Width="160"
                        Margin="2,0,0,0"
                        Command="{Binding OpenVisionCommand}"
                        CommandParameter="0"
                        Content="①Vision_1"
                        IsChecked="True"
                        IsEnabled="True"
                        Style="{DynamicResource RadioTableItemButtonStyle_First}" />
                    <RadioButton
                        x:Name="Vision_2"
                        Grid.Column="1"
                        Width="160"
                        Command="{Binding OpenVisionCommand}"
                        CommandParameter="1"
                        Content="②Vision_2"
                        IsEnabled="True"
                        Style="{DynamicResource RadioTableItemButtonStyle}" />
                    <RadioButton
                        x:Name="Measurement"
                        Grid.Column="1"
                        Width="160"
                        Command="{Binding OpenMeasurementCommand}"
                        CommandParameter="1"
                        Content="Measurement Run"
                        IsEnabled="True"
                        Style="{DynamicResource RadioTableItemButtonStyle}" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <param:Test_Train_CD_Param_View
                            x:Name="paramView1"
                            DataContext="{Binding TrainParam1}"
                            Visibility="{Binding ElementName=Vision_1, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <param:Test_Train_CD_Param_View
                            x:Name="paramView2"
                            DataContext="{Binding TrainParam2}"
                            Visibility="{Binding ElementName=Vision_2, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}" />

                        <Label
                            Grid.Row="3"
                            Margin="5"
                            Style="{DynamicResource ContainerLabelStyle}"
                            Tag="Measurement"
                            Visibility="{Binding IsShowMeasurement, Converter={StaticResource OtvCVT}}">
                            <StackPanel>
                                <Grid>
                                    <ContentControl
                                        DataContext="{Binding PropertyAlgoViewModels}"
                                        Tag="Measurement Algorithm"
                                        Template="{StaticResource PropertyClassCardTemplate}" />
                                </Grid>
                                <Label
                                    Margin="5"
                                    Style="{DynamicResource ContainerLabelStyle}"
                                    Tag="Measure Result">
                                    <StackPanel>
                                        <!--  Visibility="{Binding IsAcrossTheCameraVision, Converter={StaticResource OtvReCVT}}"  -->
                                        <StackPanel
                                            Margin="8,-25,180,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Visibility="{Binding IsAcrossTheCameraVision, Converter={StaticResource OtvCVT}}">
                                            <RadioButton
                                                Width="70"
                                                Command="{Binding RunCommand}"
                                                Content="Vision1"
                                                GroupName="profileType"
                                                IsChecked="{Binding Vision, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:EnumVision.Vision1}, UpdateSourceTrigger=PropertyChanged}" />
                                            <RadioButton
                                                Width="70"
                                                Command="{Binding RunCommand}"
                                                Content="Vision2"
                                                GroupName="profileType"
                                                IsChecked="{Binding Vision, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static dataModelenum:EnumVision.Vision2}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button
                                            Margin="0,-30,120,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Command="{Binding RunCommand}"
                                            Content="Run"
                                            IsEnabled="{Binding MeasurementROIEnabled, Converter={StaticResource OtbReCVT}}"
                                            Style="{StaticResource ButtonPrimary}" />
                                        <Button
                                            MinWidth="100"
                                            Margin="0,-30,5,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Command="{Binding CorrelationCommand}"
                                            Content="Correlation"
                                            Style="{StaticResource ButtonPrimary}" />


                                        <DataGrid
                                            x:Name="dgCDMultiRoi"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            AutoGenerateColumns="False"
                                            Background="Transparent"
                                            BorderThickness="0,0"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            CanUserReorderColumns="False"
                                            CanUserResizeRows="True"
                                            CanUserSortColumns="False"
                                            CellStyle="{DynamicResource TargetDataGridCellStyle}"
                                            ItemsSource="{Binding MultiRoiList}"
                                            RowHeight="40"
                                            RowStyle="{DynamicResource TargetListDataGridRowStyle}"
                                            SelectionMode="Single"
                                            Style="{DynamicResource DataGrid.Small}"
                                            VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="ID" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Label
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Content="{Binding Id}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="150" Header="CD Name">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Label
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Content="{Binding Name}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Binding="{Binding Value, StringFormat=F3}" Header="CD Value(um)" />
                                                <DataGridTemplateColumn Width="200" Header="Selecting the vision edges">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                                <Button
                                                                    Width="60"
                                                                    Command="{Binding DataContext.SetEdgeROIMultiRoiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Select"
                                                                    Style="{StaticResource MarvelDarkButton}"
                                                                    Visibility="{Binding IsSetEdgeROI, Converter={StaticResource OtvReCVT}}" />
                                                                <Button
                                                                    Width="70"
                                                                    Margin="5,0,0,0"
                                                                    Command="{Binding DataContext.ConfirmMultiEdgeRoiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Confirm"
                                                                    Visibility="{Binding IsSetEdgeROI, Converter={StaticResource OtvCVT}}" />
                                                                <Button
                                                                    Width="60"
                                                                    Margin="5,0,0,0"
                                                                    Command="{Binding DataContext.CancelMultiEdgeRoiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Cancel"
                                                                    Visibility="{Binding IsSetEdgeROI, Converter={StaticResource OtvCVT}}" />
                                                                <Button
                                                                    Width="60"
                                                                    Margin="5,0,0,0"
                                                                    Command="{Binding DataContext.ResetMultiEdgeRoiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Reset"
                                                                    Visibility="{Binding IsSetEdgeROI, Converter={StaticResource OtvCVT}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>


                                    </StackPanel>
                                </Label>
                            </StackPanel>
                        </Label>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:Growl.Token="TestTrainCDMessage" />
        </Grid>

        <Grid Grid.Row="1">
            <WrapPanel HorizontalAlignment="Right">
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SubmitCommand}"
                    Content="Submit"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding CloseViewCommand}"
                    Content="Close"
                    Style="{StaticResource MarvelLightButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
