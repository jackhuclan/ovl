<UserControl x:Class="Ovl.UI.Recipe.View.Test_Train40_CD_Param_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"             
             xmlns:local="clr-namespace:Ovl.UI.ViewModels.Recipe;assembly=Ovl.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Marvel.ComModule;component/Style/CardPropertyGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="MenuPopupBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="{DynamicResource ControlLightColor}" />
                <GradientStop Offset="0.5" Color="{DynamicResource ControlMediumColor}" />
                <GradientStop Offset="1" Color="{DynamicResource ControlLightColor}" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill" StartPoint="0,0" EndPoint="1,0">
                <LinearGradientBrush.GradientStops>
                    <GradientStopCollection>
                        <GradientStop Offset="0" Color="#000000FF" />
                        <GradientStop Offset="0.4" Color="#00000000" />
                        <GradientStop Offset="0.6" Color="#600000FF" />
                        <GradientStop Offset="1" Color="#000000FF" />
                    </GradientStopCollection>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <Grid>
                <StackPanel
                                    Margin="0,8,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    Orientation="Horizontal">
                    <Button
                                        MinWidth="100"
                                        Margin="0,0,10,0"
                                        Command="{Binding TrainFocusCommand}"
                                        Content="Run"
                                        IsEnabled="{Binding FocusROI_SetEnabled}"
                                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                                        MinWidth="100"
                                        Command="{Binding FocusSettingCDCommand}"
                                        Content="Setting"
                                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
                <!--  Focus Setting  -->
                <Label
                                    Margin="5"
                                    Style="{DynamicResource ContainerLabelStyle}"
                                    Tag="Focus Setting">
                    <StackPanel Orientation="Vertical">
                        <!--  Focus Position Viewer  -->
                        <Label
                                            Margin="5"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag="Focus Position">
                            <Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="10,3"
                                                        VerticalAlignment="Center"
                                                        Content="WLI Focus Position (mm):"
                                                        Style="{x:Null}"
                                                        Visibility="{Binding WliVisible}" />
                                    <hc:NumericUpDown
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="0,5"
                                                        HorizontalAlignment="Center"
                                                        DecimalPlaces="6"
                                                        IsEnabled="False"
                                                        Visibility="{Binding WliVisible}" Width="100"
                                                        Value="{Binding AbsolateWliHeight, StringFormat=0.####}" />
                                    <Label
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Margin="10,3"
                                                        VerticalAlignment="Center" 
                                                        Content="Fine Focus Position (mm):"
                                                        Style="{x:Null}" />
                                    <hc:NumericUpDown
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Margin="0,5"
                                                        HorizontalAlignment="Center"
                                                        DecimalPlaces="6"
                                                        IsEnabled="False" Width="100"
                                                        Value="{Binding AutoFocusHeight, StringFormat=0.####}" />
                                    <Label
                                                        Grid.Row="2"
                                                        Margin="10,3" 
                                                        VerticalAlignment="Center"
                                                        Style="{x:Null}">
                                        Z Position (mm):
                                    </Label>
                                    <hc:NumericUpDown
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Margin="0,5"
                                                        HorizontalAlignment="Center"
                                                        DecimalPlaces="6"
                                                        IsEnabled="False" Width="100"
                                                        Value="{Binding FocusZHeight, StringFormat=0.####}" />
                                    <Label
                                                        Grid.Row="3"
                                                        Grid.Column="0"
                                                        Margin="10,3"
                                                        VerticalAlignment="Center"
                                                        Content="Pzt Position (μm):"
                                                        Style="{x:Null}" />
                                    <hc:NumericUpDown
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Margin="0,5"
                                                        HorizontalAlignment="Center"
                                                        DecimalPlaces="3" Width="100"
                                                        IsEnabled="False"
                                                        Value="{Binding FocusPztOffset, StringFormat=0.####}" />
                                </Grid>
                            </Grid>
                        </Label>

                        <!--  Focus ROI  -->
                        <Label
                                            Margin="5"
                                            Style="{DynamicResource ContainerLabelStyle}"
                                            Tag="Focus ROI">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <!--<RowDefinition Height="40"></RowDefinition>-->
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Content="ROI:"
                                                    Style="{x:Null}" />

                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding FocusROI_SetCommand}"
                                                        Content="Set"
                                                        IsEnabled="{Binding FocusROI_SetEnabled, Converter={StaticResource OtbCVT}}"
                                                        Style="{StaticResource ButtonDefault}" />

                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding FocusROI_ConfirmCommand}"
                                                        Content="Confirm"
                                                        IsEnabled="{Binding FocusROI_ConfirmEnabled, Converter={StaticResource OtbCVT}}"
                                                        Style="{StaticResource ButtonDefault}" />

                                    <Button
                                                        Width="75"
                                                        Margin="5,0,5,0"
                                                        Command="{Binding FocusROI_CancelCommand}"
                                                        Content="Cancel"
                                                        IsEnabled="{Binding FocusROI_CancelEnabled, Converter={StaticResource OtbCVT}}"
                                                        Style="{StaticResource ButtonDefault}" />

                                </StackPanel>

                                <!--<StackPanel Grid.Row="1" Grid.Column="1">
                                    <Button Command="{Binding SavePointCommand}" Content="SavePoint"></Button>
                                    <Button Command="{Binding MovePointCommand}" Content="MovePoint"></Button>
                                </StackPanel>-->
                            </Grid>
                        </Label>
                        <!--Focus Algorithm Parameters-->
                        <!--<Label Margin="5"
                                             Style="{DynamicResource ContainerLabelStyle}"
                                             Tag="Focus Algorithm Parameters">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3.5*"></ColumnDefinition>
                                    <ColumnDefinition Width="3*"></ColumnDefinition>
                                    <ColumnDefinition Width="2.5*"></ColumnDefinition>
                                    <ColumnDefinition Width="3*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0"
                                                     Grid.Column="0"
                                                     Margin="10,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Content="Sharpness Method："
                                                     Style="{x:Null}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="10,0,10,0" SelectedItem="{Binding TrainSetting_CD.SharpnessMethod,Mode=TwoWay}" ItemsSource="{Binding ModelMethodTypes}" VerticalAlignment="Center"></ComboBox>
                                <Label Grid.Row="0"
                                                     Grid.Column="2"
                                                     Margin="10,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Content="Feature Type:"
                                                     Style="{x:Null}" />
                                <ComboBox Grid.Row="0" Grid.Column="3" Margin="10,0,10,0" SelectedItem="{Binding TrainSetting_CD.FeatureType,Mode=TwoWay}" ItemsSource="{Binding FeatureTypes}" VerticalAlignment="Center"></ComboBox>
                            </Grid>
                        </Label>-->
                    </StackPanel>
                </Label>

            </Grid>
            <Label Margin="5" Style="{DynamicResource ContainerLabelStyle}" Tag="Mark Model">
                <tempmachview:TemplateMatchingControl DataContext="{Binding MultiTemplateMatchingViewModel}" Name="test" />
            </Label>
            <Label Margin="5" Style="{DynamicResource ContainerLabelStyle}" Tag="Measurement ROI">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Visibility="{Binding IsShowSelectROI, Converter={StaticResource OtvCVT}}" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{x:Null}"  Visibility="{Binding IsShowSelectROI, Converter={StaticResource OtvCVT}}">Select Roi 1：</Label>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="10,0,10,0" Width="100" SelectedItem="{Binding TrainSetting_CD.DsROIType1,Mode=TwoWay}" ItemsSource="{Binding ROITypeList}" VerticalAlignment="Center"></ComboBox>
                        <Label Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{x:Null}"  Visibility="{Binding IsAcrossTheCameraVision, Converter={StaticResource OtvReCVT}}">Select Roi 2：</Label>
                        <ComboBox Grid.Row="0" Grid.Column="3" Margin="10,0,10,0" Width="100" SelectedItem="{Binding TrainSetting_CD.DsROIType2,Mode=TwoWay}"  Visibility="{Binding IsAcrossTheCameraVision, Converter={StaticResource OtvReCVT}}" ItemsSource="{Binding ROITypeList}" VerticalAlignment="Center"></ComboBox>
                    </Grid>

                    <Label Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{x:Null}" Margin="15,0,0,0">
                        Vision:
                    </Label>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5,5,5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="75"
                            Margin="5,0,0,0"
                            Command="{Binding MeasureRoi_SetCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            IsEnabled="{Binding MeasurementROI_SetEnabled}"
                            Visibility="{Binding MeasurementROI_Enabled, Converter={StaticResource OtvReCVT}}"
                            >
                            Set ROI
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding MeasurementROI_Enabled, Converter={StaticResource OtvCVT}}">
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding MeasureRoi_ConfirmCommand}"
                                Style="{StaticResource ButtonPrimary}">
                                Confirm
                            </Button>
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding MeasureRoi_CancelCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Cancel
                            </Button>
                            <Button
                                Width="75"
                                Margin="5,0,0,0"
                                Command="{Binding MeasureRoi_ReSetCommand}"
                                Style="{StaticResource ButtonDefault}">
                                Reset
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Label>
        </StackPanel>
    </Grid>
</UserControl>
