<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_Train40ViewModel_CrossFovView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:commonModelEnum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.Commons"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataCore="clr-namespace:Marvel.DataModels.Core;assembly=Marvel.DataModels"
    xmlns:dataModelenum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:param="clr-namespace:Ovl.UI.Recipe"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:uicommon="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:views="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel"
    Margin="5"
    d:DataContext="{d:DesignInstance Type=vm:Test_Train40ViewModel_CrossFov}"
    d:DesignHeight="700"
    d:DesignWidth="1600"
    DataContext="{prism:ContainerProvider {x:Type vm:Test_Train40ViewModel_CrossFov}}"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1600" />
            <Setter Property="Height" Value="700" />
            <!--  不允许调整窗体尺寸  -->
            <!--<Setter Property="ResizeMode" Value="NoResize" />-->
            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <!--  隐藏标题栏  -->
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Label.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Marvel.ComModule;component/Style/CardPropertyGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <converter:IntegerToBooleanConverter x:Key="IntToBoolConverter" />
            <LinearGradientBrush x:Key="MenuPopupBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="{DynamicResource ControlLightColor}" />
                <GradientStop Offset="0.5" Color="{DynamicResource ControlMediumColor}" />
                <GradientStop Offset="1" Color="{DynamicResource ControlLightColor}" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill" StartPoint="0,0" EndPoint="1,0">
                <LinearGradientBrush.GradientStops>
                    <GradientStopCollection>
                        <GradientStop Offset="0" Color="#000000FF" />
                        <GradientStop Offset="0.4" Color="#00000000" />
                        <GradientStop Offset="0.6" Color="#600000FF" />
                        <GradientStop Offset="1" Color="#000000FF" />
                    </GradientStopCollection>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
            <system:Boolean x:Key="True">True</system:Boolean>
            <system:Boolean x:Key="False">False</system:Boolean>
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                        <stagetcontorl:StageControlCameraView
                            Foreground="Black"
                            ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                            Style="{x:Null}" />
                        <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                        <stagetcontorl:StageFocusControlView ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}" />
                        <stagetcontorl:StageControlMotionView Foreground="Black" Style="{x:Null}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="1" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                <views:StageControlImageView
                    x:Name="StageControlImageView"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />
                <localControl:WaferMapStageControl
                    x:Name="wmsc"
                    MaxWidth="200"
                    MaxHeight="240"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnableMove="True"
                    Opacity="0.8" />
                <TextBlock
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="{Binding ChangeCameraInfo}" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Border
                        Margin="3,0,3,0"
                        Background="#0F54C6"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Label
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Location and Measurement"
                            Foreground="White"
                            Style="{x:Null}" />
                    </Border>

                </Grid>
                <StackPanel
                    Grid.Row="1"
                    Margin="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsAcrossTheCameraVision, Converter={StaticResource OtvCVT}}">
                    <RadioButton
                        x:Name="Vision_1"
                        Width="160"
                        Margin="2,0,0,0"
                        Command="{Binding OpenVisionCommand}"
                        CommandParameter="0"
                        Content="①Vision1(Inner)"
                        IsChecked="True"
                        IsEnabled="True"
                        Style="{DynamicResource RadioTableItemButtonStyle_First}" />
                    <RadioButton
                        x:Name="Vision_2"
                        Grid.Column="1"
                        Width="160"
                        Command="{Binding OpenVisionCommand}"
                        CommandParameter="1"
                        Content="②Vision2(Outer)"
                        IsEnabled="True"
                        Style="{DynamicResource RadioTableItemButtonStyle}" />
                    <RadioButton
                        x:Name="Measurement"
                        Grid.Column="1"
                        Width="160"
                        Command="{Binding OpenMeasurementCommand}"
                        CommandParameter="1"
                        Content="③Measurement Run"
                        IsEnabled="True"
                        Style="{DynamicResource RadioTableItemButtonStyle}" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  Optical Module  -->
                        <GroupBox
                            Margin="0,5,5,0"
                            Header="Optical Module"
                            Style="{DynamicResource ExpandGroupBoxStyle}"
                            Visibility="{Binding IsShowMeasurement, Converter={StaticResource OtvReCVT}}">
                            <Grid Margin="10,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="5" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Up 列  -->
                                <RadioButton
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{Binding SelectedOpticalClickCommand}"
                                    Content="Up"
                                    GroupName="OpticalModule"
                                    IsChecked="{Binding SelectedOpticalModuleIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0, Mode=TwoWay}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding UpCameraMode, StringFormat='Camera Mode: {0}'}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding UpIntensity, StringFormat='Intensity: {0}'}" />

                                <!--  Down 列  -->
                                <RadioButton
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{Binding SelectedOpticalClickCommand}"
                                    Content="Down"
                                    GroupName="OpticalModule"
                                    IsChecked="{Binding SelectedOpticalModuleIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1, Mode=TwoWay}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding DownCameraMode, StringFormat='Camera Mode: {0}'}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding DownIntensity, StringFormat='Intensity: {0}'}" />
                            </Grid>
                        </GroupBox>

                        <!--  FocusROIPanel  -->
                        <GroupBox
                            Margin="3"
                            Header="Focus"
                            Style="{DynamicResource ExpandGroupBoxStyle}"
                            Visibility="{Binding IsShowMeasurement, Converter={StaticResource OtvReCVT}}">
                            <StackPanel>

                                <GroupBox
                                    Margin="5,5"
                                    hc:ToggleButtonAttach.ShowLabel="True"
                                    Header="Focus ROI"
                                    Style="{DynamicResource ExpandGroupBoxStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,5,0,5"
                                            VerticalAlignment="Center"
                                            Style="{x:Null}"
                                            Visibility="{Binding CrossFovUiInnerTrainVisible, Converter={StaticResource BoolToCollapsedCvt}}">
                                            Inner:
                                        </Label>
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,5,0,5"
                                            Orientation="Horizontal"
                                            Visibility="{Binding CrossFovUiInnerTrainVisible, Converter={StaticResource BoolToCollapsedCvt}}">
                                            <Button
                                                Width="75"
                                                Command="{Binding InnerFocusROI_SetCommand}"
                                                Content="Set"
                                                IsEnabled="{Binding FocusROI_SetEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}" />
                                            <Button
                                                Width="75"
                                                Margin="5,0,0,0"
                                                Command="{Binding InnerFocusROI_ConfirmCommand}"
                                                Content="Confirm"
                                                IsEnabled="{Binding FocusROI_InnerEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}" />
                                            <Button
                                                Width="75"
                                                Margin="5,0,5,0"
                                                Command="{Binding FocusROI_CancelCommand}"
                                                Content="Cancel"
                                                IsEnabled="{Binding FocusROI_InnerEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}" />
                                        </StackPanel>
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="10,5,0,5"
                                            VerticalAlignment="Center"
                                            Style="{x:Null}"
                                            Visibility="{Binding CrossFovUiOuterTrainVisible, Converter={StaticResource BoolToCollapsedCvt}}">
                                            Outer:
                                        </Label>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,5,0,5"
                                            Orientation="Horizontal"
                                            Visibility="{Binding CrossFovUiOuterTrainVisible, Converter={StaticResource BoolToCollapsedCvt}}">
                                            <Button
                                                Width="75"
                                                Command="{Binding OuterFocusROI_SetCommand}"
                                                IsEnabled="{Binding FocusROI_SetEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Set
                                            </Button>
                                            <Button
                                                Width="75"
                                                Margin="5,0,0,0"
                                                Command="{Binding OuterFocusROI_ConfirmCommand}"
                                                IsEnabled="{Binding FocusROI_OuterEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Confirm
                                            </Button>
                                            <Button
                                                Width="75"
                                                Margin="5,0,5,0"
                                                Command="{Binding FocusROI_CancelCommand}"
                                                IsEnabled="{Binding FocusROI_OuterEnabled, Converter={StaticResource OtbCVT}}"
                                                Style="{StaticResource ButtonDefault}">
                                                Cancel
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <WrapPanel Margin="10,5">
                                    <Button
                                        MinWidth="100"
                                        Margin="0,0,10,0"
                                        Command="{Binding FocusSettingCommand}"
                                        Content="Setting"
                                        Style="{StaticResource ButtonDefault}" />
                                    <Button
                                        MinWidth="100"
                                        Command="{Binding TrainFocus_SingleCommand}"
                                        Content="Run"
                                        Style="{StaticResource ButtonPrimary}" />

                                </WrapPanel>

                                <!--  Inner Fine Focus Position Double 显示Recover，Run功能  -->
                                <Grid>
                                    <GroupBox
                                        Margin="5,5"
                                        Header="Focus Positon"
                                        Style="{DynamicResource ExpandGroupBoxStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}"
                                                Visibility="{Binding CrossFovUiInnerTrainVisible, Converter={StaticResource OtvCVT}}">
                                                Inner:
                                            </Label>
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}"
                                                Visibility="{Binding CrossFovUiInnerTrainVisible, Converter={StaticResource OtvCVT}}">
                                                Z (mm):
                                            </Label>
                                            <TextBox
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                MinWidth="50"
                                                Margin="0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                IsEnabled="False"
                                                Text="{Binding InnerFocusHeight, StringFormat=0.####}"
                                                Visibility="{Binding CrossFovUiInnerTrainVisible, Converter={StaticResource OtvCVT}}" />
                                            <Label
                                                Grid.Row="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}"
                                                Visibility="{Binding CrossFovUiOuterTrainVisible, Converter={StaticResource OtvCVT}}">
                                                Outer:
                                            </Label>
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}"
                                                Visibility="{Binding CrossFovUiOuterTrainVisible, Converter={StaticResource OtvCVT}}">
                                                Z (mm):
                                            </Label>
                                            <TextBox
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                MinWidth="50"
                                                Margin="0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                IsEnabled="False"
                                                Text="{Binding OuterFocusHeight, StringFormat=0.####}"
                                                Visibility="{Binding CrossFovUiOuterTrainVisible, Converter={StaticResource OtvCVT}}" />
                                        </Grid>
                                    </GroupBox>
                                </Grid>

                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Margin="3"
                            Header="Measurement"
                            Style="{DynamicResource ExpandGroupBoxStyle}"
                            Visibility="{Binding IsShowMeasurement, Converter={StaticResource OtvReCVT}}">
                            <StackPanel>

                                <!--  Measurement ROI Panel  -->
                                <Grid>

                                    <Label
                                        x:Name="measureroi"
                                        Margin="10,5"
                                        Style="{DynamicResource ContainerLabelStyle}"
                                        Tag="Measurement ROI"
                                        Visibility="{Binding IsShowMeasurement, Converter={StaticResource OtvReCVT}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}"
                                                Visibility="Collapsed">
                                                Search Area:
                                            </Label>
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="0,5,5,5"
                                                HorizontalAlignment="Right"
                                                IsEnabled="{Binding SearchROI_SetEnabled, Converter={StaticResource OtvCVT}}"
                                                Orientation="Horizontal"
                                                Visibility="Collapsed">
                                                <Button
                                                    Width="75"
                                                    Margin="5,0,0,0"
                                                    Command="{Binding SearchRoi_SetCommand}"
                                                    IsEnabled="{Binding SearchROI_SetEnabled}"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Visibility="{Binding SearchROI_SetEnabled, Converter={StaticResource OtvCVT}}">
                                                    Set ROI
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding SearchROI_SetEnabled, Converter={StaticResource OtvReCVT}}">
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding SearchRoi_ConfirmCommand}"
                                                        Style="{StaticResource ButtonPrimary}">
                                                        Confirm
                                                    </Button>
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding SearchRoi_CancelCommand}"
                                                        Style="{StaticResource ButtonDefault}">
                                                        Cancel
                                                    </Button>
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding SearchRoi_ClearCommand}"
                                                        Style="{StaticResource ButtonDefault}">
                                                        Clear
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                            <Label
                                                Grid.Row="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}"
                                                Visibility="{Binding CrossFovUiInnerTrainVisible, Converter={StaticResource OtvCVT}}">
                                                Inner:
                                            </Label>
                                            <!--  CD OVL：L 型方向；仅 IsCdOvlAlgorithm 为 true 时显示。  -->
                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="0,5,5,5"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Visibility="{Binding CrossFovUiInnerTrainVisible, Converter={StaticResource OtvCVT}}">
                                                <ComboBox
                                                    x:Name="LRectangMode"
                                                    Margin="10,0,0,0"
                                                    ItemsSource="{Binding DirectionList}"
                                                    SelectedItem="{Binding CurrentDirection, UpdateSourceTrigger=PropertyChanged}"
                                                    Visibility="{Binding IsCdOvlAlgorithm, Converter={StaticResource OtvCVT}}" />

                                                <Button
                                                    Width="75"
                                                    Margin="5,0,0,0"
                                                    Command="{Binding InnerMeasureRoi_SetCommand}"
                                                    IsEnabled="{Binding MeasurementROI_SetEnabled}"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Visibility="{Binding MeasurementROI_InnerEnabled, Converter={StaticResource OtvReCVT}}">
                                                    Set ROI
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding MeasurementROI_InnerEnabled, Converter={StaticResource OtvCVT}}">
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding CrossFovInnerMeasureRoi_ConfirmCommand}"
                                                        Style="{StaticResource ButtonPrimary}">
                                                        Confirm
                                                    </Button>
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding MeasureRoi_CancelCommand}"
                                                        Style="{StaticResource ButtonDefault}">
                                                        Cancel
                                                    </Button>

                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding InnerMeasureRoi_ReSetCommand}"
                                                        Style="{StaticResource ButtonDefault}">
                                                        Reset
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                            <Label
                                                Grid.Row="2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Style="{x:Null}"
                                                Visibility="{Binding CrossFovUiOuterTrainVisible, Converter={StaticResource OtvCVT}}">
                                                Outer:
                                            </Label>
                                            <StackPanel
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="0,5,5,5"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Visibility="{Binding CrossFovUiOuterTrainVisible, Converter={StaticResource OtvCVT}}">
                                                <CheckBox
                                                    Width="150"
                                                    Margin="5,0,0,0"
                                                    IsChecked="{Binding UseCross4rectan}"
                                                    Visibility="{Binding CrossUseBib, Converter={StaticResource OtvReCVT}}">
                                                    Use NewCross
                                                </CheckBox>
                                                <Button
                                                    Width="75"
                                                    Margin="5,0,0,0"
                                                    Command="{Binding OuterMeasureRoi_SetCommand}"
                                                    IsEnabled="{Binding MeasurementROI_SetEnabled}"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Visibility="{Binding MeasurementROI_OuterEnabled, Converter={StaticResource OtvReCVT}}">
                                                    Set ROI
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding MeasurementROI_OuterEnabled, Converter={StaticResource OtvCVT}}">
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding CrossFovOuterMeasureRoi_ConfirmCommand}"
                                                        Style="{StaticResource ButtonPrimary}">
                                                        Confirm
                                                    </Button>
                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding MeasureRoi_CancelCommand}"
                                                        Style="{StaticResource ButtonDefault}">
                                                        Cancel
                                                    </Button>

                                                    <Button
                                                        Width="75"
                                                        Margin="5,0,0,0"
                                                        Command="{Binding OuterMeasureRoi_ReSetCommand}"
                                                        Style="{StaticResource ButtonDefault}">
                                                        Reset
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Label>
                                </Grid>

                                <!--  Positioning Model  -->
                                <GroupBox
                                    Margin="10,5"
                                    Header="Inner Positioning Model"
                                    Style="{DynamicResource ExpandGroupBoxStyle}"
                                    Visibility="{Binding InnerPositioningSectionVisible, Converter={StaticResource OtvCVT}}">
                                    <localControl:PositioningModelControl
                                        x:Name="positioningModelControl"
                                        Margin="7,0"
                                        FindTarget0Command="{Binding FindTarget0InnerCommand}"
                                        IsForEachTarget="{Binding TestInfo.TrainSetting_CrossFov.PositioningTemplateInfo_Inner.IsForEachTarget, Mode=TwoWay}"
                                        IsPositioningEnabled="{Binding TestInfo.TrainSetting_CrossFov.PositioningTemplateInfo_Inner.IsEnable, Mode=TwoWay}"
                                        TestPositionCommand="{Binding TestPositionInnerCommand}" />
                                </GroupBox>

                                <GroupBox
                                    Margin="10,5"
                                    Header="Outer Positioning Model"
                                    Style="{DynamicResource ExpandGroupBoxStyle}"
                                    Visibility="{Binding OuterPositioningSectionVisible, Converter={StaticResource OtvCVT}}">
                                    <localControl:PositioningModelControl
                                        x:Name="outerpositioningModelControl"
                                        Margin="7,0"
                                        FindTarget0Command="{Binding FindTarget0OuterCommand}"
                                        IsForEachTarget="{Binding TestInfo.CrossFovOuterPositioning.IsForEachTarget, Mode=TwoWay}"
                                        IsPositioningEnabled="{Binding TestInfo.CrossFovOuterPositioning.IsEnable, Mode=TwoWay}"
                                        TestPositionCommand="{Binding TestPositionOuterCommand}" />
                                </GroupBox>

                                <!--  Auto Focus Correction  -->
                                <GroupBox
                                    Margin="10,5"
                                    hc:ToggleButtonAttach.ShowLabel="True"
                                    Header="Auto Focus Correction"
                                    Style="{DynamicResource ExpandGroupBoxStyle}"
                                    Visibility="{Binding CorrectionVisibility}">
                                    <StackPanel>
                                        <UniformGrid
                                            Margin="5,5"
                                            IsEnabled="{Binding IsInnerCorrectionEnabled}"
                                            Rows="1"
                                            Visibility="{Binding InnerCorrectionVisibility}">
                                            <TextBlock VerticalAlignment="Center" Text="Inner(mm):" />
                                            <TextBlock VerticalAlignment="Center" Text="Height:" />
                                            <TextBox
                                                Width="60"
                                                IsEnabled="False"
                                                Text="{Binding InnerCorrectionHeight, Mode=OneWay, StringFormat=0.####}" />
                                            <TextBlock VerticalAlignment="Center" Text="Correction:" />
                                            <TextBox
                                                Width="60"
                                                IsEnabled="False"
                                                Text="{Binding InnerCorrectionValue, Mode=OneWay, StringFormat=0.####}" />
                                            <Button
                                                Width="75"
                                                HorizontalAlignment="Right"
                                                Command="{Binding ShowCorrectionValueSettingViewCommand}"
                                                CommandParameter="{StaticResource True}"
                                                Content="Set"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </UniformGrid>
                                        <UniformGrid
                                            Margin="5,5"
                                            IsEnabled="{Binding IsOuterCorrectionEnabled}"
                                            Rows="1"
                                            Visibility="{Binding OuterCorrectionVisibility}">
                                            <TextBlock VerticalAlignment="Center" Text="Outer(mm):" />
                                            <TextBlock VerticalAlignment="Center" Text="Height:" />
                                            <TextBox
                                                Width="60"
                                                IsEnabled="False"
                                                Text="{Binding OuterCorrectionHeight, Mode=OneWay, StringFormat=0.####}" />
                                            <TextBlock VerticalAlignment="Center" Text="Correction:" />
                                            <TextBox
                                                Width="60"
                                                IsEnabled="False"
                                                Text="{Binding OuterCorrectionValue, Mode=OneWay, StringFormat=0.####}" />
                                            <Button
                                                Width="75"
                                                HorizontalAlignment="Right"
                                                Command="{Binding ShowCorrectionValueSettingViewCommand}"
                                                CommandParameter="{StaticResource False}"
                                                Content="Set"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Grid.Row="3">
                            <!--  Measurement  -->
                            <!--<Grid>
                                <GroupBox
                                    Margin="3"
                                    Header="Measurement"
                                    Style="{DynamicResource ExpandGroupBoxStyle}"
                                    Visibility="{Binding IsShowMeasurement, Converter={StaticResource OtvCVT}}">-->
                            <StackPanel Visibility="{Binding IsShowMeasurement, Converter={StaticResource OtvCVT}}">

                                <!--  Measurement  Algorithm Panel  -->
                                <GroupBox
                                    Margin="10,5"
                                    Header="Measurement Algorithm"
                                    Style="{DynamicResource ExpandGroupBoxStyle}">
                                    <StackPanel>
                                        <Grid Visibility="{Binding BibAlgorithmParam, Converter={StaticResource OtvCVT}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="Algorithm" />
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                ItemsSource="{Binding EnumBibAlgorithmType}"
                                                SelectedItem="{Binding BibAlgorithmParam.AlgorithmType}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="Correlation" />
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                ItemsSource="{Binding EnumCorrelationType}"
                                                SelectedItem="{Binding BibAlgorithmParam.CorrelationType}" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Inner Search Area" />
                                            <hc:NumericUpDown
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                DecimalPlaces="3"
                                                Minimum="0"
                                                Value="{Binding BibAlgorithmParam.InnerSearchArea}" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                VerticalAlignment="Center"
                                                Text="Outer Search Area" />
                                            <hc:NumericUpDown
                                                Grid.Row="2"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                DecimalPlaces="3"
                                                Minimum="0"
                                                Value="{Binding BibAlgorithmParam.OuterSearchArea}" />
                                            <Grid Grid.Row="3" Grid.ColumnSpan="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="5,2"
                                                    VerticalAlignment="Center"
                                                    Text="QMerit Derivative Order" />
                                                <hc:NumericUpDown
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="5,2"
                                                    Minimum="0"
                                                    Value="{Binding BibAlgorithmParam.QMeritDerivativeOrder}" />
                                            </Grid>

                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="ProfileCrop" />
                                            <CheckBox
                                                Grid.Row="3"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                IsChecked="{Binding BibAlgorithmParam.IsProfileCrop}"
                                                Style="{StaticResource ToggleButtonSwitch}" />
                                        </Grid>
                                        <Grid Visibility="{Binding CDOvlOfOverFovAlgorithmParam, Converter={StaticResource OtvCVT}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="EdgePolarity" />
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                ItemsSource="{Binding EnumCDOVLPolarity}"
                                                SelectedItem="{Binding SelectEdgePolarity}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="EdgeSelect" />
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                ItemsSource="{Binding EnumCDOVLEdgeSelect}"
                                                SelectedItem="{Binding SelectEdgeSelect}" />

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="EdgeFilterLevel" />
                                            <hc:NumericUpDown
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                DecimalPlaces="0"
                                                Minimum="0"
                                                Value="{Binding EdgeFilterLevel}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="MinEdgeContrast" />
                                            <hc:NumericUpDown
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                Minimum="0"
                                                Value="{Binding MinEdgeContrast}" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="Inner Search Area" />
                                            <hc:NumericUpDown
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                DecimalPlaces="3"
                                                Minimum="0"
                                                Value="{Binding CDOvlOfOverFovAlgorithmParam.InnerSearchArea}" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="Outer Search Area" />
                                            <hc:NumericUpDown
                                                Grid.Row="2"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                DecimalPlaces="3"
                                                Minimum="0"
                                                Value="{Binding CDOvlOfOverFovAlgorithmParam.OuterSearchArea}" />

                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="IsContamProcessing" />
                                            <CheckBox
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                IsChecked="{Binding CDOvlOfOverFovAlgorithmParam.IsContamProcessing}"
                                                Style="{StaticResource ToggleButtonSwitch}" />
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="MinContamScore" />
                                            <hc:NumericUpDown
                                                Grid.Row="3"
                                                Grid.Column="3"
                                                Margin="5,2"
                                                DecimalPlaces="2"
                                                Minimum="0"
                                                Value="{Binding CDOvlOfOverFovAlgorithmParam.MinContamScore}" />

                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Margin="5,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="QMeritDerivativeOrder" />
                                            <hc:NumericUpDown
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Margin="5,2"
                                                Minimum="0"
                                                Value="{Binding CDOvlOfOverFovAlgorithmParam.QMeritDerivativeOrder}" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <!--  Measurement Result / Run Panel  -->
                                <Grid>
                                    <Label
                                        Margin="10,5"
                                        Style="{DynamicResource ContainerLabelStyle}"
                                        Tag="Measurement Result Data">
                                        <StackPanel>
                                            <Grid Margin="0,5,10,5">
                                                <StackPanel
                                                    Margin="8,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding IsShowMeasurement, Converter={StaticResource OtvCVT}}">
                                                    <TextBlock
                                                        Width="60"
                                                        VerticalAlignment="Center"
                                                        Text="Profile：" />
                                                    <RadioButton
                                                        Width="60"
                                                        Command="{Binding RunCommand}"
                                                        Content="Inner"
                                                        GroupName="profileType"
                                                        IsChecked="{Binding FocusBasedOn, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static commonModelEnum:EnumFocusBasedOn.Inner}, UpdateSourceTrigger=PropertyChanged}" />
                                                    <RadioButton
                                                        Width="60"
                                                        Command="{Binding RunCommand}"
                                                        Content="Outer"
                                                        GroupName="profileType"
                                                        IsChecked="{Binding FocusBasedOn, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static commonModelEnum:EnumFocusBasedOn.Outer}, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding CorrelationCommand}"
                                                    Content="Correlation"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                            <DataGrid
                                                x:Name="dg"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="False"
                                                CanUserReorderColumns="False"
                                                ItemsSource="{Binding MeasurementResultDataList}">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="X/Y">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding Axit}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="OVLMisreg">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding OVLMisreg, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="CenterInner">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding CenterInner, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="CenterOuter">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding CenterOuter, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="QMeritTarget">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritTarget, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="QMeritInner">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritInner, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="QMeritOuter">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding QMeritOuter, StringFormat=0.####}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <localControl:ChartResult_ovl DataContext="{Binding CurveResultViewModel}" />
                                        </StackPanel>
                                    </Label>
                                    <Button
                                        Margin="0,7,15,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Command="{Binding RunCommand}"
                                        Content="Run"
                                        Style="{StaticResource ButtonPrimary}" />
                                </Grid>

                                <!--  Measurement EdgeSelect Set  -->
                                <Grid Visibility="{Binding CDOvlOfOverFovAlgorithmParam, Converter={StaticResource OtvCVT}}">
                                    <Label
                                        Height="75"
                                        Margin="10,5"
                                        Style="{DynamicResource ContainerLabelStyle}"
                                        Tag="Measurement EdgeSelect Set">
                                        <StackPanel>
                                            <Button
                                                Width="100"
                                                Margin="5,5,5,0"
                                                HorizontalAlignment="Right"
                                                Command="{Binding SetCdOvlCompensationCommand}"
                                                Style="{StaticResource ButtonPrimary}"
                                                Visibility="{Binding EdgeSelect, Converter={StaticResource OtvCVT}}">
                                                EdgeSelect
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding EdgeSelect, Converter={StaticResource OtvReCVT}}">
                                                <Button
                                                    Width="75"
                                                    Margin="5,5,0,0"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding ConfirmCdOvlCompensationCommand}"
                                                    Style="{StaticResource ButtonPrimary}">
                                                    Confirm
                                                </Button>
                                                <Button
                                                    Width="75"
                                                    Margin="5,5,0,0"
                                                    Command="{Binding CancelCdOvlCompensationCommand}"
                                                    Style="{StaticResource ButtonDefault}">
                                                    Cancel
                                                </Button>
                                                <Button
                                                    Width="75"
                                                    Margin="5,5,0,0"
                                                    Command="{Binding ResetCdOvlCompensationCommand}"
                                                    Style="{StaticResource ButtonDefault}">
                                                    Clear
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Label>
                                </Grid>

                            </StackPanel>
                            <!--</GroupBox>-->
                            <!--</Grid>-->
                        </StackPanel>

                        <!--  Inner/Outer Model：跨视野时在 Vision 页分别训练；与主图 StageControlImageView 绑定。  -->
                        <GroupBox
                            Margin="3"
                            Header="Inner Model"
                            Style="{DynamicResource ExpandGroupBoxStyle}"
                            Visibility="{Binding InnerModelSectionVisible, Converter={StaticResource OtvCVT}}">
                            <StackPanel>
                                <StackPanel
                                    Height="28"
                                    Margin="8,1,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                                    <TextBlock Margin="0,8,10,00" Text="ExtendSize(pixel):" />
                                    <hc:NumericUpDown
                                        Width="85"
                                        Height="24"
                                        Margin="0,0,0,0"
                                        DecimalPlaces="0"
                                        Style="{StaticResource NumericUpDownExtend}"
                                        Value="{Binding RoiExtendSize_Inner, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <tempmachview:SingleTemplateControl
                                    x:Name="innerModelTemplateControl"
                                    ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                                    IsShowSearArea="False" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Margin="3"
                            Header="Outer Model"
                            Style="{DynamicResource ExpandGroupBoxStyle}"
                            Visibility="{Binding OuterModelSectionVisible, Converter={StaticResource OtvCVT}}">
                            <StackPanel>
                                <StackPanel
                                    Height="28"
                                    Margin="8,1,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                                    <TextBlock Margin="0,8,10,00" Text="ExtendSize(pixel):" />
                                    <hc:NumericUpDown
                                        Width="85"
                                        Height="24"
                                        Margin="0,0,0,0"
                                        DecimalPlaces="0"
                                        Style="{StaticResource NumericUpDownExtend}"
                                        Value="{Binding RoiExtendSize_Outer, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <tempmachview:SingleTemplateControl
                                    x:Name="outerModelTemplateControl"
                                    ImageViewer="{Binding ImageViewer, ElementName=StageControlImageView}"
                                    IsShowSearArea="False" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:Growl.Token="TestTrainCDMessage" />
        </Grid>

        <Grid Grid.Row="1">
            <WrapPanel HorizontalAlignment="Right">
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SubmitCommand}"
                    Content="Submit"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding CloseViewCommand}"
                    Content="Close"
                    Style="{StaticResource MarvelLightButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
