<UserControl
    x:Class="Ovl.UI.Recipe.View.Test_Train40View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converter="clr-namespace:Ovl.UI.Resources.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataModelenum="clr-namespace:Marvel.DataModels.Enums;assembly=Marvel.DataModels"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:ioc="http://prismlibrary.com/"
    xmlns:local="clr-namespace:Ovl.UI.Recipe"
    xmlns:localControl="clr-namespace:Ovl.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:stageViewModels="clr-namespace:InteVega.CBB.StageControlModule.ViewModels;assembly=InteVega.CBB.StageControlModule"
    xmlns:stagecontorl1="clr-namespace:InteVega.CBB.StageControlModule.Views.CameraView;assembly=InteVega.CBB.StageControlModule"
    xmlns:stagetcontorl="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tempmachview="clr-namespace:InteVega.CBB.TemplateMatchingModule.Views;assembly=InteVega.CBB.TemplateMatchingModule"
    xmlns:uicommon="clr-namespace:InteVega.CBB.ComUI.Controls;assembly=InteVega.CBB.ComUI"
    xmlns:views="clr-namespace:InteVega.CBB.StageControlModule.Views;assembly=InteVega.CBB.StageControlModule"
    xmlns:vm="clr-namespace:Ovl.UI.Recipe.ViewModel"
    Margin="5"
    d:DataContext="{d:DesignInstance Type=vm:Test_Train40ViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--  窗体的宽和高根据内容的大小设置  -->
            <Setter Property="Width" Value="1800" />
            <Setter Property="Height" Value="800" />
            <!--  不允许调整窗体尺寸  -->
            <!--<Setter Property="ResizeMode" Value="NoResize" />-->
            <!--  设置窗体的启动位置在屏幕中间  -->
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_en.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Languages/ViewDict_ch.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ovl.UI;component/Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Marvel.ComModule;component/Style/CardPropertyGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <!--<x:Array x:Key="ImageViewNaviList" Type="system:String">
                <system:String>Train</system:String>
                <system:String>Compare</system:String>
            </x:Array>-->
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>

    </b:Interaction.Triggers>

    <Grid IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="350" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel VerticalAlignment="Top" IsEnabled="{Binding ChangeCameraInfo, Converter={StaticResource OtbReCVT}}">
                        <stagetcontorl:StageControlCameraView
                            CameraColorPixEnable="False"
                            Foreground="Black"
                            ImageViewer="{Binding TrainContent.ImageViewer}"
                            Style="{x:Null}" />
                        <stagetcontorl:StageControlLightView Foreground="Black" Style="{x:Null}" />
                        <stagetcontorl:StageFocusControlView ImageViewer="{Binding TrainContent.ImageViewer}" />
                        <stagetcontorl:StageControlMotionView Foreground="Black" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <ContentControl Grid.Column="1" Content="{Binding TrainContent}" />
        </Grid>
        <Grid Grid.Row="1">
            <WrapPanel HorizontalAlignment="Right">
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SubmitCommand}"
                    Content="Submit"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource MarvelDarkButton}" />
                <Button
                    Width="60"
                    Margin="10,1,10,1"
                    Command="{Binding CloseViewCommand}"
                    Content="Close"
                    Style="{StaticResource MarvelLightButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
