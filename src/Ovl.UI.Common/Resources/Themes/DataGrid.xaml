    <Style
        x:Key="MenuDataGridRowStyle"
        BasedOn="{StaticResource DataGridRowStyleBase}"
        TargetType="DataGridRow">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu
                    Width="140"
                    IsEnabled="{Binding EditEnable}"
                    Visibility="{Binding EditEnable, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <MenuItem Command="{Binding EditJobCommand}" Style="{DynamicResource TreeMenuItem}">
                        <MenuItem.Header>
                            <StackPanel
                                Margin="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <icon:CustomIcon
                                    Width="16"
                                    Height="16"
                                    Kind="ButtonEditIcon"
                                    Style="{StaticResource MainMenuIcon}" />
                                <TextBlock
                                    Margin="12,8,0,0"
                                    FontSize="12"
                                    Text="Edit Job" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding AddJobCommand}" Style="{DynamicResource TreeMenuItem}">
                        <MenuItem.Header>
                            <StackPanel
                                Margin="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <icon:CustomIcon
                                    Width="16"
                                    Height="16"
                                    Kind="RecipeAdd"
                                    Style="{StaticResource MainMenuIcon}" />
                                <TextBlock
                                    Margin="12,8,0,0"
                                    FontSize="12"
                                    Text="Insert Job" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding MoveUpJobCommand}" Style="{DynamicResource TreeMenuItem}">
                        <MenuItem.Header>
                            <StackPanel
                                Margin="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <icon:CustomIcon
                                    Width="16"
                                    Height="16"
                                    Kind="MoveUpIcon"
                                    Style="{StaticResource MainMenuIcon}" />
                                <TextBlock
                                    Margin="12,8,0,0"
                                    FontSize="12"
                                    Text="Move Up" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding MoveDownJobCommand}" Style="{DynamicResource TreeMenuItem}">
                        <MenuItem.Header>
                            <StackPanel
                                Margin="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <icon:CustomIcon
                                    Width="16"
                                    Height="16"
                                    Foreground="#0F54C6"
                                    Kind="MoveDownIcon"
                                    Style="{StaticResource MainMenuIcon}" />
                                <TextBlock
                                    Margin="12,8,0,0"
                                    FontSize="12"
                                    Text="Move down" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding DeleteJobCommand}" Style="{DynamicResource TreeMenuItem}">
                        <MenuItem.Header>
                            <StackPanel
                                Margin="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <icon:CustomIcon
                                    Width="16"
                                    Height="16"
                                    Foreground="#D37C11"
                                    Kind="RecipeDelete"
                                    Style="{StaticResource MainMenuIcon}" />
                                <TextBlock
                                    Margin="12,8,0,0"
                                    FontSize="12"
                                    Text="Delete Job" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding LoadPortCommand}"
                        IsEnabled="{Binding LoadPortEnable}"
                        Style="{DynamicResource TreeMenuItem}">
                        <MenuItem.Header>
                            <StackPanel
                                Margin="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <icon:CustomIcon
                                    Width="16"
                                    Height="16"
                                    Kind="WaferHandler"
                                    Style="{StaticResource MainMenuIcon}" />
                                <TextBlock
                                    Margin="12,8,0,0"
                                    FontSize="12"
                                    Text="Load Port" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding UnLoadPortCommand}"
                        IsEnabled="{Binding UnLoadPortEnable}"
                        Style="{DynamicResource TreeMenuItem}">
                        <MenuItem.Header>
                            <StackPanel
                                Margin="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <icon:CustomIcon
                                    Width="16"
                                    Height="16"
                                    Kind="WaferHandler"
                                    Style="{StaticResource MainMenuIcon}" />
                                <TextBlock
                                    Margin="12,8,0,0"
                                    FontSize="12"
                                    Text="Unload Port" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>
