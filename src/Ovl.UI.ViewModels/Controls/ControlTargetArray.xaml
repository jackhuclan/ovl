<UserControl x:Class="Ovl.UI.ViewModels.Controls.ControlTargetArray"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ovl.UI.ViewModels.Controls"
             mc:Ignorable="d" 
             >
  <UserControl.Resources>
    <ResourceDictionary >
      <ResourceDictionary.MergedDictionaries >
        <ResourceDictionary Source="pack://application:,,,/Marvel.TargetSelectionControl;component/Control/ControlStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ContextMenu  x:Key="ContextMenuTemplate"  >
        <MenuItem Header="设为参考点" Click="MenuItem_Click"/>
      </ContextMenu>
    </ResourceDictionary>
  </UserControl.Resources>
  <Viewbox >
    <Grid x:Name="gd" Background="Transparent"  >
      <Canvas x:Name="canvas" HorizontalAlignment="Center" VerticalAlignment="Center"   Background="Transparent"    Margin="20"  >
        <Canvas.RenderTransform>
          <TranslateTransform x:Name="ts"/>
        </Canvas.RenderTransform>
         
      </Canvas>
    </Grid>
  </Viewbox>
 
</UserControl>
