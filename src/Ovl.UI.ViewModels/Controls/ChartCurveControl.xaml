<UserControl
    x:Class="Ovl.UI.ViewModels.Controls.ChartCurveControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ovl.UI.ViewModels.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfControl="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Border
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="5"
                    Direction="315"
                    Opacity="0.2"
                    ShadowDepth="2"
                    Color="#888888" />
            </Border.Effect>
            <wpfControl:WpfPlot
                x:Name="PlotControl"
                Margin="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#FFEEEEEE" />
        </Border>
    </Grid>
</UserControl>
