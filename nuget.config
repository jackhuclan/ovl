<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- M0 仅使用 nuget.org。后续迁移 Marvel 需要厂内 nexus 源
       (http://192.168.3.116:8081/repository/nuget-hosted/) 时，
       在此追加并配置对应凭据（当前该源 401 需认证，会导致 NU1301）。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
