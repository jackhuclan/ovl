<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- M0 仅使用 nuget.org。厂内 nexus 源用于迁移 Marvel 所需的内部包（HalconDotNet 等）。
       凭据通过环境变量注入，避免明文写入仓库：
         NEXUS_USERNAME / NEXUS_PASSWORD
       本机或 CI 设置这两个变量后，`dotnet restore` 即可拉取内部包；
       提交到仓库的此文件不含任何明文口令。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="nexus" value="http://192.168.3.116:8081/repository/nuget-hosted/" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceCredentials>
    <nexus>
      <add key="Username" value="%NEXUS_USERNAME%" />
      <add key="Password" value="%NEXUS_PASSWORD%" />
    </nexus>
  </packageSourceCredentials>
</configuration>
