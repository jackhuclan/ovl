<UserControl
    x:Class="HPImageViewer.ImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:HPImageViewer.Behaviors"
    xmlns:core="clr-namespace:HPImageViewer.Core;assembly=HPImageViewer.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HPImageViewer"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="imageViewer"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#1356c4"
    Focusable="True"
    SizeChanged="imageViewer_SizeChanged"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="A"
            Command="{Binding SelectAllCommand, ElementName=imageViewer}"
            Modifiers="Control" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand, ElementName=imageViewer}" />
    </UserControl.InputBindings>
    <b:Interaction.Behaviors>
        <behaviors:ToolOperatingBehavior />
        <behaviors:PixelIndicatorBehavior />

    </b:Interaction.Behaviors>

    <Grid>
        <Border
            x:Name="ToolBar"
            VerticalAlignment="top"
            Panel.ZIndex="1"
            Visibility="Collapsed">
            <Grid>
                <TextBlock
                    Name="FpsCounter"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Microsoft YaHei"
                    FontSize="16"
                    Foreground="Yellow"
                    Text="Fps"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
        <TextBlock
            x:Name="PixelIndicator"
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            FontSize="14"
            Foreground="Yellow" />
        <local:ImageView
            x:Name="ImageViewDrawCanvas"
            Background="Transparent"
            ClipToBounds="True"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            SnapsToDevicePixels="True"
            Tag="{Binding ElementName=imageViewer}">
            <local:ImageView.ContextMenu>
                <ContextMenu x:Name="ContextMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem
                        x:Name="ResetView"
                        Command="{Binding ResetViewCommand}"
                        Header="ResetView" />
                    <MenuItem
                        x:Name="Delete"
                        Command="{Binding DeleteCommand}"
                        Header="Delete" />
                    <MenuItem
                        x:Name="SelectAll"
                        Command="{Binding SelectAllCommand}"
                        Header="SelectAll" />
                    <Separator />
                    <MenuItem
                        x:Name="MoveToFront"
                        Command="{Binding MoveToFrontCommand}"
                        Header="Move to Front" />
                    <MenuItem
                        x:Name="MoveToBack"
                        Command="{Binding MoveToBackCommand}"
                        Header="Move to Back" />
                    <MenuItem
                        x:Name="LockSelectedROIs"
                        Command="{Binding LockSelectedROIsCommand}"
                        Header="Lock selected ROIs" />
                    <MenuItem
                        x:Name="UnLockAllROIs"
                        Command="{Binding UnLockAllROIsCommand}"
                        Header="UnLock all ROIs" />
                </ContextMenu>
            </local:ImageView.ContextMenu>
        </local:ImageView>
    </Grid>
</UserControl>
