<UserControl
  x:Class="InteVega.CBB.SystemConfig.Ui.View.SystemConfigWin"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:handy="https://handyorg.github.io/handycontrol"
  xmlns:local="clr-namespace:InteVega.CBB.SystemConfig.Ui.View"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:prism="http://prismlibrary.com/"
  xmlns:property="clr-namespace:InteVega.CBB.SystemConfig.Ui.View"
  xmlns:viewmodel="clr-namespace:InteVega.CBB.SystemConfig.Ui.ViewModel"
  Width="1000"
  Height="550"
  DataContext="{prism:ContainerProvider {x:Type viewmodel:SystemConfigWinViewModel}}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
        <!--<ResourceDictionary Source="pack://application:,,,/InteVega.CBB.Recipe.Ui;component/Resources/Window.xaml" />-->
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!--  设置窗体大小  -->
  <prism:Dialog.WindowStyle>
    <Style TargetType="Window">
      <!--  窗体的宽和高根据内容的大小设置  -->
      <Setter Property="SizeToContent" Value="WidthAndHeight" />
      <!--  不允许调整窗体尺寸  -->
      <Setter Property="ResizeMode" Value="NoResize" />
      <!--  设置窗体的启动位置在屏幕中间  -->
      <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
      <!--<Setter Property="Title" Value="系统设置"></Setter>-->
      <Setter Property="Title" Value="{Binding Title}" />
    </Style>
  </prism:Dialog.WindowStyle>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Border Margin="8">
      <property:PropertyControl DataContext="{Binding PropertyControlViewModel}" />
    </Border>

  </Grid>
</UserControl>
