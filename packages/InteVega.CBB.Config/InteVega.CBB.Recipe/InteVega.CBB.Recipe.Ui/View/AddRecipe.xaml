<UserControl x:Class="InteVega.CBB.Recipe.Ui.View.AddRecipe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InteVega.CBB.Recipe.Ui.View"
             mc:Ignorable="d" xmlns:prism="http://prismlibrary.com/"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--设置窗体大小-->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--窗体的宽和高根据内容的大小设置-->
            <Setter Property="SizeToContent"
                    Value="WidthAndHeight" />
            <!--不允许调整窗体尺寸-->
            <Setter Property="ResizeMode"
                    Value="NoResize" />
            <!--设置窗体的启动位置在屏幕中间-->
            <Setter Property="prism:Dialog.WindowStartupLocation"
                    Value="CenterScreen" />
            <Setter Property="Title" Value="{Binding WindowTitle}"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Width="400" Height="150" Background="#eee">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"></RowDefinition>
            <RowDefinition Height="45"></RowDefinition>
            <RowDefinition Height="45"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="6.5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Parent Folder:" Style="{StaticResource txtBlockTitle}"></TextBlock>
        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource txtBlockTitle}" HorizontalAlignment="Left" Margin="20,0" Text="{Binding ParentName}"></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="0"  Style="{StaticResource txtBlockTitle}">
          <Run Text="{Binding TextBlockTitle}"/>
          <Run Text=":"/>
    </TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecipeName}" Style="{StaticResource TextBoxInput}" Margin="20,0"  ></TextBox>
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0">
            <Button x:Name="btnSave" Content="Save" Style="{StaticResource ButtonStyle}" Command="{Binding SaveRecipeCommand}"  ></Button>
            <Button x:Name="btnClose" Content="Cancel" Style="{StaticResource ButtonStyle}" Command="{Binding CloseCommand}"  ></Button>
        </StackPanel>
    </Grid>
</UserControl>
