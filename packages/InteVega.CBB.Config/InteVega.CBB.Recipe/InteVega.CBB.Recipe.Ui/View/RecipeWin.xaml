<Window x:Class="InteVega.CBB.Recipe.Ui.View.RecipeWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InteVega.CBB.Recipe.Ui.View"
        xmlns:viewmodel="clr-namespace:InteVega.CBB.Recipe.Ui.ViewModel"
        xmlns:extension="clr-namespace:InteVega.CBB.Prism.UI.Extensions;assembly=InteVega.CBB.Prism.UI.Extensions"
        mc:Ignorable="d"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:handy="https://handyorg.github.io/handycontrol"
        xmlns:recipe="clr-namespace:InteVega.CBB.Recipe.Ui.View"
        xmlns:RecipeViewModel="clr-namespace:InteVega.CBB.Recipe.Ui.ViewModel"
        DataContext="{prism:ContainerProvider {x:Type RecipeViewModel:RecipeWinViewModel}}"
        Title="配方管理" Height="750" Width="1200">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/InteVega.CBB.Recipe.Ui;component/Resources/Window.xaml" />
        <ResourceDictionary Source="pack://application:,,,/InteVega.CBB.Recipe.Ui;component/Resources/TextBlock.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid >
    <Grid.RowDefinitions>
      <RowDefinition></RowDefinition>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding Width}"></ColumnDefinition>
      <ColumnDefinition Width="15"></ColumnDefinition>
      <ColumnDefinition Width="*"></ColumnDefinition>
    </Grid.ColumnDefinitions>
    <recipe:RecipeMenu Grid.Row="0" Grid.Column="0" DataContext="{Binding RecipeMenuViewModel}" Margin="5,5,0,5" MouseLeave="RecipeMenu_MouseLeave">
    </recipe:RecipeMenu>
    <Border Grid.Row="0" Grid.Column="1" Background="#FAFAFA" BorderBrush="#ccc">
      <Image x:Name="imgMenuStrip" Source="{Binding ImgSouce}" Cursor="Hand" Tag="关闭" Height="50" Stretch="Fill">
        <handy:Interaction.Triggers>
          <handy:EventTrigger EventName="MouseDown">
            <handy:InvokeCommandAction  Command="{Binding MouseDownCommand}">
            </handy:InvokeCommandAction>
          </handy:EventTrigger>
        </handy:Interaction.Triggers>
      </Image>
    </Border>
    <Border Grid.Row="0" Grid.Column="2" Margin="0,5,5,5" BorderBrush="#eee" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="40"></RowDefinition>
          <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" ></ColumnDefinition>
          <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>
      </Grid>


    </Border>
  </Grid>
</Window>
