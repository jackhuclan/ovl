<UserControl
    x:Class="InteVega.CBB.Recipe.Ui.View.RecipeMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:handy="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:icon="clr-namespace:InteVega.CBB.Prism.UI.Extensions.Icon;assembly=InteVega.CBB.Prism.UI.Extensions"
    xmlns:local="clr-namespace:InteVega.CBB.Recipe.Ui.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="../Resources/TreeView.xaml" />
                <ResourceDictionary Source="../Resources/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
           
            <HierarchicalDataTemplate x:Key="TreeViewDropItemTemplate" ItemsSource="{Binding Children}">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <icon:CustomIcon
                        x:Name="imgnoselect"
                        Width="20"
                        Height="20"
                        Kind="RecipeFoled"
                        Style="{StaticResource MainMenuIcon}"
                        Tag="{Binding Name}" />
                    <icon:CustomIcon
                        x:Name="imgfile"
                        Width="20"
                        Height="20"
                        Kind="RecipeFile"
                        Style="{StaticResource MainMenuIcon}"
                        Tag="{Binding Name}" />
                    <TextBlock
                        x:Name="tb"
                        Grid.Column="1"
                        Height="22"
                        Padding="0,2,0,0"
                        FontSize="15"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}">
                        <TextBlock.Style>
                            <Style>
                                <EventSetter Event="TextBlock.MouseEnter" Handler="TextBlock_MouseEnter" />
                                <EventSetter Event="TextBlock.MouseLeave" Handler="TextBlock_MouseLeave" />
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button
                        x:Name="btnToggleTreeExpand"
                        Grid.Column="1"
                        Height="20"
                        Margin="110,0,0,0"
                        Padding="6,0"
                        HorizontalAlignment="Left"
                        Panel.ZIndex="1"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.ToggleTreeExpandCommand, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}"
                        Content="{Binding DataContext.TreeExpandButtonText, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}"
                        Focusable="False"
                        FontSize="11"
                        ToolTip="{Binding DataContext.TreeExpandButtonText, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}"
                        Visibility="Collapsed" />
                    <Grid
                        x:Name="r1"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Height="4"
                        Visibility="Collapsed">
                        <Ellipse
                            Width="4"
                            Height="4"
                            HorizontalAlignment="Left"
                            Fill="Blue"
                            StrokeThickness="0" />
                        <Rectangle
                            Height="1"
                            VerticalAlignment="Center"
                            Fill="Blue"
                            StrokeThickness="0" />
                    </Grid>
                    <Grid
                        x:Name="r2"
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="4"
                        Visibility="Collapsed">
                        <Ellipse
                            Width="4"
                            Height="4"
                            HorizontalAlignment="Left"
                            Fill="Blue"
                            StrokeThickness="0" />
                        <Rectangle
                            Height="1"
                            VerticalAlignment="Center"
                            Fill="Blue"
                            StrokeThickness="0" />
                    </Grid>
                </Grid>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Path=IsAddMove}" Value="true">
                        <Setter TargetName="r1" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=Level}" Value="0">
                        <Setter TargetName="imgnoselect" Property="Visibility" Value="Visible" />
                        <Setter TargetName="imgfile" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=Parent}" Value="{x:Null}">
                        <Setter TargetName="btnToggleTreeExpand" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=Level}" Value="1">
                        <Setter TargetName="imgnoselect" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="imgfile" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=IsAddInMove}" Value="true">
                        <Setter TargetName="r2" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,0,5"
            BorderBrush="#ccc"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    FontSize="15"
                    Text="{Binding SearchRecipeName}">
                    <handy:Interaction.Triggers>
                        <handy:EventTrigger EventName="KeyUp">
                            <handy:InvokeCommandAction Command="{Binding SearchRecipeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TextBox}, Path=Text}" />
                        </handy:EventTrigger>
                    </handy:Interaction.Triggers>
                    <TextBox.Resources>
                        <VisualBrush
                            x:Key="HelpBrush"
                            AlignmentX="Left"
                            Opacity="0.5"
                            Stretch="None"
                            TileMode="None">
                            <VisualBrush.Visual>

                                <!--  "请输入Recipe文件/文件夹名称关键字搜索"  -->
                                <TextBlock FontStyle="Italic" Text="Please enter the keyword to search" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Background" Value="{StaticResource HelpBrush}" />
                                </Trigger>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HelpBrush}" />
                                </Trigger>

                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Image
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,5,15,5"
                    Visibility="{Binding IsShowSearchImg}">
                    <Image.Source>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <DrawingGroup Opacity="1">
                                    <GeometryDrawing Brush="#0F54C6" Geometry="M663.006587 602.400314l-32.11848 0-12.063745-12.080118c40.177008-44.250786 64.278915-104.586905 64.278915-168.934382 0-144.831451-116.607671-261.4381-261.439123-261.4381-144.787449 0-261.386934 116.606648-261.386934 261.4381 0 144.831451 116.598462 261.387958 261.386934 261.387958 64.390455 0 124.725551-24.09372 168.993733-64.279938l12.011556 12.081141 0 32.162482 201.112213 201.051838 60.32691-60.335096L663.006587 602.400314zM421.664154 602.400314c-100.589875 0-181.021662-80.43281-181.021662-181.014499 0-100.641041 80.43281-181.014499 181.021662-181.014499 100.624668 0 181.005289 80.373458 181.005289 181.014499C602.669443 521.967504 522.288822 602.400314 421.664154 602.400314" />
                                </DrawingGroup>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </Image.Source>
                </Image>
                <Image
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,8,15,8"
                    Visibility="{Binding IsShowClearImg}">
                    <Image.Source>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <DrawingGroup Opacity="1">
                                    <GeometryDrawing Brush="#0F54C6" Geometry="M568.6 512l346.6-346.6c15.6-15.6 15.6-40.9 0-56.6-15.6-15.6-40.9-15.6-56.6 0L512 455.4 165.4 108.9c-15.6-15.6-40.9-15.6-56.6 0-15.6 15.6-15.6 40.9 0 56.6L455.4 512 108.9 858.6c-15.6 15.6-15.6 40.9 0 56.6 7.8 7.8 18 11.7 28.3 11.7s20.5-3.9 28.3-11.7L512 568.6l346.6 346.6c7.8 7.8 18 11.7 28.3 11.7s20.5-3.9 28.3-11.7c15.6-15.6 15.6-40.9 0-56.6L568.6 512z" />
                                </DrawingGroup>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </Image.Source>
                    <handy:Interaction.Triggers>
                        <handy:EventTrigger EventName="MouseLeftButtonDown">
                            <handy:InvokeCommandAction Command="{Binding ClearSearchCommand}" />
                        </handy:EventTrigger>
                    </handy:Interaction.Triggers>
                </Image>
            </Grid>
        </Border>

        <TreeView
            x:Name="treeView"
            Grid.Row="1"
            Background="#FAFAFA"
            FlowDirection="LeftToRight"
            ItemContainerStyle="{DynamicResource DefaultTreeViewItem}"
            ItemTemplate="{DynamicResource TreeViewDropItemTemplate}"
            ItemsSource="{Binding TreeModel.Children, UpdateSourceTrigger=PropertyChanged}"
            MouseLeave="tvRequire_MouseLeave"
            MouseMove="tvRequire_MouseMove"
            MouseUp="tvRequire_MouseUp"
            PreviewKeyDown="treeView_PreviewKeyDown"
            PreviewMouseDown="tvRequire_PreviewMouseDown"
            RequestBringIntoView="treeView_RequestBringIntoView"
            VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </TreeView.ItemsPanel>

            <handy:Interaction.Triggers>
                <handy:EventTrigger EventName="SelectedItemChanged">
                    <handy:InvokeCommandAction Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeView}}}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TreeView}, Path=SelectedItem}" />
                </handy:EventTrigger>
                <handy:EventTrigger EventName="MouseDoubleClick">
                    <handy:InvokeCommandAction Command="{Binding DataContext.MouseDoubleCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeView}}}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TreeView}, Path=SelectedItem}" />
                </handy:EventTrigger>
            </handy:Interaction.Triggers>
        </TreeView>
    </Grid>
</UserControl>
