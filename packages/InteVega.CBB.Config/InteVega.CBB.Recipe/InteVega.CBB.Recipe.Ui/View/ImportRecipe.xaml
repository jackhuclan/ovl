    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
      <TextBlock Text="Please select the Recipes you want to keep" FontSize="16" FontWeight="Black" Margin="0,10,0,10"></TextBlock>
      <TextBlock Text="If both are retained,the imported recipes is used as the new recipes" Margin="0,10,0,10"></TextBlock>
    </StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding RecipeList}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" 
              CanUserSortColumns="False" CanUserResizeRows="True" SelectionMode="Single" Margin="10,20,10,20">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Num" Binding="{Binding Index}"></DataGridTextColumn>       
        <DataGridTemplateColumn MinWidth="250" Header="Recipe In System">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <CheckBox Content="{Binding SourceRecipeInfo.RecipeName}" IsChecked="{Binding IsSourceCheck,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></CheckBox>                
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn MinWidth="250" Header="Import Recipe">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <CheckBox Content="{Binding TargetRecipeInfo.RecipeName}" IsChecked="{Binding IsTargetCheck,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></CheckBox>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>        
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
      <Button Content="Import" Width="120" Margin="6" Command="{Binding ImportRecipeCommand}" ></Button>
      <Button Content="Close" Width="120" Margin="6" Command="{Binding CloseCommand}"></Button>
    </StackPanel>

  </Grid>
</UserControl>
