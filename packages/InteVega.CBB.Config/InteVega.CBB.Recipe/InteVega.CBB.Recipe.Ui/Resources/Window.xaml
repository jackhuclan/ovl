<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Window" x:Key="dialogWin">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" GlassFrameThickness="0,30,0,0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="White">
                        <AdornerDecorator>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="1"/>
                                <Grid Width="{TemplateBinding ActualWidth}" Background="#f2f2f2" Height="30" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock  Text="{TemplateBinding Title}" Margin="8 0 0 0" VerticalAlignment="Center" FontSize="14"/>
                                    <TextBlock  Grid.Column="1" Text="" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right" Margin="0 0 180 0"/>
                                    <Image Grid.Column="2" IsHitTestVisible="True" Width="15" Height="15" Margin="0,5,0,0">
                                        <Image.Source>
                                            <DrawingImage>
                                                <DrawingImage.Drawing>
                                                    <DrawingGroup Opacity="1">
                                                        <GeometryDrawing Brush="#515151" Geometry="M932.394792 91.748565c-35.552569-35.552569-93.182136-35.552569-128.734705 0L512.071679 383.193616 220.339913 91.748565c-35.695926-35.695926-93.182136-35.695926-128.734705 0s-35.552569 93.182136 0 128.734705l291.731765 291.731766L91.748565 803.803444c-35.552569 35.552569-35.552569 93.182136 0 128.734705 35.552569 35.552569 93.182136 35.552569 128.734705 0L512.071679 640.806384l291.731765 291.731765c35.552569 35.552569 93.182136 35.552569 128.734705 0 35.552569-35.552569 35.552569-93.182136 0-128.734705L640.663027 512.071679l291.875122-291.731766c35.265855-35.552569 35.265855-93.182136-0.143357-128.591348z">
                                                        </GeometryDrawing>
                                                    </DrawingGroup>
                                                </DrawingImage.Drawing>
                                            </DrawingImage>
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Grid>
                        </AdornerDecorator>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>