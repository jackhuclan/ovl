<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
	  <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	  <Version>1.0.0.15</Version>
    <Description>Atomic Recipe.json write with .bak recovery (power-loss safe)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="JsonHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IntellVega.CBB.EasyConfig" Version="2.0.4" />
    <PackageReference Include="IntellVega.CBB.Module" Version="1.0.2" />
    <PackageReference Include="IntellVega.Common" Version="1.0.0" />
    <PackageReference Include="InteVega.CBB.Db" Version="1.0.0.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="10.0.7" />
  </ItemGroup>

</Project>
