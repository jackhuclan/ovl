<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- 原 marvel 中为 ProjectReference（InteVega.CBB.Common 源码不在 OpenInteVega），改用 nexus 内部包 -->
    <PackageReference Include="InteVega.CBB.Common" Version="1.0.0.5" />
    <!-- IRecipeWindow 使用 ns InteVega.CBB.Recipe.Core 的 RecipeInfo，其定义位于 Recipe 主工程 -->
    <ProjectReference Include="..\InteVega.CBB.Recipe\InteVega.CBB.Recipe.csproj" />
  </ItemGroup>

</Project>
