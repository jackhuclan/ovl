<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Authors>Wangkewei</Authors>
    <Company>北京镁珈机器人科技有限公司</Company>
    <Product>Ultron</Product>
    <Description>
      ------------------------- V2.0.4 ----------------------------------------
      修改了Get()泛型方法根据传入参数的实际类型作为key，避免里氏替换时使用父类。
      ------------------------- V2.0.3 ----------------------------------------
      增加了GetAll的方法
      ------------------------- V2.0.2 ----------------------------------------
      修改FileBuilderOption配置中的AutoCommit默认为true
      ------------------------- V2.0.1 ----------------------------------------
      修改json序列化与反序列方式，增加Fomatting和JsonSerializerSettings参数
      使json文件可以自动换行显示，提升文件可读性
      反序列化时可以自动反序列化成实际类型的对象
      ------------------------- V2.0.0 ----------------------------------------
      1、基于2.0需求重新开发，不兼容1.x
      2、仅支持json
    </Description>
    <Version>2.0.4</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>$(MSBuildProjectDirectory)\bin\$(Configuration)\IntellVega.CBB.EasyConfig.xml</DocumentationFile>
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Xml\" />
  </ItemGroup>

	<Target Name="PushPackage" AfterTargets="Pack">
		<Exec Command="dotnet nuget push &quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\$(AssemblyName).$(Version).nupkg&quot; -s https://nexus.megarobo.info/repository/nuget-hosted/ -k 8c0c93d6-823d-3885-9f85-2ce1f3888c50" />
	</Target>
</Project>
