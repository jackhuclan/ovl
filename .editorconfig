root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{slnx,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.cs]
# using 指令
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true

# var 与表达式主体
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion

# 命名空间：文件作用域
csharp_style_namespace_declarations = file_scoped:error

# this. 与修饰符顺序
dotnet_style_qualification_for_field = false:suggestion
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,async:error

# 命名规则：接口 I 前缀
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# 命名规则：私有字段与静态私有字段均为 _camelCase（不用 s_ 前缀）
dotnet_naming_rule.private_fields_underscore_camel.severity = error
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# 命名规则：类型与成员 PascalCase
dotnet_naming_rule.types_pascal.severity = error
dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_symbols.types_and_members.applicable_kinds = class,struct,enum,method,property,event
dotnet_naming_style.pascal.capitalization = pascal_case
