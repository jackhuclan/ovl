<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- VerifyDebug：marvel 侧 DomainService.Api 等工程按 Configuration Choose 源码/包分支，
         构建需用 -c VerifyDebug 使其走源码工程分支（与厂内构建语义一致） -->
    <Configurations>Debug;Release;VerifyDebug</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Megarobo</Authors>
    <Company>Megarobo</Company>
    <Product>Ovl</Product>
    <Description>Ovl 半导体量测设备上位机</Description>
    <PackageProjectUrl>https://github.com/jackhuclan/ovl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jackhuclan/ovl.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) Megarobo</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
